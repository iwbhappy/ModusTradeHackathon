diff --git a/backend/tests/test_domain.py b/backend/tests/test_domain.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb3f72ab06a396bcdf9a161ac39c0df173abeed6
--- /dev/null
+++ b/backend/tests/test_domain.py
@@ -0,0 +1,89 @@
+from datetime import date, datetime
+
+import pytest
+
+from app.domain.calendar import BusinessCalendar
+from app.domain.errors import DomainError
+from app.domain.permissions import can_read
+from app.domain.routing import choose_assignment
+from app.domain.workflow import validate_transition
+from app.models import Participant, RoutingRule, Ticket, User
+
+
+def test_cannot_close_new_ticket():
+    with pytest.raises(DomainError, match="недопустим") as error:
+        validate_transition("Новое", "Закрыто", "manager")
+    assert error.value.status == 409
+
+
+def test_rejection_requires_reason():
+    with pytest.raises(DomainError, match="мотивировку"):
+        validate_transition("На рассмотрении", "Отклонено", "manager", " ")
+
+
+def test_implementation_requires_result():
+    with pytest.raises(DomainError, match="что изменилось"):
+        validate_transition("В работе", "Реализовано", "manager", "Готово")
+
+
+def test_clarification_requires_question():
+    with pytest.raises(DomainError, match="текст запроса"):
+        validate_transition("В работе", "Ожидает уточнения", "manager", "")
+
+
+def test_manager_cannot_confirm_for_author():
+    with pytest.raises(DomainError, match="Только автор"):
+        validate_transition("Реализовано", "Закрыто", "manager")
+
+
+def test_employee_cannot_read_other_ticket():
+    employee = User(id="employee", role="Сотрудник")
+    ticket = Ticket(author_id="other", participants=[])
+    assert can_read(employee, ticket) is False
+
+
+def test_admin_cannot_read_even_own_assignment():
+    admin = User(id="admin", role="Администратор")
+    ticket = Ticket(author_id="admin", assignee_id="admin", participants=[])
+    assert can_read(admin, ticket) is False
+
+
+def test_joined_employee_can_read_ticket():
+    employee = User(id="employee", role="Сотрудник")
+    ticket = Ticket(author_id="other", participants=[Participant(user_id="employee")])
+    assert can_read(employee, ticket) is True
+
+
+def test_vacation_routes_to_backup():
+    primary = User(id="primary", role="Руководитель", vacation=True)
+    backup = User(id="backup", role="Руководитель", vacation=False)
+    rule = RoutingRule(category_id="category", department_id=None,
+                       primary_id="primary", backup_id="backup")
+    selected = choose_assignment("category", "department", [rule], [primary, backup], None, "backup")
+    assert selected.user.id == "backup"
+    assert selected.fallback is True
+
+
+def test_both_absent_still_assigns_department_head():
+    primary = User(id="primary", role="Руководитель", vacation=True)
+    backup = User(id="backup", role="Руководитель", vacation=True)
+    head = User(id="head", role="Руководитель", vacation=False)
+    rule = RoutingRule(category_id="category", department_id=None,
+                       primary_id="primary", backup_id="backup")
+    selected = choose_assignment("category", "department", [rule], [primary, backup, head], "head", "head")
+    assert selected.user.id == "head"
+    assert "резервному правилу" in selected.reason
+
+
+def test_missing_category_uses_default_rule():
+    head = User(id="head", role="Руководитель", vacation=False)
+    rule = RoutingRule(category_id=None, department_id=None, primary_id="head", backup_id="head")
+    selected = choose_assignment("unknown", "department", [rule], [head], "head", "head")
+    assert selected.user.id == "head"
+    assert selected.rule is rule
+
+
+def test_business_days_skip_holiday_and_honor_working_saturday():
+    calendar = BusinessCalendar({date(2026, 11, 4), date(2027, 2, 22)}, {date(2027, 2, 20)}, "UTC")
+    assert calendar.add_days(datetime(2026, 11, 3, 12), 1) == datetime(2026, 11, 5, 12)
+    assert calendar.add_days(datetime(2027, 2, 19, 12), 1) == datetime(2027, 2, 20, 12)
diff --git a/docker-compose.yml b/docker-compose.yml
new file mode 100644
index 0000000000000000000000000000000000000000..53ea8327bf63038550807d560b58f9b9ff3ca90c
--- /dev/null
+++ b/docker-compose.yml
@@ -0,0 +1,46 @@
+# Целевой вариант. Docker недоступен в среде агента: compose не проверен запуском.
+services:
+  postgres:
+    image: postgres:17-alpine
+    environment:
+      POSTGRES_DB: signal
+      POSTGRES_USER: signal
+      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD}
+    volumes:
+      - postgres_data:/var/lib/postgresql/data
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U signal -d signal"]
+      interval: 5s
+      timeout: 5s
+      retries: 10
+  backend:
+    build:
+      context: .
+      dockerfile: backend/Dockerfile
+    environment:
+      DATABASE_URL: postgresql+psycopg://signal:${POSTGRES_PASSWORD}@postgres:5432/signal
+      JWT_SECRET: ${JWT_SECRET:?Set JWT_SECRET}
+      STORAGE_DIRECTORY: /workspace/backend/storage
+      SLA_INTERVAL_SECONDS: 60
+    volumes:
+      - attachments:/workspace/backend/storage
+    depends_on:
+      postgres:
+        condition: service_healthy
+    healthcheck:
+      test: ["CMD", "uv", "run", "--no-sync", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"]
+      interval: 10s
+      timeout: 5s
+      retries: 10
+  frontend:
+    build:
+      context: .
+      dockerfile: frontend/Dockerfile
+    ports:
+      - "8080:80"
+    depends_on:
+      backend:
+        condition: service_healthy
+volumes:
+  postgres_data:
+  attachments:
diff --git a/docs/architecture.md b/docs/architecture.md
new file mode 100644
index 0000000000000000000000000000000000000000..b7353648d818567185615cc5a977940fd906aa2c
--- /dev/null
+++ b/docs/architecture.md
@@ -0,0 +1,179 @@
+# Сигнал · Архитектура MVP
+
+Система принимает проблемы, предложения и отзывы сотрудников, назначает ответственного, контролирует сроки и сохраняет результат. Frontend поддерживает HTTP по умолчанию и статический mock. В обоих режимах демо-источник один — `data/seed.json`: 20 исходных и 40 вручную написанных обращений, роли вместо персональных данных, относительные даты.
+
+## Компоненты
+
+```mermaid
+flowchart LR
+    UI[React 18 / Vite] --> Adapter[Фасад src/api]
+    Adapter --> HTTP[HTTP-адаптер / JWT]
+    Adapter --> Mock[Mock / localStorage]
+    Seed[data/seed.json] --> Mock
+    Seed --> Import[app.seed]
+    HTTP --> API[FastAPI / Pydantic]
+    API --> Domain[Права / workflow / маршрутизация / календарь]
+    API --> SQL[SQL-аналитика / XLSX]
+    Domain --> DB[(SQLAlchemy / SQLite или PostgreSQL)]
+    SQL --> DB
+    Import --> DB
+    API --> Storage[Storage / локальные вложения]
+    API --> AI[AIProvider / RuleBasedProvider]
+    Timer[asyncio / ручной запуск SLA] --> Domain
+    Domain --> Notice[notifications / LogNotifier]
+    Notice --> DB
+    UI --> Bell[Колокольчик / опрос 15 секунд]
+    Bell --> HTTP
+```
+
+FastAPI использует синхронные SQLAlchemy Session на запрос. Изменения обращения, аудит и внутрисистемные уведомления фиксируются одной транзакцией; завершение транзакции выполняется до отправки ответа через `Depends(..., scope="function")`. Это соответствует [жизненному циклу зависимостей FastAPI](https://fastapi.tiangolo.com/tutorial/dependencies/dependencies-with-yield/). Версия строки обращения защищает от потери конкурентных изменений: конфликт → 409 с предложением обновить карточку.
+
+SLA проверяется одним процессом с настраиваемым интервалом `SLA_INTERVAL_SECONDS` (по умолчанию 60, минимум 5 секунд). Ручной запуск защищён правами администратора. Блокировка внутри процесса исключает одновременные ручную и фоновую проверки; ключи уведомлений предотвращают повторные напоминания по одному сроку. MVP рассчитан на один процесс планировщика, а не на несколько независимых worker-процессов.
+
+## Данные
+
+```mermaid
+erDiagram
+    departments ||--o{ users : department
+    users o|--o{ users : supervisor
+    categories ||--o{ tickets : category
+    categories o|--o{ routing_rules : category_rule
+    departments o|--o{ routing_rules : department_rule
+    users ||--o{ routing_rules : primary_and_backup
+    users o|--o{ tickets : author
+    users ||--o{ tickets : assignee
+    departments ||--o{ tickets : author_and_target
+    tickets ||--o{ ticket_participants : joined
+    users ||--o{ ticket_participants : participant
+    tickets ||--o{ comments : discussion
+    users ||--o{ comments : author
+    tickets ||--o{ ticket_events : audit
+    users o|--o{ ticket_events : actor
+    tickets o|--o{ attachments : files
+    users ||--o{ attachments : uploader
+    tickets ||--o{ notifications : changes
+    users ||--o{ notifications : recipient
+    tickets ||--o{ ticket_clusters : membership
+    clusters ||--o{ ticket_clusters : membership
+    tickets {
+        string id PK
+        string author_id FK "nullable, задел для анонимного канала"
+        boolean is_anonymous
+        string assignee_id FK "обязателен"
+        string original_category
+        datetime response_due_at
+        datetime due_at
+        boolean escalated
+        boolean confirmed
+        boolean default_confirmed
+        int version
+    }
+    ticket_events {
+        string id PK
+        string ticket_id FK
+        string actor_id FK "nullable для системы"
+        datetime date
+        string field
+        string old_value
+        string new_value
+    }
+```
+
+Справочник укрупнён до девяти категорий. Сопоставление старых названий хранится в `seed.json.categoryMap`; у каждого обращения сохранено `original_category`. Маршрутизация использует укрупнённую категорию. Начальные назначения A-001…A-020 и их исходные тексты/статусы сохранены; после запуска планировщик может штатно закрыть реализованные обращения без ответа автора.
+
+Оценки потерь хранятся у автора и участников. `monthly_cost` пересчитывается при присоединении и используется SQL-агрегациями. Первый ответ хранит дату и рассчитанную длительность в рабочих часах, чтобы медиана и среднее вычислялись SQL-запросами. KPI, распределения, недельная динамика, кластеры, матрица и SLA выдаются готовыми агрегатами; детализация запрашивается отдельно с серверной проверкой области доступа и ограничением числа строк.
+
+Миграции Alembic используют обычные таблицы, внешние ключи, индексы и ограничения SQLAlchemy, без диалектного SQL. SQLite — локальный вариант без Docker. `DATABASE_URL=postgresql+psycopg://...` переключает на PostgreSQL. PostgreSQL и compose в среде агента не запускались.
+
+## Машина состояний
+
+```mermaid
+stateDiagram-v2
+    [*] --> New
+    New --> Review: ответственный
+    New --> Work: взять в работу
+    New --> Clarify: задать вопрос
+    New --> Rejected: мотивировка
+    Review --> Work
+    Review --> Clarify
+    Review --> Done: результат
+    Review --> Rejected
+    Work --> Clarify
+    Work --> Done: что изменилось
+    Work --> Rejected
+    Clarify --> Review: ответ автора
+    Clarify --> Work: продолжить рассмотрение
+    Clarify --> Rejected
+    Done --> Closed: автор подтвердил
+    Done --> Returned: автор указал причину
+    Done --> Closed: система после 5 рабочих дней
+    Returned --> Review
+    Returned --> Work
+    Returned --> Clarify
+    Returned --> Rejected
+    Closed --> [*]
+    Rejected --> [*]
+    state "Новое" as New
+    state "На рассмотрении" as Review
+    state "В работе" as Work
+    state "Ожидает уточнения" as Clarify
+    state "Реализовано" as Done
+    state "Возвращено автором" as Returned
+    state "Закрыто" as Closed
+    state "Отклонено" as Rejected
+```
+
+Единственный источник разрешённых переходов — `domain/workflow.py`. Вопрос, отказ, результат и причина возврата должны содержать минимум 10 символов. Нарушение перехода → 409. После реализации ответственному недоступно закрытие за автора. Возврат создаёт новый срок в пять рабочих дней; автоматическое закрытие не увеличивает число явных подтверждений авторами.
+
+## Права
+
+| Представление / действие | Сотрудник | Ответственный | Руководитель подразделения | Руководитель направления | Администратор |
+| --- | --- | --- | --- | --- | --- |
+| Полная карточка | Свои и присоединённые | Назначенные | Назначения своего подразделения | Свои назначения и эскалированные ему | Нет |
+| Комментарии и вложения | В доступных карточках | В доступных карточках | В доступных карточках | В доступных карточках | Нет |
+| Статусы, уточнение, переназначение | Нет | Назначенные | Своё подразделение | Назначенные и эскалированные | Нет |
+| Подтверждение / возврат | Только автор своего | Нет | Нет | Нет | Нет |
+| Похожие | Публичная сводка без переписки | Публичная сводка | Публичная сводка | Публичная сводка | Нет |
+| Сделано | Публичный результат | Публичный результат | Публичный результат | Публичный результат | Публичный результат |
+| Аналитика / Excel | Нет | Свои назначения | Своё подразделение | Вся компания с флагом | Только отдельные агрегаты без содержимого |
+| Справочники / отпуск / маршруты / запуск SLA / сброс | Чтение нужных справочников | Чтение | Чтение | Чтение | Управление |
+
+В UI ответственные и руководители объединены под ролью «Руководитель»; сервер различает `is_department_head` и `can_view_company_analytics`. Единственный пользователь с компанейской аналитикой в сиде — **Руководитель направления (`manager-2`)**. Администратор не получает содержимое даже по прямому ID. Переход из аналитической сводки «Открыть как ответственный» явно выполняет новый демо-вход.
+
+## Назначение, календарь и SLA
+
+Приоритет правил: категория + подразделение → категория → общее правило. Отпуск основного включает резервного. Если оба недоступны, назначается руководитель подразделения проблемы, затем руководитель направления; в аудит пишется назначение по резервному правилу. Отсутствие руководителей в повреждённой конфигурации блокирует регистрацию с 503, а не создаёт обращение без владельца.
+
+Календарь РФ на 2026–2027 находится в `app/holidays.json`: праздники, перенесённые выходные и рабочая суббота 20 февраля 2027 года. Основания: [переносы 2026 года](https://static.government.ru/media/files/4jeB8hNKm69ggOa9yDiYOli6YoAyM21i.pdf), [официальное сообщение о календаре 2027 года](https://www.meteorf.gov.ru/press/newsactual/45104/). Календарь считает рабочие дни и часы 09:00–17:00 в `BUSINESS_TIMEZONE` (по умолчанию Europe/Moscow); сокращённые предпраздничные часы не моделируются.
+
+За один рабочий день до срока система уведомляет ответственного. Просрочка первого ответа уведомляет руководителя подразделения и фиксируется в аудите. Просрочка решения больше трёх рабочих дней включает метку «Эскалировано» и уведомление руководителю направления; ему предоставляется доступ к эскалированной карточке. Реализация без реакции автора через пять рабочих дней закрывается как подтверждённая по умолчанию. Для демонстрации ждать не нужно: в исходном наборе есть старые открытые и реализованные обращения, а администратору доступен ручной запуск проверки.
+
+## Безопасность и файлы
+
+Демо-вход выдаёт JWT HS256 с `sub`, `iat`, `exp`, `iss`, `aud`; секрет читается из env. Без `JWT_SECRET` локально используется случайный секрет процесса, поэтому перезапуск требует повторного входа. Токен хранится в памяти frontend, права и текущая роль заново читаются из БД. Демо-вход публично позволяет выбрать любую демонстрационную роль: это сознательная замена SSO для показа, а не промышленная аутентификация.
+
+Предметные изменения журналируются с автором, временем, старым и новым статусом/ответственным. Прямые запросы не обходят серверные права; 403, 409 и 422 возвращают короткие русские сообщения. Сервер не принимает автора из формы. Все значения в SQL параметризованы ORM; экспорт экранирует текст, который Excel мог бы принять за формулу.
+
+Вложения до 10 МБ проходят проверку расширения (`pdf`, `png`, `jpg`, `docx`, `xlsx`, `txt`) и записываются потоково за интерфейсом `Storage`. Имя на диске — случайный ключ, исходное имя служит только отображению. До создания обращения скачать файл может только загрузивший сотрудник; после привязки действуют права карточки. Каталог не публикуется nginx. Скачивание идёт через проверяемый API с `nosniff`. `Storage.open/save` позволяет позже подключить S3, не меняя права и маршруты. Антивирус и анализ содержимого не входят в MVP; незакреплённые загрузки и файлы после сброса демо не удаляются автоматически.
+
+`Notifier` отделяет уведомления в БД от внешних каналов. Сейчас `LogNotifier` только пишет в лог предполагаемую доставку; email и сообщения в Битрикс24 реально не отправляются.
+
+В модели оставлены nullable `author_id` и `is_anonymous`. Анонимный вход не реализован. При последующем развитии потребуется отдельный высокоэнтропийный токен конверта (хеш в БД), права на чтение и ответ только владельцу токена, отдельная политика публикации и журнал без раскрытия личности. Подмена `authorId` или `isAnonymous` в текущем API запрещена схемой.
+
+## План интеграций
+
+| Система | Какие данные и направление | Способ | Что уточнить |
+| --- | --- | --- | --- |
+| Битрикс24: SSO | Идентификатор и проверенная роль из провайдера → Сигнал | Корпоративный OAuth/OIDC через согласованный шлюз | Поддерживаемый протокол конкретного портала, привязка учётных записей, отзыв доступа |
+| AD | Корпоративная идентичность и группы → Сигнал через SSO-провайдер | OIDC/SAML-шлюз к AD | Доступный провайдер, MFA и правила групп |
+| Битрикс24: оргструктура | Подразделения, руководители, замещения → Сигнал | REST, периодическая синхронизация и события изменений | Источник истины, идентификаторы подразделений, правила временного замещения |
+| Битрикс24: уведомления | Ссылка на доступное обращение, срок и короткое событие Сигнал → мессенджер | REST/вебхук через адаптер Notifier | Права приложения, получатели, перечень разрешённых полей, повторная доставка |
+| Битрикс24: задачи | Обращение и согласованное действие Сигнал → задача; состояние задачи → событие Сигнала | REST + подписанные входящие вебхуки | Кто владеет закрытием, защита от циклических обновлений, идемпотентные внешние ID |
+| 1С: справочники | Активные сотрудники, роли и подразделения 1С → Сигнал | Согласованный HTTP-сервис/регламентный обмен | Какая конфигурация является источником кадровых данных, соответствие ID Битрикс24/AD, доступность поля отпуска |
+| 1С: результат улучшения | Только утверждённый агрегат по улучшениям Сигнал → отчёт/регистр 1С, если нужен бизнесу | REST/регламентный пакет; очередь — последующий этап при необходимости гарантированной доставки | Состав агрегата, получатель и период; коммерческие документы и данные сделок не передавать без отдельного согласования |
+
+План не предполагает передачи паролей, произвольных вложений и полной переписки в другие системы. Для реального обмена нужны сервисные учётные записи с минимальными правами, согласование схем, правил удаления и повторной доставки. Интеграции в этом этапе не исполняются.
+
+## Ограничения MVP
+
+Один процесс API/планировщика, локальное файловое хранилище и демонстрационная идентификация. Нет реальных интеграций, LLM, почты, очередей и распределённого планировщика. AIProvider реализован правилами и IDF; полнотекстовый SQL-индекс/эмбеддинги не добавлены. Списки API имеют пагинацию, текущий UI загружает до 500 обращений, экспорт — до 50 000. Mock хранит предметные изменения в localStorage и не имитирует серверный планировщик; файлы mock живут до перезагрузки, XLSX требует HTTP. Docker и PostgreSQL требуют отдельной проверки развёртывания.
