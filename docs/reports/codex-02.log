-function detectCluster(text) {
-  const scores = clusters.map((c) => ({
-    id: c.id,
-    score: c.keywords.filter((w) => text.toLowerCase().includes(w)).length
-  }));
-  const best = scores.sort((a, b) => b.score - a.score)[0];
-  return best.score ? best.id : "";
-}
