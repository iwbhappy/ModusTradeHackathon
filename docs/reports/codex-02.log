-function originalResult(id: string): string {
-  if (id === 'A-004') {
-    return 'Запланирован пробный обучающий семинар; опубликован календарь встреч.';
+  const anchor = demoAnchor().getTime();
+  function materialize(value: unknown): unknown {
+    if (Array.isArray(value)) return value.map(materialize);
+    if (value && typeof value === 'object') {
+      if ('offsetDays' in value && typeof value.offsetDays === 'number') {
+        return new Date(anchor + value.offsetDays * 86400000).toISOString();
+      }
+      return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, materialize(item)]));
