diff --git a/backend/app/presenters.py b/backend/app/presenters.py
new file mode 100644
index 0000000000000000000000000000000000000000..27652e8cdb62fc0d391a01153724941d04200e90
--- /dev/null
+++ b/backend/app/presenters.py
@@ -0,0 +1,69 @@
+import json
+from datetime import datetime
+from sqlalchemy.orm import Session
+
+from .models import Category, Department, Ticket, User, Cluster, RoutingRule, Attachment
+from .domain.workflow import STATUSES, TRANSITIONS
+
+
+def iso(value: datetime | None):
+    return value.isoformat(timespec="milliseconds") + "Z" if value else None
+
+
+def user_view(user: User):
+    return {"id": user.id, "name": user.name, "role": user.role,
+            "department": user.department.name, "vacation": user.vacation,
+            "isDepartmentHead": user.is_department_head,
+            "canViewCompanyAnalytics": user.can_view_company_analytics}
+
+
+def attachment_view(item: Attachment):
+    return {"id": item.id, "name": item.name, "size": item.size}
+
+
+def ticket_view(db: Session, t: Ticket, public: bool = False):
+    department = lambda key: db.get(Department, key).name
+    actor = lambda key: db.get(User, key).name if key else "Система"
+    return {
+        "id": t.id, "title": t.title, "text": t.text if not public else "",
+        "type": t.type, "category": db.get(Category, t.category_id).name,
+        "originalCategory": t.original_category, "priority": t.priority, "status": t.status,
+        "authorId": t.author_id or "", "authorDepartment": department(t.author_department_id),
+        "targetDepartment": department(t.target_department_id), "assigneeId": t.assignee_id,
+        "createdAt": iso(t.created_at), "responseDueAt": iso(t.response_due_at), "dueAt": iso(t.due_at),
+        "firstResponseAt": iso(t.first_response_at), "implementedAt": iso(t.implemented_at),
+        "closedAt": iso(t.closed_at), "frequency": t.frequency, "minutes": t.minutes,
+        "monthlyCost": t.monthly_cost, "solution": "" if public else t.solution,
+        "effect": "" if public else t.effect, "changed": t.changed,
+        "rejection": "" if public else t.rejection, "confirmed": t.confirmed,
+        "defaultConfirmed": t.default_confirmed, "escalated": t.escalated,
+        "clusterId": t.cluster_links[0].cluster_id if t.cluster_links else "",
+        "attachments": [] if public else [a.name for a in t.attachments],
+        "attachmentFiles": [] if public else [attachment_view(a) for a in t.attachments],
+        "comments": [] if public else [{"id": c.id, "date": iso(c.date), "author": actor(c.author_id),
+                                        "text": c.text} for c in t.comments],
+        "events": [] if public else [{"id": e.id, "date": iso(e.date), "actor": actor(e.actor_id),
+                                      "text": e.text, "field": e.field, "oldValue": e.old_value,
+                                      "newValue": e.new_value,
+                                      "status": e.new_value if e.field == "status" else None} for e in t.events],
+        "participantCount": len(t.participants),
+        "participants": [{"userId": p.user_id, "department": department(p.department_id),
+                          "context": "" if public else p.context, "frequency": p.frequency,
+                          "minutes": p.minutes} for p in t.participants],
+    }
+
+
+def catalog_view(db: Session, user: User | None = None):
+    departments = {d.id: d.name for d in db.query(Department).all()}
+    categories = {c.id: c.name for c in db.query(Category).all()}
+    rules = db.query(RoutingRule).all() if user and user.role == "Администратор" else []
+    return {"users": [user_view(u) for u in db.query(User).order_by(User.id).all()],
+            "departments": list(departments.values()), "categories": list(categories.values()),
+            "statuses": STATUSES,
+            "transitions": {key: list(value) for key, value in TRANSITIONS.items()},
+            "clusters": [{"id": c.id, "title": c.title, "keywords": json.loads(c.keywords)}
+                         for c in db.query(Cluster).all()],
+            "rules": [{"id": r.id, "category": categories.get(r.category_id, ""),
+                       "department": departments.get(r.department_id, ""), "primaryId": r.primary_id,
+                       "backupId": r.backup_id, "responseDays": r.response_days,
+                       "resolutionDays": r.resolution_days} for r in rules]}
diff --git a/backend/app/routes.py b/backend/app/routes.py
new file mode 100644
index 0000000000000000000000000000000000000000..e03a8152f0b3bdd81bdb457c55c61bf41060b370
--- /dev/null
+++ b/backend/app/routes.py
@@ -0,0 +1,298 @@
+import json
+from pathlib import Path
+from typing import Annotated
+
+from fastapi import APIRouter, File, Query, UploadFile
+from fastapi.responses import StreamingResponse
+from urllib.parse import quote
+from sqlalchemy import func, select
+
+from . import analytics, models as m, schemas as s, services
+from .auth import Admin, CurrentUser, Database, issue_token
+from .domain.errors import DomainError
+from .domain.permissions import require_ticket, visible_clause
+from .domain.workflow import TERMINAL
+from .presenters import attachment_view, catalog_view, iso, ticket_view, user_view
+from .storage import storage
+from .ai.provider import provider
+
+router = APIRouter(prefix="/api")
+
+
+@router.get("/auth/demo-users")
+def demo_users(db: Database):
+    return [user_view(user) for user in db.scalars(select(m.User).order_by(m.User.id)).all()]
+
+
+@router.post("/auth/demo-login")
+def login(data: s.Login, db: Database):
+    user = db.get(m.User, data.user_id)
+    if not user:
+        raise DomainError("Демо-пользователь не найден", 404)
+    return {"token": issue_token(user), "user": user_view(user)}
+
+
+@router.get("/catalog")
+def catalog(db: Database, user: CurrentUser):
+    return catalog_view(db, user)
+
+
+def filters(db, statement, search="", department="", category="", status="", priority="",
+            overdue=False, cluster="", authorDepartment="", targetDepartment="", assigneeDepartment=""):
+    if search:
+        pattern = "%" + search.replace("%", "\\%").replace("_", "\\_") + "%"
+        statement = statement.where(m.Ticket.title.ilike(pattern, escape="\\") | m.Ticket.text.ilike(pattern, escape="\\") | m.Ticket.id.ilike(pattern, escape="\\"))
+    for model, value, column in [(m.Department, department or targetDepartment, m.Ticket.target_department_id),
+                                  (m.Department, authorDepartment, m.Ticket.author_department_id),
+                                  (m.Category, category, m.Ticket.category_id)]:
+        if value:
+            statement = statement.where(column.in_(select(model.id).where(model.name == value)))
+    if assigneeDepartment:
+        statement = statement.where(m.Ticket.assignee_id.in_(select(m.User.id).join(m.Department).where(m.Department.name == assigneeDepartment)))
+    if status:
+        statement = statement.where(m.Ticket.status == status)
+    if priority:
+        statement = statement.where(m.Ticket.priority == priority)
+    if overdue:
+        statement = statement.where(m.Ticket.status.not_in(TERMINAL), m.Ticket.due_at < services.now())
+    if cluster:
+        statement = statement.where(m.Ticket.id.in_(select(m.TicketCluster.ticket_id).where(m.TicketCluster.cluster_id == cluster)))
+    return statement
+
+
+@router.get("/tickets")
+def list_tickets(db: Database, user: CurrentUser, search: str = "", department: str = "", category: str = "",
+                 status: str = "", priority: str = "", overdue: bool = False, cluster: str = "",
+                 authorDepartment: str = "", targetDepartment: str = "",
+                 offset: int = Query(0, ge=0), limit: int = Query(100, ge=1, le=500)):
+    query = filters(db, select(m.Ticket).where(visible_clause(user)), search, department, category,
+                    status, priority, overdue, cluster, authorDepartment, targetDepartment)
+    return [ticket_view(db, t) for t in db.scalars(query.order_by(m.Ticket.created_at.desc()).offset(offset).limit(limit))]
+
+
+@router.post("/tickets", status_code=201)
+def create_ticket(data: s.TicketDraft, db: Database, user: CurrentUser):
+    ticket = services.create_ticket(db, user, data)
+    db.flush()
+    db.expire(ticket)
+    return ticket_view(db, ticket)
+
+
+@router.get("/tickets/{ticket_id}")
+def get_ticket(ticket_id: str, db: Database, user: CurrentUser):
+    return ticket_view(db, require_ticket(db, user, ticket_id))
+
+
+def updated(db, ticket):
+    db.flush()
+    db.expire(ticket)
+    return ticket_view(db, ticket)
+
+
+@router.post("/tickets/{ticket_id}/status")
+def status(ticket_id: str, data: s.StatusChange, db: Database, user: CurrentUser):
+    return updated(db, services.change_status(db, user, ticket_id, data.status, data.text))
+
+
+@router.post("/tickets/{ticket_id}/comments")
+def comment(ticket_id: str, data: s.TextInput, db: Database, user: CurrentUser):
+    return updated(db, services.add_comment(db, user, ticket_id, data.text))
+
+
+@router.post("/tickets/{ticket_id}/confirm")
+def confirm(ticket_id: str, data: s.ConfirmInput, db: Database, user: CurrentUser):
+    return updated(db, services.confirm(db, user, ticket_id, data.solved, data.reason))
+
+
+@router.post("/tickets/{ticket_id}/reassign")
+def reassign(ticket_id: str, data: s.ReassignInput, db: Database, user: CurrentUser):
+    ticket = require_ticket(db, user, ticket_id, manage=True)
+    assignee = db.get(m.User, data.assignee_id)
+    if ticket.status in TERMINAL or not assignee or assignee.role != "Руководитель" or assignee.vacation or assignee.id == ticket.assignee_id:
+        raise DomainError("Выберите другого доступного ответственного для открытого обращения")
+    previous = ticket.assignee_id
+    ticket.assignee_id = assignee.id
+    services.audit(db, ticket, user, f"Переназначено: {data.reason.strip()}", "assignee", previous, assignee.id)
+    services.notify(db, assignee.id, ticket, f"{ticket.id}: назначено вам. {data.reason.strip()}")
+    services.notify(db, ticket.author_id, ticket, f"{ticket.id}: ответственный изменён")
+    return updated(db, ticket)
+
+
+@router.post("/tickets/{ticket_id}/join")
+def join(ticket_id: str, data: s.JoinInput, db: Database, user: CurrentUser):
+    if user.role != "Сотрудник":
+        raise DomainError("Присоединение доступно сотрудникам", 403)
+    ticket = db.get(m.Ticket, ticket_id)
+    if not ticket:
+        raise DomainError("Обращение не найдено", 404)
+    if ticket.status in TERMINAL or ticket.author_id == user.id or any(p.user_id == user.id for p in ticket.participants):
+        raise DomainError("Обращение завершено или уже есть в вашем списке")
+    db.add(m.Participant(ticket_id=ticket.id, user_id=user.id, department_id=user.department_id,
+                          context=data.context.strip(), frequency=data.frequency, minutes=data.minutes))
+    if ticket.type == "Проблема":
+        ticket.monthly_cost += services.cost(data.frequency, data.minutes)
+    services.audit(db, ticket, user, f"Присоединился: {data.context.strip()}")
+    services.notify(db, ticket.assignee_id, ticket, f"{ticket.id}: присоединился сотрудник")
+    return updated(db, ticket)
+
+
+@router.get("/routing/preview")
+def routing_preview(db: Database, user: CurrentUser, category: str, targetDepartment: str):
+    return services.route_preview(db, category, targetDepartment)
+
+
+@router.put("/admin/routing/{rule_id}")
+def save_rule(rule_id: str, data: s.RuleInput, db: Database, user: Admin):
+    rule = db.get(m.RoutingRule, rule_id)
+    if not rule or rule_id != data.id:
+        raise DomainError("Правило не найдено", 404)
+    if data.primary_id == data.backup_id or data.resolution_days < data.response_days:
+        raise DomainError("Нужны разные ответственные; срок решения не раньше первого ответа", 422)
+    for key in [data.primary_id, data.backup_id]:
+        candidate = db.get(m.User, key)
+        if not candidate or candidate.role != "Руководитель":
+            raise DomainError("Ответственным должен быть руководитель", 422)
+    rule.category_id = services.lookup(db, m.Category, data.category).id if data.category else None
+    rule.department_id = services.lookup(db, m.Department, data.department).id if data.department else None
+    rule.scope_key = f"{rule.category_id or '*'}:{rule.department_id or '*'}"
+    rule.primary_id, rule.backup_id = data.primary_id, data.backup_id
+    rule.response_days, rule.resolution_days = data.response_days, data.resolution_days
+    return {"message": "Правило сохранено"}
+
+
+@router.put("/admin/users/{user_id}/vacation")
+def vacation(user_id: str, data: s.VacationInput, db: Database, user: Admin):
+    target = db.get(m.User, user_id)
+    if not target:
+        raise DomainError("Пользователь не найден", 404)
+    target.vacation = data.vacation
+    return user_view(target)
+
+
+@router.post("/admin/reset-demo")
+def reset(db: Database, user: Admin):
+    from .seed import load_seed
+    return {"count": load_seed(db, reset=True)}
+
+
+@router.post("/admin/run-sla-check")
+def check(user: Admin):
+    from .sla import run_check
+    return run_check()
+
+
+@router.get("/admin/aggregates")
+def aggregates(db: Database, user: Admin):
+    return {"tickets": db.scalar(select(func.count(m.Ticket.id))),
+            "notifications": db.scalar(select(func.count(m.Notification.id)))}
+
+
+@router.get("/notifications")
+def notifications(db: Database, user: CurrentUser):
+    rows = db.scalars(select(m.Notification).where(m.Notification.user_id == user.id)
+                      .order_by(m.Notification.created_at.desc()).limit(100)).all()
+    return [{"id": n.id, "ticketId": n.ticket_id, "text": n.text, "date": iso(n.created_at), "read": n.read} for n in rows]
+
+
+@router.post("/notifications/{notification_id}/read")
+def mark_read(notification_id: str, db: Database, user: CurrentUser):
+    item = db.get(m.Notification, notification_id)
+    if not item or item.user_id != user.id:
+        raise DomainError("Уведомление недоступно", 403)
+    item.read = True
+    return {"message": "Прочитано"}
+
+
+@router.post("/attachments", status_code=201)
+async def upload(db: Database, user: CurrentUser, file: Annotated[UploadFile, File()]):
+    if user.role != "Сотрудник":
+        raise DomainError("Загрузка доступна автору обращения", 403)
+    filename = Path((file.filename or "file").replace("\\", "/")).name[:255]
+    key, size = await storage().save(file)
+    item = m.Attachment(uploader_id=user.id, name=filename, key=key, size=size)
+    db.add(item)
+    db.flush()
+    return attachment_view(item)
+
+
+@router.get("/attachments/{attachment_id}")
+def download(attachment_id: str, db: Database, user: CurrentUser):
+    item = db.get(m.Attachment, attachment_id)
+    if not item:
+        raise DomainError("Вложение не найдено", 404)
+    if item.ticket_id:
+        require_ticket(db, user, item.ticket_id)
+    elif item.uploader_id != user.id or user.role == "Администратор":
+        raise DomainError("Вложение недоступно", 403)
+    source = storage().open(item.key)
+    def chunks():
+        try:
+            while chunk := source.read(64 * 1024):
+                yield chunk
+        finally:
+            source.close()
+    return StreamingResponse(chunks(), media_type="application/octet-stream",
+                             headers={"X-Content-Type-Options": "nosniff",
+                                      "Content-Disposition": "attachment; filename*=UTF-8''" + quote(item.name)})
+
+
+@router.post("/ai/similar")
+def similar(data: s.SimilarInput, db: Database, user: CurrentUser):
+    if user.role == "Администратор":
+        raise DomainError("Администратору недоступен поиск по содержимому", 403)
+    categories = {c.id: c.name for c in db.scalars(select(m.Category))}
+    departments = {d.id: d.name for d in db.scalars(select(m.Department))}
+    candidates = [{"id": t.id, "title": t.title, "text": t.text, "status": t.status,
+                   "category": categories[t.category_id], "targetDepartment": departments[t.target_department_id]}
+                  for t in db.scalars(select(m.Ticket))]
+    matches = provider.similar(data.text, data.category, data.target_department, candidates)
+    return [{**ticket_view(db, db.get(m.Ticket, item["id"]), public=True),
+             "matchExplanation": item["matchExplanation"]} for item in matches]
+
+
+@router.post("/ai/structure")
+def structure(data: s.TextInput, user: CurrentUser):
+    if user.role != "Сотрудник":
+        raise DomainError("Структуратор доступен сотруднику", 403)
+    if len(data.text.strip()) < 20:
+        raise DomainError("Для анализа нужно минимум 20 символов", 422)
+    return provider.structure(data.text, "", "", [])
+
+
+@router.post("/tickets/{ticket_id}/draft-response")
+def draft(ticket_id: str, data: s.StatusChange, db: Database, user: CurrentUser):
+    ticket = require_ticket(db, user, ticket_id, manage=True)
+    return {"text": provider.draft(ticket.title, db.get(m.Category, ticket.category_id).name,
+                                   db.get(m.Department, ticket.target_department_id).name, [], data.status)}
+
+
+@router.get("/improvements")
+def improvements(db: Database, user: CurrentUser):
+    tickets = db.scalars(select(m.Ticket).where(m.Ticket.status.in_(["Реализовано", "Закрыто"]),
+                        m.Ticket.implemented_at.is_not(None), m.Ticket.changed != "").order_by(m.Ticket.implemented_at.desc()))
+    return [{**ticket_view(db, t, public=True), "text": t.text} for t in tickets]
+
+
+@router.get("/analytics")
+def get_analytics(db: Database, user: CurrentUser, days: int = Query(90, ge=0, le=3650)):
+    return analytics.summary(db, user, days)
+
+
+@router.get("/analytics/tickets")
+def analytics_tickets(db: Database, user: CurrentUser, days: int = Query(90, ge=0, le=3650),
+                      cluster: str = "", authorDepartment: str = "", targetDepartment: str = "",
+                      assigneeDepartment: str = "", overdue: bool = False, type: str = "",
+                      offset: int = Query(0, ge=0), limit: int = Query(100, ge=1, le=500)):
+    query = filters(db, select(m.Ticket).where(*analytics.conditions(user, days)), cluster=cluster,
+                    authorDepartment=authorDepartment, targetDepartment=targetDepartment,
+                    assigneeDepartment=assigneeDepartment, overdue=overdue)
+    if type:
+        query = query.where(m.Ticket.type == type)
+    return [ticket_view(db, t, public=True) for t in db.scalars(query.order_by(m.Ticket.created_at.desc()).offset(offset).limit(limit))]
+
+
+@router.get("/analytics/export.xlsx")
+def export(db: Database, user: CurrentUser, days: int = Query(90, ge=0, le=3650)):
+    return StreamingResponse(analytics.registry(db, user, days),
+                             media_type="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+                             headers={"Content-Disposition": 'attachment; filename="signal-register.xlsx"'})
diff --git a/backend/app/schemas.py b/backend/app/schemas.py
new file mode 100644
index 0000000000000000000000000000000000000000..1acf87f32e346e9e01c4c0e4de5cde1c4f34a765
--- /dev/null
+++ b/backend/app/schemas.py
@@ -0,0 +1,71 @@
+from typing import Literal
+from pydantic import BaseModel, ConfigDict, Field
+from pydantic.alias_generators import to_camel
+
+
+class Input(BaseModel):
+    model_config = ConfigDict(alias_generator=to_camel, populate_by_name=True, extra="forbid")
+
+
+class Login(Input):
+    user_id: str
+
+
+class TicketDraft(Input):
+    title: str = Field(default="", max_length=80)
+    text: str = Field(min_length=20, max_length=6000)
+    type: Literal["Проблема", "Предложение", "Положительный отзыв"]
+    category: str
+    target_department: str
+    solution: str = Field(default="", max_length=6000)
+    effect: str = Field(default="", max_length=6000)
+    priority: Literal["Низкий", "Средний", "Высокий"] = "Средний"
+    frequency: Literal["ежедневно", "еженедельно", "ежемесячно", "разово"] = "еженедельно"
+    minutes: int = Field(default=30, ge=1, le=1440)
+    attachments: list[str] = Field(default_factory=list, max_length=20)
+    attachment_ids: list[str] = Field(default_factory=list, max_length=20)
+
+
+class StatusChange(Input):
+    status: str
+    text: str = Field(default="", max_length=6000)
+
+
+class TextInput(Input):
+    text: str = Field(min_length=1, max_length=6000)
+
+
+class JoinInput(Input):
+    context: str = Field(min_length=10, max_length=6000)
+    frequency: Literal["ежедневно", "еженедельно", "ежемесячно", "разово"]
+    minutes: int = Field(ge=1, le=1440)
+
+
+class ReassignInput(Input):
+    assignee_id: str
+    reason: str = Field(min_length=10, max_length=6000)
+
+
+class ConfirmInput(Input):
+    solved: bool
+    reason: str = Field(default="", max_length=6000)
+
+
+class RuleInput(Input):
+    id: str
+    category: str
+    department: str
+    primary_id: str
+    backup_id: str
+    response_days: int = Field(ge=1, le=60)
+    resolution_days: int = Field(ge=1, le=120)
+
+
+class VacationInput(Input):
+    vacation: bool
+
+
+class SimilarInput(Input):
+    text: str = Field(max_length=6000)
+    category: str = ""
+    target_department: str = ""
diff --git a/backend/app/seed.py b/backend/app/seed.py
new file mode 100644
index 0000000000000000000000000000000000000000..1f99fa48e415aeb435bbd1c39cbd68d8c9fdcf0b
--- /dev/null
+++ b/backend/app/seed.py
@@ -0,0 +1,112 @@
+import argparse
+import json
+from datetime import datetime, timedelta, timezone
+
+from sqlalchemy import delete, select
+from sqlalchemy.orm import Session
+
+from . import models as m
+from .config import settings
+from .db import Base, SessionLocal, now
+from .domain.calendar import calendar
+from .services import cost
+
+
+def load_seed(db: Session, reset: bool = False) -> int:
+    if db.scalar(select(m.User.id).limit(1)) and not reset:
+        return 0
+    if reset:
+        for table in reversed(Base.metadata.sorted_tables):
+            db.execute(delete(table))
+        db.flush()
+        db.expunge_all()
+    data = json.loads(settings().seed_path.read_text(encoding="utf-8"))
+    cal = calendar()
+    anchor = cal.local(now())
+    if anchor.hour < 17:
+        anchor -= timedelta(days=1)
+    while not cal.is_workday(anchor.date()):
+        anchor -= timedelta(days=1)
+    anchor = anchor.replace(hour=17, minute=0, second=0, microsecond=0)
+    anchor = anchor.astimezone(timezone.utc).replace(tzinfo=None)
+
+    def date(value):
+        return anchor + timedelta(days=value["offsetDays"]) if value else None
+
+    departments = {d["name"]: d["id"] for d in data["departments"]}
+    categories = {c["name"]: c["id"] for c in data["categories"]}
+    for row in data["departments"]:
+        db.add(m.Department(id=row["id"], name=row["name"], head_id=row["headId"]))
+    for row in data["categories"]:
+        db.add(m.Category(**row))
+    db.flush()
+    for row in data["users"]:
+        db.add(m.User(id=row["id"], name=row["name"], role=row["role"],
+                      department_id=departments[row["department"]], vacation=row["vacation"],
+                      is_department_head=row["isDepartmentHead"],
+                      can_view_company_analytics=row["canViewCompanyAnalytics"]))
+    db.flush()
+    for row in data["users"]:
+        db.get(m.User, row["id"]).supervisor_id = row.get("supervisorId")
+    for row in data["rules"]:
+        cat, dep = categories.get(row["category"]), departments.get(row["department"])
+        db.add(m.RoutingRule(id=row["id"], category_id=cat, department_id=dep,
+                             scope_key=f"{cat or '*'}:{dep or '*'}", primary_id=row["primaryId"],
+                             backup_id=row["backupId"], response_days=row["responseDays"],
+                             resolution_days=row["resolutionDays"]))
+    for row in data["clusters"]:
+        db.add(m.Cluster(id=row["id"], title=row["title"], keywords=json.dumps(row["keywords"], ensure_ascii=False)))
+    db.flush()
+    names = {row["name"]: row["id"] for row in data["users"]}
+    rules = {row["category"]: row for row in data["rules"]}
+    for row in data["tickets"]:
+        created = date(row["createdAt"])
+        first = date(row.get("firstResponseAt"))
+        rule = rules[row["category"]]
+        ticket = m.Ticket(
+            id=row["id"], title=row["title"], text=row["text"], type=row["type"],
+            category_id=categories[row["category"]], original_category=row["originalCategory"],
+            author_id=row["authorId"], author_department_id=departments[row["authorDepartment"]],
+            target_department_id=departments[row["targetDepartment"]], assignee_id=row["assigneeId"],
+            priority=row["priority"], status=row["status"], created_at=created,
+            response_due_at=cal.add_days(created, rule["responseDays"]),
+            due_at=date(row["dueAt"]) if row["status"] == "Возвращено автором" else cal.add_days(created, rule["resolutionDays"]),
+            first_response_at=first, first_response_hours=cal.hours_between(created, first) if first else None,
+            implemented_at=date(row.get("implementedAt")), closed_at=date(row.get("closedAt")),
+            confirmed=row["confirmed"], default_confirmed=False, escalated=False,
+            frequency=row["frequency"], minutes=row["minutes"], solution=row["solution"],
+            effect=row["effect"], changed=row["changed"], rejection=row["rejection"],
+            monthly_cost=(cost(row["frequency"], row["minutes"]) + sum(cost(p["frequency"], p["minutes"])
+                          for p in row["participants"])) if row["type"] == "Проблема" else 0,
+        )
+        db.add(ticket)
+        db.flush()
+        for participant in row["participants"]:
+            db.add(m.Participant(ticket_id=ticket.id, user_id=participant["userId"],
+                                  department_id=departments[participant["department"]],
+                                  context=participant["context"], frequency=participant["frequency"],
+                                  minutes=participant["minutes"]))
+        for comment in row["comments"]:
+            db.add(m.Comment(id=comment["id"], ticket_id=ticket.id,
+                              author_id=names[comment["author"]], date=date(comment["date"]), text=comment["text"]))
+        old_status = None
+        for event in row["events"]:
+            status = event.get("status")
+            db.add(m.TicketEvent(id=event["id"], ticket_id=ticket.id, actor_id=names.get(event["actor"]),
+                                 date=date(event["date"]), text=event["text"], field="status" if status else None,
+                                 old_value=old_status if status else None, new_value=status))
+            old_status = status or old_status
+        if row["clusterId"]:
+            db.add(m.TicketCluster(ticket_id=ticket.id, cluster_id=row["clusterId"]))
+    db.flush()
+    return len(data["tickets"])
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description="Загрузка единого демо-набора Сигнала")
+    parser.add_argument("--reset", action="store_true")
+    args = parser.parse_args()
+    with SessionLocal() as db:
+        count = load_seed(db, args.reset)
+        db.commit()
+    print(f"Загружено обращений: {count}")
diff --git a/backend/app/services.py b/backend/app/services.py
new file mode 100644
index 0000000000000000000000000000000000000000..7a996df3c8b72fc7b661b879943f1f1a5a9bd555
--- /dev/null
+++ b/backend/app/services.py
@@ -0,0 +1,169 @@
+from datetime import datetime
+from uuid import uuid4
+
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from . import models as m
+from .db import now
+from .domain.calendar import calendar
+from .domain.errors import DomainError
+from .domain.routing import choose_assignment
+from .domain.permissions import can_manage, require_ticket
+from .domain.workflow import validate_transition, TERMINAL, DONE, CLOSED, RETURNED, CLARIFY, REVIEW
+from .notifier import LogNotifier
+from .schemas import TicketDraft
+
+
+def lookup(db: Session, model, name: str):
+    item = db.scalar(select(model).where(model.name == name))
+    if not item:
+        raise DomainError("Выберите существующую категорию или подразделение", 422)
+    return item
+
+
+def cost(frequency: str, minutes: int) -> float:
+    return {"ежедневно": 22, "еженедельно": 4, "ежемесячно": 1, "разово": 0}[frequency] * minutes / 60
+
+
+def audit(db: Session, ticket: m.Ticket, actor: m.User | None, text: str,
+          field: str | None = None, old: str | None = None, new: str | None = None,
+          at: datetime | None = None):
+    item = m.TicketEvent(ticket_id=ticket.id, actor_id=actor.id if actor else None,
+                         text=text, field=field, old_value=old, new_value=new, date=at or now())
+    db.add(item)
+    if actor and actor.role == "Руководитель" and not ticket.first_response_at:
+        ticket.first_response_at = now()
+        ticket.first_response_hours = calendar().hours_between(ticket.created_at, ticket.first_response_at)
+
+
+def notify(db: Session, user_id: str | None, ticket: m.Ticket, text: str, dedup: str | None = None):
+    if not user_id:
+        return
+    if dedup and db.scalar(select(m.Notification.id).where(m.Notification.dedup_key == dedup)):
+        return
+    db.add(m.Notification(user_id=user_id, ticket_id=ticket.id, text=text, dedup_key=dedup))
+    LogNotifier().send(user_id, text)
+
+
+def assignment(db: Session, category_name: str, department_name: str):
+    category = lookup(db, m.Category, category_name)
+    department = lookup(db, m.Department, department_name)
+    users = db.scalars(select(m.User)).all()
+    direction = next((u for u in users if u.can_view_company_analytics), None)
+    if not direction:
+        raise DomainError("Не настроен руководитель направления", 503)
+    selected = choose_assignment(category.id, department.id, db.scalars(select(m.RoutingRule)).all(),
+                                 users, department.head_id, direction.id)
+    return selected, category, department
+
+
+def route_preview(db: Session, category: str, department: str):
+    from .presenters import user_view, iso
+    selected, _, _ = assignment(db, category, department)
+    rule = selected.rule
+    response, resolution = (rule.response_days, rule.resolution_days) if rule else (2, 10)
+    primary = db.get(m.User, rule.primary_id) if rule else selected.user
+    return {"assignee": user_view(selected.user), "primary": user_view(primary),
+            "fallback": selected.fallback, "reason": selected.reason,
+            "responseDays": response, "resolutionDays": resolution,
+            "responseDueAt": iso(calendar().add_days(now(), response)),
+            "dueAt": iso(calendar().add_days(now(), resolution))}
+
+
+def make_title(text: str, title: str = "") -> str:
+    import re
+    if title.strip():
+        return title.strip()
+    sentence = re.split(r"[.!?\n]", text.strip())[0]
+    if len(sentence) <= 80:
+        return sentence
+    words = []
+    for word in sentence.split():
+        if len(" ".join([*words, word])) > 79:
+            break
+        words.append(word)
+    return (" ".join(words) or "Обращение") + "…"
+
+
+def create_ticket(db: Session, user: m.User, draft: TicketDraft) -> m.Ticket:
+    if user.role != "Сотрудник":
+        raise DomainError("Создавать обращения может сотрудник", 403)
+    selected, category, department = assignment(db, draft.category, draft.target_department)
+    rule = selected.rule
+    created = now()
+    ticket = m.Ticket(id="N-" + uuid4().hex[:10].upper(), title=make_title(draft.text, draft.title),
+                      text=draft.text.strip(), type=draft.type, category_id=category.id,
+                      original_category=draft.category, author_id=user.id,
+                      author_department_id=user.department_id, target_department_id=department.id,
+                      assignee_id=selected.user.id, priority=draft.priority, status="Новое",
+                      created_at=created, response_due_at=calendar().add_days(created, rule.response_days if rule else 2),
+                      due_at=calendar().add_days(created, rule.resolution_days if rule else 10),
+                      frequency=draft.frequency, minutes=draft.minutes, solution=draft.solution,
+                      effect=draft.effect, monthly_cost=cost(draft.frequency, draft.minutes) if draft.type == "Проблема" else 0)
+    db.add(ticket)
+    db.flush()
+    for attachment_id in set(draft.attachment_ids):
+        item = db.get(m.Attachment, attachment_id)
+        if not item or item.uploader_id != user.id or item.ticket_id:
+            raise DomainError("Вложение недоступно или уже прикреплено", 403)
+        item.ticket_id = ticket.id
+    audit(db, ticket, user, selected.reason, "assignee", None, selected.user.id)
+    audit(db, ticket, user, "Обращение зарегистрировано", "status", None, "Новое")
+    from .ai.provider import RuleBasedProvider
+    cluster_id = RuleBasedProvider().detect_cluster(db, draft.text)
+    if cluster_id:
+        db.add(m.TicketCluster(ticket_id=ticket.id, cluster_id=cluster_id))
+    notify(db, selected.user.id, ticket, f"Новое обращение {ticket.id}: {ticket.title}")
+    return ticket
+
+
+def change_status(db: Session, user: m.User, ticket_id: str, status: str, text: str):
+    ticket = require_ticket(db, user, ticket_id, manage=True)
+    validate_transition(ticket.status, status, "manager", text)
+    old = ticket.status
+    ticket.status = status
+    if status == DONE:
+        ticket.changed, ticket.implemented_at = text.strip(), now()
+        ticket.confirmed, ticket.default_confirmed = False, False
+    if status == "Отклонено":
+        ticket.rejection, ticket.closed_at = text.strip(), now()
+    audit(db, ticket, user, f"Статус: {status}. {text.strip()}", "status", old, status)
+    if text.strip():
+        db.add(m.Comment(ticket_id=ticket.id, author_id=user.id, text=text.strip()))
+    notify(db, ticket.author_id, ticket, f"{ticket.id}: {status}. {text.strip()}")
+    return ticket
+
+
+def add_comment(db: Session, user: m.User, ticket_id: str, text: str):
+    ticket = require_ticket(db, user, ticket_id)
+    if not text.strip():
+        raise DomainError("Введите комментарий", 422)
+    db.add(m.Comment(ticket_id=ticket.id, author_id=user.id, text=text.strip()))
+    if ticket.status == CLARIFY and ticket.author_id == user.id:
+        validate_transition(CLARIFY, REVIEW, "author", text)
+        ticket.status = REVIEW
+        audit(db, ticket, user, "Автор ответил на запрос уточнения", "status", CLARIFY, REVIEW)
+    else:
+        audit(db, ticket, user, "Добавлен комментарий")
+    recipient = ticket.author_id if can_manage(user, ticket) else ticket.assignee_id
+    notify(db, recipient, ticket, f"{ticket.id}: новый комментарий")
+    return ticket
+
+
+def confirm(db: Session, user: m.User, ticket_id: str, solved: bool, reason: str):
+    ticket = require_ticket(db, user, ticket_id)
+    if ticket.author_id != user.id:
+        raise DomainError("Подтвердить результат может только автор", 403)
+    new = CLOSED if solved else RETURNED
+    validate_transition(ticket.status, new, "author", reason)
+    ticket.status, ticket.confirmed, ticket.default_confirmed = new, solved, False
+    ticket.closed_at = now() if solved else None
+    if not solved:
+        ticket.due_at = calendar().add_days(now(), 5)
+        ticket.escalated = False
+        db.add(m.Comment(ticket_id=ticket.id, author_id=user.id, text=reason.strip()))
+    audit(db, ticket, user, "Автор подтвердил решение" if solved else f"Автор вернул: {reason}",
+          "status", DONE, new)
+    notify(db, ticket.assignee_id, ticket, f"{ticket.id}: {new}")
+    return ticket
diff --git a/backend/app/sla.py b/backend/app/sla.py
new file mode 100644
index 0000000000000000000000000000000000000000..c89f4bdb15fe6efe6eeb3996fd86bd2cf9cc3c0f
--- /dev/null
+++ b/backend/app/sla.py
@@ -0,0 +1,70 @@
+import asyncio
+import logging
+import threading
+
+from sqlalchemy import select
+from . import models as m
+from .db import SessionLocal, now
+from .domain.calendar import calendar
+from .domain.workflow import validate_transition, DONE, CLOSED, TERMINAL
+from .services import audit, notify
+
+lock = threading.Lock()
+
+
+def run_check() -> dict:
+    if not lock.acquire(blocking=False):
+        return {"processed": 0, "message": "Проверка уже выполняется"}
+    processed = 0
+    try:
+        with SessionLocal() as db:
+            cal, timestamp = calendar(), now()
+            tickets = db.scalars(select(m.Ticket).where(m.Ticket.status.not_in(["Закрыто", "Отклонено"]))).all()
+            direction = db.scalar(select(m.User).where(m.User.can_view_company_analytics.is_(True)))
+            for ticket in tickets:
+                cycle = f"{ticket.id}:{ticket.due_at.isoformat()}"
+                if ticket.status == DONE:
+                    if ticket.implemented_at and timestamp >= cal.add_days(ticket.implemented_at, 5):
+                        validate_transition(DONE, CLOSED, "system")
+                        ticket.status, ticket.closed_at = CLOSED, timestamp
+                        ticket.default_confirmed, ticket.confirmed = True, False
+                        audit(db, ticket, None, "Подтверждено по умолчанию: автор не ответил за 5 рабочих дней",
+                              "status", DONE, CLOSED)
+                        notify(db, ticket.author_id, ticket, f"{ticket.id}: закрыто, подтверждено по умолчанию")
+                        processed += 1
+                    continue
+                if ticket.status in TERMINAL:
+                    continue
+                for label, due in [("response", ticket.response_due_at), ("resolution", ticket.due_at)]:
+                    if label == "response" and ticket.first_response_at:
+                        continue
+                    if cal.add_days(due, -1) <= timestamp < due:
+                        notify(db, ticket.assignee_id, ticket, f"{ticket.id}: до срока {'ответа' if label == 'response' else 'решения'} один рабочий день",
+                               f"reminder:{label}:{cycle}:{due.isoformat()}")
+                if not ticket.first_response_at and timestamp > ticket.response_due_at:
+                    dedup = f"response-overdue:{ticket.id}:{ticket.response_due_at.isoformat()}"
+                    if not db.scalar(select(m.Notification.id).where(m.Notification.dedup_key == dedup)):
+                        head = db.get(m.Department, ticket.assignee.department_id).head_id
+                        notify(db, head or direction.id, ticket, f"{ticket.id}: просрочен первый ответ", dedup)
+                        audit(db, ticket, None, "Просрочен первый ответ. Руководитель подразделения уведомлён")
+                        processed += 1
+                if timestamp > cal.add_days(ticket.due_at, 3) and not ticket.escalated:
+                    ticket.escalated = True
+                    audit(db, ticket, None, "Эскалировано руководителю направления: решение просрочено более чем на 3 рабочих дня",
+                          "escalated", "false", "true")
+                    notify(db, direction.id if direction else ticket.assignee_id, ticket,
+                           f"{ticket.id}: эскалация просроченного решения", f"escalation:{cycle}")
+                    processed += 1
+            db.commit()
+        return {"processed": processed, "message": "Проверка SLA завершена"}
+    finally:
+        lock.release()
+
+
+async def scheduler(interval: int):
+    while True:
+        await asyncio.sleep(max(5, interval))
+        try:
+            await asyncio.to_thread(run_check)
+        except Exception:
+            logging.getLogger("signal.sla").exception("Ошибка фоновой проверки SLA")
diff --git a/backend/app/storage.py b/backend/app/storage.py
new file mode 100644
index 0000000000000000000000000000000000000000..23b10cbd493b6e2b1b9cc320b3419aac38cb6081
--- /dev/null
+++ b/backend/app/storage.py
@@ -0,0 +1,60 @@
+from pathlib import Path
+from typing import Protocol, BinaryIO
+from uuid import uuid4
+
+from fastapi import UploadFile
+from .config import settings
+from .domain.errors import DomainError
+
+MAX_BYTES = 10 * 1024 * 1024
+EXTENSIONS = {".pdf", ".png", ".jpg", ".docx", ".xlsx", ".txt"}
+
+
+class Storage(Protocol):
+    async def save(self, file: UploadFile) -> tuple[str, int]: ...
+    def open(self, key: str) -> BinaryIO: ...
+
+
+class LocalStorage:
+    def __init__(self, directory: Path | None = None):
+        self.directory = (directory or settings().storage_directory).resolve()
+        self.directory.mkdir(parents=True, exist_ok=True)
+
+    def path(self, key: str) -> Path:
+        target = (self.directory / key).resolve()
+        if target.parent != self.directory:
+            raise DomainError("Недопустимый путь вложения", 403)
+        return target
+
+    def open(self, key: str) -> BinaryIO:
+        try:
+            return self.path(key).open("rb")
+        except FileNotFoundError:
+            raise DomainError("Файл отсутствует в хранилище", 404) from None
+
+    async def save(self, file: UploadFile) -> tuple[str, int]:
+        extension = Path(file.filename or "").suffix.lower()
+        if extension not in EXTENSIONS:
+            raise DomainError("Допустимы только pdf, png, jpg, docx, xlsx, txt", 422)
+        key = uuid4().hex + extension
+        target = self.path(key)
+        size = 0
+        try:
+            with target.open("xb") as output:
+                while chunk := await file.read(64 * 1024):
+                    size += len(chunk)
+                    if size > MAX_BYTES:
+                        raise DomainError("Размер файла превышает 10 МБ", 422)
+                    output.write(chunk)
+            if not size:
+                raise DomainError("Файл пуст", 422)
+        except Exception:
+            target.unlink(missing_ok=True)
+            raise
+        finally:
+            await file.close()
+        return key, size
+
+
+def storage() -> Storage:
+    return LocalStorage()
diff --git a/backend/migrations/env.py b/backend/migrations/env.py
new file mode 100644
index 0000000000000000000000000000000000000000..957ff1bd38d924f8317ba253509821034a8805c7
--- /dev/null
+++ b/backend/migrations/env.py
@@ -0,0 +1,19 @@
+from alembic import context
+from sqlalchemy import create_engine, pool
+from app.config import settings
+from app.db import Base
+from app import models
+
+target_metadata = Base.metadata
+
+if context.is_offline_mode():
+    context.configure(url=settings().database_url, target_metadata=target_metadata,
+                      literal_binds=True, dialect_opts={"paramstyle": "named"})
+    with context.begin_transaction():
+        context.run_migrations()
+else:
+    engine = create_engine(settings().database_url, poolclass=pool.NullPool)
+    with engine.connect() as connection:
+        context.configure(connection=connection, target_metadata=target_metadata, compare_type=True)
+        with context.begin_transaction():
+            context.run_migrations()
