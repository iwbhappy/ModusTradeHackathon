-  return [];
+export function detectCluster(text: string): string {
+  const ranked = seed.clusters.map((cluster) => ({
+    id: cluster.id, score: cluster.keywords.filter((word) => text.toLowerCase().includes(word)).length,
+  })).sort((a, b) => b.score - a.score);
+  return ranked[0]?.score ? ranked[0].id : '';
 }
