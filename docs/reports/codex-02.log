-// src/lib/format.ts
-function businessDays(from, days) {
-  const d = new Date(from);
-  let count = 0;
-  while (count < days) {
-    d.setDate(d.getDate() + 1);
-    if (![0, 6].includes(d.getDay())) count++;
-  }
-  return d.toISOString();
-}
