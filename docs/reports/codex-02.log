-function workdaysAgo(anchor, count, hour = START) {
-  const result = new Date(anchor);
-  let remaining = count;
-  while (remaining > 0) {
-    result.setDate(result.getDate() - 1);
-    if (isWorkday(result)) remaining--;
-  }
-  result.setHours(hour, 0, 0, 0);
-  return result.toISOString();
-}
