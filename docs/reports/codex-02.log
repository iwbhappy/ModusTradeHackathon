-    resolvedDaysAgo: 7,
-    changed: "\u0414\u043B\u044F \u043A\u0430\u0431\u0435\u043B\u044C\u043D\u043E\u0439 \u043F\u0440\u043E\u0434\u0443\u043A\u0446\u0438\u0438 \u0432\u0432\u0435\u0434\u0435\u043D\u044B \u043F\u043E\u043B\u044F \xAB\u0443\u0447\u0430\u0441\u0442\u043E\u043A \u043F\u0440\u043E\u043A\u043B\u0430\u0434\u043A\u0438\xBB, \xAB\u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435\xBB \u0438 \xAB\u0441\u0442\u0440\u043E\u043A\u0430 \u0441\u043F\u0435\u0446\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438 \u041E\u041F\u0421\xBB. \u0417\u0430\u043A\u0443\u043F\u0449\u0438\u043A \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u043E\u0434\u043D\u0438\u043C \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435\u043C, \u0431\u0435\u0437 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0439 \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u043A\u0438 \u0441 \u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u043E\u043C.",
-    comments: [
-      "\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u0440\u0438\u043C\u0435\u0440 \u0437\u0430\u044F\u0432\u043A\u0438 \u0431\u0435\u0437 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u043E\u0431\u044A\u0435\u043A\u0442\u0430.",
