-      ? (hours[Math.floor((hours.length - 1) / 2)] + hours[Math.floor(hours.length / 2)]) / 2
-      : 0,
-    averageHours: hours.length ? hours.reduce((a, b) => a + b, 0) / hours.length : 0,
-    resultRate: percent(
-      tickets.filter((t) => terminal(t) && (!!t.changed || !!t.rejection)).length,
