import { useState } from 'react';
import { Link, useSearchParams } from 'react-router-dom';
import { ArrowRight, ShieldCheck, Users } from 'lucide-react';
import { setVacation } from '../api';
import { useApp } from '../store';

import { ErrorMessage, PageTitle, Panel } from '../components/ui';
export function UsersPage() {
  const [params] = useSearchParams();
  const { catalog, userId, refresh, notify } = useApp();
  const [department, setDepartment] = useState('');
  const [role, setRole] = useState('');
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');
  if (!catalog) return null;
  const search = params.get('search')?.toLowerCase() || '';
  const filtered = catalog.users.filter(
    (u) =>
      (!department || department === u.department) &&
      (!role || role === u.role) &&
      (!search || `${u.name} ${u.department} ${u.role} ${u.id}`.toLowerCase().includes(search)),
  );
  return (
    <>
      <PageTitle
        title="Пользователи и роли"
        subtitle="Демонстрационные пользователи обозначены ролями и подразделениями"
      />
      <Panel title="Матрица доступа" aside={<ShieldCheck size={17} />}>
        <div className="access-grid">
          {[
            [
              'Сотрудник',
              'Свои обращения и те, к которым присоединился. Подача, комментарии и подтверждение своего результата.',
            ],
            [
              'Ответственный',
              'Личные назначения и обращения подразделения ответственного. Статусы, уточнения, решения и переназначение.',
            ],
            [
              'Руководитель',
              'Очередь своего подразделения и сводная аналитика компании. В демо объединён с ответственным в одну роль.',
            ],
            [
              'Администратор',
              'Настройки категорий, маршрутов, сроков и пользователей. Доступ к содержимому обращений не предоставляется.',
            ],
          ].map(([name, description]) => (
            <div key={name}>
              <h3>{name}</h3>
              <p>{description}</p>
            </div>
          ))}
        </div>
        <div className="table-footer">
          <span>
            Всем ролям доступны итоговые улучшения в «Сделано»; похожие обращения показываются
            сотруднику при подаче.
          </span>
        </div>
      </Panel>
      <Panel title="Пользователи" aside={<Users size={17} />}>
        <div className="filters">
          <select
            aria-label="Фильтр пользователей по подразделению"
            value={department}
            onChange={(e) => setDepartment(e.target.value)}
          >
            <option value="">Все подразделения</option>
            {catalog.departments.map((d) => (
              <option key={d}>{d}</option>
            ))}
          </select>
          <select
            aria-label="Фильтр пользователей по роли"
            value={role}
            onChange={(e) => setRole(e.target.value)}
          >
            <option value="">Все роли</option>
            {['Сотрудник', 'Руководитель', 'Администратор'].map((r) => (
              <option key={r}>{r}</option>
            ))}
          </select>
          <span className="quiet-label">Показано {filtered.length}</span>
        </div>
        <ErrorMessage text={error} />
        <div className="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Пользователь</th>
                <th>Подразделение</th>
                <th>Роль</th>
                <th>Доступность</th>
              </tr>
            </thead>
            <tbody>
              {filtered.map((u) => (
                <tr key={u.id}>
                  <td>
                    next(
                        (label for _, root, label in ROOTS if root == term),
                        next((w for w in words(text) if stem(w) == term), term),
                    )
                )
            scored.append(
                {
                    "id": ticket["id"],
                    "score": score,
                    "matchExplanation": "Совпадение: " + ", ".join(explanations),
                }
            )
        return sorted(scored, key=lambda t: (-t["score"], t["id"]))[:4]

    def detect_cluster(self, db: Session, text: str) -> str:
        clusters = db.scalars(select(Cluster)).all()
        scores = [
            (sum(word in text.lower() for word in json.loads(c.keywords)), c.id)
            for c in clusters
        ]
        return max(scores)[1] if scores and max(scores)[0] else ""

    def structure(
        self, text: str, category: str, department: str, candidates: list[dict]
    ) -> dict:
        from ..config import settings

        seed = json.loads(settings().seed_path.read_text(encoding="utf-8"))
        scored = [
            (sum(w in text.lower() for w in c["keywords"]), c["id"])
            for c in seed["clusters"]
        ]
        cluster = max(scored)[1] if scored else ""
        categories = {
            "purchase": "Заявки и взаимодействие",
            "catalog": "Каталог и спецификации",
            "documents": "Документы и согласования",
            "decisions": "Процессы и коммуникации",
            "systems": "IT и обмен данными",
            "knowledge": "Обучение и ПНР",
        }
        sentences = re.split(r"(?<=[.!?])\s+", text.strip())
        solutions = [
            s for s in sentences if re.search("предлага|нужн|можно|хотелось", s, re.I)
        ]
        return {
            "title": make_title(text),
            "problem": " ".join(s for s in sentences if s not in solutions)
            or sentences[0],
            "solution": " ".join(solutions)
            or "Согласовать порядок работы и назначить владельца процесса.",
            "effect": "Сократить уточнения и время передачи работы между подразделениями.",
            "category": categories.get(cluster, category or "Корпоративная среда"),
            "priority": "Высокий"
            if re.search("сроч|срыв|теря|ошиб|повторн", text, re.I)
            else "Средний",
        }

    def draft(
        self,
        text: str,
        category: str,
        department: str,
        candidates: list[dict],
        status: str,
    ) -> str:
        if status == "Ожидает уточнения":
            return f"Спасибо за обращение «{text}». Уточните этап, частоту повторения и приложите обезличенный пример."
        if status == "Отклонено":
            return "Спасибо за предложение. Сейчас реализация ограничена доступными ресурсами. Уточним условия повторного рассмотрения."
        if status == "Реализовано":
            return f"По обращению «{text}» согласован порядок работы и назначен владелец процесса. Опишите конкретный результат и проверьте его с автором."
        return f"Обращение «{text}» принято в работу. Проверим ситуацию и зафиксируем результат в карточке."


