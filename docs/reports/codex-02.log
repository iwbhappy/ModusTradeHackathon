+server {
+    listen 80;
+    server_tokens off;
+    root /usr/share/nginx/html;
+    client_max_body_size 11m;
+
+    location /api/ {
+        proxy_pass http://backend:8000;
+        proxy_set_header Host $host;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+    }
+    location /docs {
+        proxy_pass http://backend:8000;
+    }
+    location = /openapi.json {
+        proxy_pass http://backend:8000;
+    }
+    location / {
+        try_files $uri $uri/ /index.html;
+    }
+}
diff --git a/frontend/src/api/http/client.ts b/frontend/src/api/http/client.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0a09df5a01dd774d2809e915d3e8ed88f1b49fcd
--- /dev/null
+++ b/frontend/src/api/http/client.ts
@@ -0,0 +1,60 @@
+import type { User } from '../../types';
+
+let session: { userId: string; token: string } | null = null;
+const tokens = new Map<string, string>();
+
+async function error(response: Response): Promise<never> {
+  const data = await response.json().catch(() => null);
+  throw new Error(typeof data?.detail === 'string'
+    ? data.detail : `Не удалось выполнить запрос (${response.status}). Повторите действие.`);
+}
+
+export async function demoLogin(userId: string): Promise<User> {
+  let response: Response;
+  try {
+    response = await fetch('/api/auth/demo-login', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ userId }),
+    });
+  } catch { throw new Error('Сервер недоступен. Проверьте запуск API на порту 8000.'); }
+  if (!response.ok) return error(response);
+  const data = await response.json() as { token: string; user: User };
+  session = { userId, token: data.token };
+  tokens.set(userId, data.token);
+  return data.user;
+}
+
+export async function request<T>(path: string, init: RequestInit = {}, userId?: string): Promise<T> {
+  const selected = userId || session?.userId || localStorage.getItem('signal-user') || 'employee-1';
+  if (!tokens.has(selected)) await demoLogin(selected);
+  const token = tokens.get(selected)!;
+  let response: Response;
+  try {
+    response = await fetch(`/api${path}`, {
+      ...init, headers: { ...(init.body instanceof FormData ? {} : { 'Content-Type': 'application/json' }),
+        Authorization: `Bearer ${token}`, ...init.headers },
+    });
+  } catch { throw new Error('Сервер недоступен. Не удалось сохранить изменения.'); }
+  if (!response.ok) {
+    if (response.status === 401) tokens.delete(selected);
+    return error(response);
+  }
+  if (init.headers && 'Accept' in init.headers && init.headers.Accept === 'application/octet-stream') {
+    return await response.blob() as T;
+  }
+  return await response.json() as T;
+}
+
+export function query(values: object): string {
+  return new URLSearchParams(Object.entries(values)
+    .filter(([, value]) => value !== undefined && value !== '')
+    .map(([key, value]) => [key, String(value)])).toString();
+}
+
+export function saveBlob(blob: Blob, name: string) {
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = name;
+  link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
diff --git a/frontend/src/api/http/index.ts b/frontend/src/api/http/index.ts
new file mode 100644
index 0000000000000000000000000000000000000000..16505cbb73c7b9cdd6febf2ea14b73b9771d3cbc
--- /dev/null
+++ b/frontend/src/api/http/index.ts
@@ -0,0 +1,62 @@
+import type {
+  Analytics, AnalyticsFilters, AppNotification, AttachmentInfo, Catalog, Frequency,
+  RoutePreview, Rule, SimilarityContext, SimilarTicket, Status, Structure, Ticket, TicketDraft, TicketFilters,
+} from '../../types';
+import { request, query, saveBlob } from './client';
+export { demoLogin } from './client';
+
+const post = <T>(path: string, body: object, userId?: string) =>
+  request<T>(path, { method: 'POST', body: JSON.stringify(body) }, userId);
+
+export const getCatalog = () => request<Catalog>('/catalog');
+export const resetDemo = () => post<void>('/admin/reset-demo', {});
+export const listTickets = (userId: string, filters: TicketFilters = {}) =>
+  request<Ticket[]>(`/tickets?${query(filters)}&limit=500`, {}, userId);
+export const getTicket = (id: string, userId: string) => request<Ticket>(`/tickets/${id}`, {}, userId);
+export const createTicket = (draft: TicketDraft, userId: string) => post<Ticket>('/tickets', draft, userId);
+export const updateStatus = (id: string, status: Status, text: string, userId: string) =>
+  post<Ticket>(`/tickets/${id}/status`, { status, text }, userId);
+export const addComment = (id: string, text: string, userId: string) =>
+  post<Ticket>(`/tickets/${id}/comments`, { text }, userId);
+export const reassign = (id: string, assigneeId: string, reason: string, userId: string) =>
+  post<Ticket>(`/tickets/${id}/reassign`, { assigneeId, reason }, userId);
+export const confirmResolution = (id: string, solved: boolean, reason: string, userId: string) =>
+  post<Ticket>(`/tickets/${id}/confirm`, { solved, reason }, userId);
+export const joinTicket = (id: string, context: string, frequency: Frequency, minutes: number, userId: string) =>
+  post<Ticket>(`/tickets/${id}/join`, { context, frequency, minutes }, userId);
+export const getImprovements = () => request<Ticket[]>('/improvements');
+export const previewRouting = (category: string, targetDepartment: string) =>
+  request<RoutePreview>(`/routing/preview?${query({ category, targetDepartment })}`);
+export const saveRule = (rule: Rule, userId: string) =>
+  request<void>(`/admin/routing/${rule.id}`, { method: 'PUT', body: JSON.stringify(rule) }, userId);
+export const setVacation = (id: string, vacation: boolean, userId: string) =>
+  request<void>(`/admin/users/${id}/vacation`, { method: 'PUT', body: JSON.stringify({ vacation }) }, userId);
+export const findSimilar = (text: string, userId: string, context: SimilarityContext = {}) =>
+  post<SimilarTicket[]>('/ai/similar', { text, ...context }, userId);
+export const suggestStructure = (text: string) => post<Structure>('/ai/structure', { text });
+export const draftResponse = async (id: string, status: Status, userId: string) =>
+  (await post<{ text: string }>(`/tickets/${id}/draft-response`, { status }, userId)).text;
+export const getAnalytics = (days: number, userId: string) =>
+  request<Analytics>(`/analytics?${query({ days })}`, {}, userId);
+export const getAnalyticsTickets = (days: number, filters: AnalyticsFilters, userId: string) =>
+  request<Ticket[]>(`/analytics/tickets?${query({ days, ...filters })}&limit=500`, {}, userId);
+export const listNotifications = (userId: string) => request<AppNotification[]>('/notifications', {}, userId);
+export const readNotification = (id: string, userId: string) => post<void>(`/notifications/${id}/read`, {}, userId);
+export const runSlaCheck = (userId: string) => post<{ message: string; processed: number }>('/admin/run-sla-check', {}, userId);
+export async function uploadFiles(files: File[], userId: string): Promise<AttachmentInfo[]> {
+  const uploaded: AttachmentInfo[] = [];
+  for (const file of files) {
+    const body = new FormData();
+    body.append('file', file);
+    uploaded.push(await request<AttachmentInfo>('/attachments', { method: 'POST', body }, userId));
+  }
+  return uploaded;
+}
+export async function downloadAttachment(id: string, name: string, userId: string) {
+  saveBlob(await request<Blob>(`/attachments/${id}`, { headers: { Accept: 'application/octet-stream' } }, userId), name);
+}
+export async function exportAnalytics(days: number, userId: string) {
+  saveBlob(await request<Blob>(`/analytics/export.xlsx?days=${days}`, {
+    headers: { Accept: 'application/octet-stream' },
+  }, userId), 'signal-register.xlsx');
+}
