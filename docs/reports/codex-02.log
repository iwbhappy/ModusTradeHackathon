diff --git a/backend/app/domain/permissions.py b/backend/app/domain/permissions.py
new file mode 100644
index 0000000000000000000000000000000000000000..3a3b4411c0e3114538cf0b9723a245adc44ea816
--- /dev/null
+++ b/backend/app/domain/permissions.py
@@ -0,0 +1,51 @@
+from sqlalchemy import or_, select
+from sqlalchemy.orm import Session
+
+from ..models import Participant, Ticket, User
+from .errors import DomainError
+
+
+def can_manage(user: User, ticket: Ticket) -> bool:
+    return user.role == "Руководитель" and (
+        ticket.assignee_id == user.id
+        or (user.can_view_company_analytics and ticket.escalated)
+        or (user.is_department_head and ticket.assignee.department_id == user.department_id)
+    )
+
+
+def can_read(user: User, ticket: Ticket) -> bool:
+    if user.role == "Администратор":
+        return False
+    return can_manage(user, ticket) or (
+        user.role == "Сотрудник" and (
+            ticket.author_id == user.id or any(p.user_id == user.id for p in ticket.participants)
+        )
+    )
+
+
+def visible_clause(user: User):
+    if user.role == "Администратор":
+        return Ticket.id.is_(None)
+    if user.role == "Сотрудник":
+        return or_(Ticket.author_id == user.id, Ticket.id.in_(
+            select(Participant.ticket_id).where(Participant.user_id == user.id)))
+    if user.is_department_head:
+        return or_(Ticket.assignee_id == user.id, Ticket.assignee_id.in_(
+            select(User.id).where(User.department_id == user.department_id)),
+            Ticket.escalated.is_(True) if user.can_view_company_analytics else False)
+    return Ticket.assignee_id == user.id
+
+
+def analytics_clause(user: User):
+    if user.role != "Руководитель":
+        raise DomainError("Аналитика доступна руководителю", 403)
+    return True if user.can_view_company_analytics else visible_clause(user)
+
+
+def require_ticket(db: Session, user: User, ticket_id: str, manage: bool = False) -> Ticket:
+    ticket = db.get(Ticket, ticket_id)
+    if not ticket:
+        raise DomainError("Обращение не найдено", 404)
+    if not (can_manage(user, ticket) if manage else can_read(user, ticket)):
+        raise DomainError("Нет доступа к содержимому этого обращения", 403)
+    return ticket
diff --git a/backend/app/domain/routing.py b/backend/app/domain/routing.py
new file mode 100644
index 0000000000000000000000000000000000000000..8993f4ca2a59f06ece460ce9dab8d6de6effedb7
--- /dev/null
+++ b/backend/app/domain/routing.py
@@ -0,0 +1,33 @@
+from dataclasses import dataclass
+from collections.abc import Sequence
+from ..models import RoutingRule, User
+from .errors import DomainError
+
+
+@dataclass
+class Assignment:
+    user: User
+    rule: RoutingRule | None
+    fallback: bool
+    reason: str
+
+
+def choose_assignment(category_id: str, department_id: str, rules: Sequence[RoutingRule],
+                      users: Sequence[User], head_id: str | None, direction_id: str) -> Assignment:
+    rule = next((r for r in rules if r.category_id == category_id and r.department_id == department_id), None)
+    rule = rule or next((r for r in rules if r.category_id == category_id and r.department_id is None), None)
+    rule = rule or next((r for r in rules if r.category_id is None and r.department_id is None), None)
+    by_id = {u.id: u for u in users if u.role == "Руководитель"}
+    if rule:
+        primary, backup = by_id.get(rule.primary_id), by_id.get(rule.backup_id)
+        if primary and not primary.vacation:
+            return Assignment(primary, rule, False, "Назначено по правилу маршрутизации")
+        if backup and not backup.vacation:
+            return Assignment(backup, rule, True, "Основной ответственный в отпуске; назначен резервный")
+    head = by_id.get(head_id)
+    direction = by_id.get(direction_id)
+    fallback = head if head and not head.vacation else direction or head
+    fallback = fallback or next(iter(by_id.values()), None)
+    if not fallback:
+        raise DomainError("В оргструктуре отсутствует руководитель для назначения", 503)
+    return Assignment(fallback, rule, True, "Назначено по резервному правилу: руководителю")
diff --git a/backend/app/domain/workflow.py b/backend/app/domain/workflow.py
new file mode 100644
index 0000000000000000000000000000000000000000..87b2199b57cdb4b18cd8ad86e34d3b329981ba1f
--- /dev/null
+++ b/backend/app/domain/workflow.py
@@ -0,0 +1,37 @@
+from .errors import DomainError
+
+NEW = "Новое"
+REVIEW = "На рассмотрении"
+CLARIFY = "Ожидает уточнения"
+WORK = "В работе"
+DONE = "Реализовано"
+REJECT = "Отклонено"
+CLOSED = "Закрыто"
+RETURNED = "Возвращено автором"
+STATUSES = [NEW, REVIEW, CLARIFY, WORK, DONE, REJECT, CLOSED, RETURNED]
+TERMINAL = [DONE, REJECT, CLOSED]
+TRANSITIONS = {
+    NEW: {REVIEW, WORK, CLARIFY, REJECT},
+    REVIEW: {WORK, CLARIFY, REJECT, DONE},
+    CLARIFY: {REVIEW, WORK, REJECT},
+    WORK: {CLARIFY, DONE, REJECT},
+    RETURNED: {REVIEW, WORK, CLARIFY, REJECT},
+    DONE: {CLOSED, RETURNED},
+    REJECT: set(), CLOSED: set(),
+}
+
+
+def validate_transition(old: str, new: str, actor: str, text: str = "") -> None:
+    if new not in TRANSITIONS.get(old, set()):
+        raise DomainError(f"Переход «{old} → {new}» недопустим")
+    if old == DONE:
+        if actor not in {"author", "system"} or (actor == "system" and new != CLOSED):
+            raise DomainError("Только автор может подтвердить решение или вернуть его")
+    elif actor == "author" and old == CLARIFY and new == REVIEW:
+        pass
+    elif actor != "manager":
+        raise DomainError("Действие доступно ответственному")
+    if new in {CLARIFY, REJECT, DONE, RETURNED} and len(text.strip()) < 10:
+        labels = {CLARIFY: "текст запроса уточнения", REJECT: "мотивировку отказа",
+                  DONE: "что изменилось", RETURNED: "что осталось нерешённым"}
+        raise DomainError(f"Укажите {labels[new]}: минимум 10 символов")
