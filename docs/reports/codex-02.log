diff --git a/frontend/src/components/layout/Notifications.tsx b/frontend/src/components/layout/Notifications.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..12620bd3c35b1e6d7f6af81d714df297cf02b87b
--- /dev/null
+++ b/frontend/src/components/layout/Notifications.tsx
@@ -0,0 +1,44 @@
+import { useEffect, useState } from 'react';
+import { Bell } from 'lucide-react';
+import { useNavigate } from 'react-router-dom';
+import { listNotifications, readNotification } from '../../api';
+import type { AppNotification } from '../../types';
+import { useApp } from '../../store';
+import { date } from '../../lib/format';
+
+export function Notifications() {
+  const { userId, revision } = useApp();
+  const navigate = useNavigate();
+  const [items, setItems] = useState<AppNotification[]>([]);
+  const [open, setOpen] = useState(false);
+  const [error, setError] = useState('');
+  useEffect(() => {
+    let live = true;
+    const update = () => listNotifications(userId).then((rows) => {
+      if (live) { setItems(rows); setError(''); }
+    }).catch((error) => { if (live) setError(error.message); });
+    update();
+    const timer = setInterval(update, 15000);
+    return () => { live = false; clearInterval(timer); };
+  }, [userId, revision]);
+  const unread = items.filter((item) => !item.read).length;
+  return <div className="notifications">
+    <button className="icon-button" aria-label={`Уведомления, непрочитанных: ${unread}`}
+      aria-expanded={open} onClick={() => setOpen(!open)}><Bell size={18}/>
+      {unread > 0 && <span className="notification-count">{unread}</span>}
+    </button>
+    {open && <div className="notifications-list panel">
+      <div className="panel-heading"><h2>Уведомления</h2>
+        <button className="text-button" onClick={() => setOpen(false)}>Закрыть</button></div>
+      {error && <p className="panel-body error">{error}</p>}
+      {!items.length && !error && <p className="panel-body muted">Новых уведомлений нет</p>}
+      {items.map((item) => <button key={item.id} className={item.read ? '' : 'unread'} onClick={async () => {
+        try {
+          await readNotification(item.id, userId);
+          setItems((rows) => rows.map((row) => row.id === item.id ? { ...row, read: true } : row));
+          setOpen(false); navigate(`/tickets/${item.ticketId}`);
+        } catch (error) { setError((error as Error).message); }
+      }}><span>{item.text}</span><small>{date(item.date)}</small></button>)}
+    </div>}
+  </div>;
+}
