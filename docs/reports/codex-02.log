@@ -0,0 +1,176 @@
+import json
+import math
+import re
+from typing import Protocol
+
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from ..models import Cluster, Ticket
+from ..services import make_title
+
+
+class AIProvider(Protocol):
+    def similar(
+        self, text: str, category: str, department: str, candidates: list[dict]
+    ) -> list[dict]: ...
+    def structure(
+        self, text: str, category: str, department: str, candidates: list[dict]
+    ) -> dict: ...
+    def draft(
+        self,
+        text: str,
+        category: str,
+        department: str,
+        candidates: list[dict],
+        status: str,
+    ) -> str: ...
+
+
+STOP = set(
+    "а без бы был была были было быть в вам вас во все для до его ее если есть еще за и из или их к как когда кто мы на нам нас не нет ни но нужно нужна нужен о об от по под после при про раз с со так то только у уже что чтобы это этот я иногда часто несколько каждый можно предлагаю приходится".split()
+)
+ROOTS = [
+    (r"^заяв(?:к|ок)", "заявк", "заявка"),
+    (r"^назнач", "назначен", "назначение"),
+    (r"^парамет", "параметр", "параметры"),
+    (r"^закуп", "закупк", "закупка"),
+    (r"^уточн", "уточнен", "уточнение"),
+    (r"^проектиров", "проектировщик", "проектировщик"),
+    (r"^номенклат", "номенклатур", "номенклатура"),
+    (r"^обознач", "обозначен", "обозначение"),
+    (r"^спецификац", "спецификаци", "спецификация"),
+    (r"^согласован", "согласован", "согласование"),
+    (r"^документ", "документ", "документы"),
+    (r"^повторн", "повторн", "повторный"),
+]
+ENDING = re.compile(
+    r"(?:иями|ями|ами|ого|его|ому|ему|ыми|ими|ение|ения|ов|ев|ий|ый|ой|ая|яя|ое|ее|ые|ие|ую|юю|ах|ях|ом|ем|ам|ям|ы|и|а|я|у|ю|е|о)$"
+)
+
+
+def words(text: str) -> list[str]:
+    return [
+        w
+        for w in re.findall(r"[а-яa-z0-9]+", text.lower().replace("ё", "е"))
+        if len(w) >= 3 and w not in STOP
+    ]
+
+
+def stem(word: str) -> str:
+    return next(
+        (root for pattern, root, _ in ROOTS if re.match(pattern, word)),
+        ENDING.sub("", word) if len(word) > 4 else word,
+    )
+
+
+class RuleBasedProvider:
+    def similar(
+        self, text: str, category: str, department: str, candidates: list[dict]
+    ) -> list[dict]:
+        terms = set(map(stem, words(text)))
+        docs = [
+            (t, set(map(stem, words(t["title"]))), set(map(stem, words(t["text"]))))
+            for t in candidates
+        ]
+        idf = {
+            term: 1
+            + math.log(
+                (len(docs) + 1) / (1 + sum(term in a or term in b for _, a, b in docs))
+            )
+            for term in terms
+        }
+        scored = []
+        for ticket, title, body in docs:
+            matches = terms & (title | body)
+            if len(matches) < 2 or ticket["status"] in {
+                "Реализовано",
+                "Отклонено",
+                "Закрыто",
+            }:
+                continue
+            score = sum(
+                idf[w] * (3 * (w in title) + (w in body)) for w in matches
+            ) / math.sqrt(max(8, len(title) + len(body)))
+            score += 1.6 * (category == ticket["category"]) + 1.1 * (
+                department == ticket["targetDepartment"]
+            )
+            explanations = []
+            for term in sorted(matches, key=lambda w: (-idf[w], w))[:3]:
+                explanations.append(
+                    next(
+                        (label for _, root, label in ROOTS if root == term),
+                        next((w for w in words(text) if stem(w) == term), term),
+                    )
+                )
+            scored.append(
+                {
+                    "id": ticket["id"],
+                    "score": score,
+                    "matchExplanation": "Совпадение: " + ", ".join(explanations),
+                }
+            )
+        return sorted(scored, key=lambda t: (-t["score"], t["id"]))[:4]
+
+    def detect_cluster(self, db: Session, text: str) -> str:
+        clusters = db.scalars(select(Cluster)).all()
+        scores = [
+            (sum(word in text.lower() for word in json.loads(c.keywords)), c.id)
+            for c in clusters
+        ]
+        return max(scores)[1] if scores and max(scores)[0] else ""
+
+    def structure(
+        self, text: str, category: str, department: str, candidates: list[dict]
+    ) -> dict:
+        from ..config import settings
+
+        seed = json.loads(settings().seed_path.read_text(encoding="utf-8"))
+        scored = [
+            (sum(w in text.lower() for w in c["keywords"]), c["id"])
+            for c in seed["clusters"]
+        ]
+        cluster = max(scored)[1] if scored and max(scored)[0] else ""
+        categories = {
+            "purchase": "Заявки и взаимодействие",
+            "catalog": "Каталог и спецификации",
+            "documents": "Документы и согласования",
+            "decisions": "Процессы и коммуникации",
+            "systems": "IT и обмен данными",
+            "knowledge": "Обучение и ПНР",
+        }
+        sentences = re.split(r"(?<=[.!?])\s+", text.strip())
+        solutions = [
+            s for s in sentences if re.search("предлага|нужн|можно|хотелось", s, re.I)
+        ]
+        return {
+            "title": make_title(text),
+            "problem": " ".join(s for s in sentences if s not in solutions)
+            or sentences[0],
+            "solution": " ".join(solutions)
+            or "Согласовать порядок работы и назначить владельца процесса.",
+            "effect": "Сократить уточнения и время передачи работы между подразделениями.",
+            "category": categories.get(cluster, category or "Корпоративная среда"),
+            "priority": "Высокий"
+            if re.search("сроч|срыв|теря|ошиб|повторн", text, re.I)
+            else "Средний",
+        }
+
+    def draft(
+        self,
+        text: str,
+        category: str,
+        department: str,
+        candidates: list[dict],
+        status: str,
+    ) -> str:
+        if status == "Ожидает уточнения":
+            return f"Спасибо за обращение «{text}». Уточните этап, частоту повторения и приложите обезличенный пример."
+        if status == "Отклонено":
+            return "Спасибо за предложение. Сейчас реализация ограничена доступными ресурсами. Уточним условия повторного рассмотрения."
+        if status == "Реализовано":
+            return f"По обращению «{text}» согласован порядок работы и назначен владелец процесса. Опишите конкретный результат и проверьте его с автором."
+        return f"Обращение «{text}» принято в работу. Проверим ситуацию и зафиксируем результат в карточке."
+
+
+provider: AIProvider = RuleBasedProvider()
diff --git a/backend/app/analytics.py b/backend/app/analytics.py
new file mode 100644
index 0000000000000000000000000000000000000000..3243d15bf9d366c3b762cab24758623e67c2e688
--- /dev/null
+++ b/backend/app/analytics.py
@@ -0,0 +1,120 @@
+from datetime import timedelta, timezone
+from io import BytesIO
+
+from sqlalchemy import and_, case, func, or_, select
+from sqlalchemy.orm import Session
+from openpyxl import Workbook
+
+from . import models as m
+from .db import now
+from .domain.calendar import calendar
+from .domain.permissions import analytics_clause
+from .domain.workflow import TERMINAL
+
+
+def conditions(user: m.User, days: int):
+    result = [analytics_clause(user)]
+    if days:
+        result.append(m.Ticket.created_at >= now() - timedelta(days=days))
+    return result
+
+
+def summary(db: Session, user: m.User, days: int):
+    scope = conditions(user, days)
+    count = lambda *extra: db.scalar(select(func.count(m.Ticket.id)).where(*scope, *extra)) or 0
+    total = count()
+    response_count = count(m.Ticket.first_response_hours.is_not(None))
+    ordered = select(m.Ticket.first_response_hours).where(*scope, m.Ticket.first_response_hours.is_not(None))
+    ordered = ordered.order_by(m.Ticket.first_response_hours)
+    middle = db.scalars(ordered.offset(max(0, (response_count - 1) // 2)).limit(2 if response_count % 2 == 0 else 1)).all()
+    median = sum(middle) / len(middle) if middle else 0
+    average = db.scalar(select(func.avg(m.Ticket.first_response_hours)).where(*scope)) or 0
+    result = count(m.Ticket.status.in_(TERMINAL), or_(m.Ticket.changed != "", m.Ticket.rejection != ""))
+    open_count = count(m.Ticket.status.not_in(TERMINAL))
+    overdue = count(m.Ticket.status.not_in(TERMINAL), m.Ticket.due_at < now())
+    departments = {d.id: d.name for d in db.scalars(select(m.Department)).all()}
+    categories = {c.id: c.name for c in db.scalars(select(m.Category)).all()}
+
+    def distribution(column, labels=None):
+        rows = db.execute(select(column, func.count(m.Ticket.id)).where(*scope).group_by(column)).all()
+        return sorted([{"label": labels.get(key, key) if labels else key, "value": value}
+                       for key, value in rows], key=lambda row: (-row["value"], row["label"]))
+
+    def completed_count(*extra):
+        where = [analytics_clause(user), *extra]
+        if days:
+            where.append(m.Ticket.implemented_at >= now() - timedelta(days=days))
+        return db.scalar(select(func.count(m.Ticket.id)).where(*where)) or 0
+
+    clusters = []
+    for cluster in db.scalars(select(m.Cluster)).all():
+        linked = m.Ticket.id.in_(select(m.TicketCluster.ticket_id).where(m.TicketCluster.cluster_id == cluster.id))
+        cluster_scope = [*scope, linked]
+        size, monthly = db.execute(select(func.count(m.Ticket.id), func.sum(m.Ticket.monthly_cost)).where(*cluster_scope)).one()
+        affected = set()
+        for column in [m.Ticket.author_department_id, m.Ticket.target_department_id]:
+            affected.update(db.scalars(select(column).where(*cluster_scope).distinct()).all())
+        affected.update(db.scalars(select(m.Participant.department_id).where(m.Participant.ticket_id.in_(
+            select(m.Ticket.id).where(*cluster_scope))).distinct()).all())
+        recent, previous = db.execute(select(
+            func.sum(case((m.Ticket.created_at >= now() - timedelta(days=30), 1), else_=0)),
+            func.sum(case((and_(m.Ticket.created_at >= now() - timedelta(days=60),
+                               m.Ticket.created_at < now() - timedelta(days=30)), 1), else_=0)),
+        ).where(analytics_clause(user), linked)).one()
+        clusters.append({"id": cluster.id, "title": cluster.title, "count": size,
+                         "monthlyCost": monthly or 0, "departments": [departments[d] for d in sorted(affected)],
+                         "trend": (recent or 0) - (previous or 0)})
+    matrix_rows = db.execute(select(m.Ticket.author_department_id, m.Ticket.target_department_id,
+                                    func.count(m.Ticket.id)).where(*scope, m.Ticket.type == "Проблема")
+                             .group_by(m.Ticket.author_department_id, m.Ticket.target_department_id)).all()
+    sla_rows = db.execute(select(m.User.department_id, func.count(m.Ticket.id)).join(
+        m.Ticket, m.Ticket.assignee_id == m.User.id).where(*scope, m.Ticket.status.not_in(TERMINAL),
+        m.Ticket.due_at < now()).group_by(m.User.department_id)).all()
+    local = calendar().local(now())
+    monday = (local - timedelta(days=local.weekday())).replace(hour=0, minute=0, second=0, microsecond=0)
+    weekly = []
+    for index in range(10):
+        start = (monday - timedelta(weeks=9 - index)).astimezone(timezone.utc).replace(tzinfo=None)
+        end = start + timedelta(days=7)
+        incoming = count(m.Ticket.created_at >= start, m.Ticket.created_at < end)
+        done = count(m.Ticket.status.in_(["Реализовано", "Закрыто"]),
+                     m.Ticket.implemented_at >= start, m.Ticket.implemented_at < end)
+        weekly.append({"start": start.isoformat() + "Z", "incoming": incoming, "done": done})
+    return {
+        "total": total, "openCount": open_count, "overdueCount": overdue,
+        "considered": response_count / total * 100 if total else 0,
+        "medianHours": median, "averageHours": average, "resultRate": result / total * 100 if total else 0,
+        "implemented": completed_count(m.Ticket.status.in_(["Реализовано", "Закрыто"]), m.Ticket.implemented_at.is_not(None)),
+        "confirmed": completed_count(m.Ticket.confirmed.is_(True)),
+        "defaultConfirmed": completed_count(m.Ticket.default_confirmed.is_(True)),
+        "distributions": {"type": distribution(m.Ticket.type), "status": distribution(m.Ticket.status),
+                          "category": distribution(m.Ticket.category_id, categories)},
+        "clusterStats": clusters, "departments": list(departments.values()), "weekly": weekly,
+        "matrix": [{"authorDepartment": departments[a], "targetDepartment": departments[b], "count": n}
+                   for a, b, n in matrix_rows],
+        "sla": [{"department": departments[d], "count": n} for d, n in sla_rows],
+        "companyScope": user.can_view_company_analytics,
+    }
+
+
+def registry(db: Session, user: m.User, days: int) -> BytesIO:
+    workbook = Workbook(write_only=True)
+    sheet = workbook.create_sheet("Обращения")
+    sheet.append(["ID", "Заголовок", "Тип", "Категория", "Исходная категория", "Статус", "Автор",
+                  "Подразделение автора", "Подразделение проблемы", "Ответственный", "Создано",
+                  "Срок ответа", "Срок решения", "Потери, чел.-ч/мес", "Что изменилось", "Отказ"])
+    departments = {d.id: d.name for d in db.scalars(select(m.Department)).all()}
+    categories = {c.id: c.name for c in db.scalars(select(m.Category)).all()}
+    users = {u.id: u.name for u in db.scalars(select(m.User)).all()}
+    def safe(value):
+        return "'" + value if isinstance(value, str) and value.startswith(("=", "+", "-", "@")) else value
+    for ticket in db.scalars(select(m.Ticket).where(*conditions(user, days)).order_by(m.Ticket.created_at).limit(50000)):
+        row = [ticket.id, ticket.title, ticket.type, categories[ticket.category_id], ticket.original_category,
+               ticket.status, users.get(ticket.author_id, ""), departments[ticket.author_department_id],
+               departments[ticket.target_department_id], users[ticket.assignee_id], ticket.created_at,
+               ticket.response_due_at, ticket.due_at, ticket.monthly_cost, ticket.changed, ticket.rejection]
+        sheet.append([safe(value) for value in row])
+    output = BytesIO()
+    workbook.save(output)
+    output.seek(0)
+    return output
diff --git a/backend/app/auth.py b/backend/app/auth.py
new file mode 100644
index 0000000000000000000000000000000000000000..7f3fb01462665ab6404422817ea404bb922a96cb
--- /dev/null
+++ b/backend/app/auth.py
@@ -0,0 +1,48 @@
+from datetime import timedelta
+from typing import Annotated
+import jwt
+
+from fastapi import Depends
+from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer
+from sqlalchemy.orm import Session
+
+from .config import settings
+from .db import now, session
+from .domain.errors import DomainError
+from .models import User
+
+Database = Annotated[Session, Depends(session, scope="function")]
+bearer = HTTPBearer(auto_error=False)
+
+
+def issue_token(user: User) -> str:
+    return jwt.encode({"sub": user.id, "iat": now(),
+                       "exp": now() + timedelta(hours=settings().jwt_ttl_hours),
+                       "iss": "signal", "aud": "signal-ui"}, settings().jwt_secret, algorithm="HS256")
+
+
+def current_user(db: Database, credentials: Annotated[HTTPAuthorizationCredentials | None,
+                                                    Depends(bearer)]) -> User:
+    try:
+        if not credentials:
+            raise ValueError("missing token")
+        data = jwt.decode(credentials.credentials, settings().jwt_secret, algorithms=["HS256"],
+                          issuer="signal", audience="signal-ui", options={"require": ["sub", "exp", "iat"]})
+        user = db.get(User, data["sub"])
+        if not user:
+            raise ValueError("missing user")
+        return user
+    except (jwt.InvalidTokenError, ValueError):
+        raise DomainError("Сеанс истёк. Выполните демо-вход повторно", 401) from None
+
+
+CurrentUser = Annotated[User, Depends(current_user)]
+
+
+def admin(user: CurrentUser) -> User:
+    if user.role != "Администратор":
+        raise DomainError("Действие доступно администратору", 403)
+    return user
+
+
+Admin = Annotated[User, Depends(admin)]
