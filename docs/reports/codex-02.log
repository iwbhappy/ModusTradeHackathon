import { catalogBase } from '../data/seed';
import { terminal } from '../lib/format';
import { workingHoursBetween } from '../lib/business-time';
import type { Analytics } from '../types';
import { db, pause, clone, user } from './storage';

export async function getAnalytics(days: number, userId: string): Promise<Analytics> {
  await pause();
  if (user(userId).role !== 'Руководитель') throw new Error('Аналитика доступна руководителю');
  const tickets = db.tickets.filter(
    (t) => !days || Date.now() - new Date(t.createdAt).getTime() <= days * 86400000,
  );
  const hours = tickets
    .filter((t) => t.firstResponseAt)
    .map((t) => workingHoursBetween(t.createdAt, t.firstResponseAt!))
    .sort((a, b) => a - b);
  const percent = (n: number) => (tickets.length ? (n / tickets.length) * 100 : 0);
  const inPeriod = (value?: string) =>
    !!value && (!days || Date.now() - new Date(value).getTime() <= days * 86400000);
  const clusterTrends = Object.fromEntries(
    catalogBase.clusters.map((c) => {
      const list = db.tickets.filter((t) => t.clusterId === c.id);
      const recent = list.filter(
        (t) => Date.now() - new Date(t.createdAt).getTime() <= 30 * 86400000,
      ).length;
      const previous = list.filter((t) => {
        const age = Date.now() - new Date(t.createdAt).getTime();
        return age > 30 * 86400000 && age <= 60 * 86400000;
      }).length;
      return [c.id, recent - previous];
    }),
  );
  return clone({
    tickets,
    clusters: catalogBase.clusters,
    clusterTrends,
    departments: catalogBase.departments,
    users: db.users,
    considered: percent(tickets.filter((t) => !!t.firstResponseAt).length),
    medianHours: hours.length
      ? (hours[Math.floor((hours.length - 1) / 2)] + hours[Math.floor(hours.length / 2)]) / 2
      : 0,
    averageHours: hours.length ? hours.reduce((a, b) => a + b, 0) / hours.length : 0,
    resultRate: percent(
      tickets.filter((t) => terminal(t) && (!!t.changed || !!t.rejection)).length,
    ),
    implemented: db.tickets.filter(
      (t) => ['Реализовано', 'Закрыто'].includes(t.status) && inPeriod(t.implementedAt),
    ).length,
    confirmed: db.tickets.filter((t) => t.confirmed && inPeriod(t.closedAt)).length,
  });
}
import { Paperclip, X } from 'lucide-react';

export function Attachments({
  names,
  onChange,
}: {
  names: string[];
  onChange: (names: string[]) => void;
}) {
  return (
    <>
      <div className="attachment-row">
        <label className="button">
          <Paperclip size={15} />
          Прикрепить файл
          <input
            type="file"
            className="sr-only"
            multiple
            onChange={(e) => {
              onChange([
                ...new Set([...names, ...Array.from(e.target.files || []).map((f) => f.name)]),
              ]);
              e.target.value = '';
            }}
          />
        </label>
        <small>В прототипе сохраняются только имена файлов</small>
      </div>
      {names.map((name) => (
        <span className="file-chip" key={name}>
          <Paperclip size={13} />
          {name}
          <button
            type="button"
            className="icon-button"
            aria-label={`Удалить ${name}`}
            onClick={() => onChange(names.filter((value) => value !== name))}
          >
            <X size={13} />
          </button>
        </span>
      ))}
    </>
  );
}
import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { ChevronsUpDown, Search } from 'lucide-react';
import { useApp } from '../../store';

import type { Role } from '../../types';
export function Header({ home }: { home: string }) {
  const { catalog, userId, selectRole, selectUser } = useApp();
  const current = catalog!.users.find((u) => u.id === userId)!;
  const navigate = useNavigate();
  const [search, setSearch] = useState('');
  const switchRole = (role: Role) => {
    selectRole(role);
    navigate(role === 'Сотрудник' ? '/mine' : role === 'Руководитель' ? '/inbox' : '/routing');
    setSearch('');
  };
  return (
    <header className="topbar">
      <form
        className="global-search"
        onSubmit={(e) => {
          e.preventDefault();
          navigate(
            `${current.role === 'Администратор' ? '/users' : home}?search=${encodeURIComponent(search)}`,
          );
        }}
      >
        <Search size={17} />
        <input
          aria-label={current.role === 'Администратор' ? 'Поиск пользователей' : 'Поиск обращений'}
          placeholder={
            current.role === 'Администратор'
              ? 'Найти пользователя по роли или подразделению'
              : 'Найти обращение по тексту или ID'
          }
          value={search}
          onChange={(e) => setSearch(e.target.value)}
        />
        <kbd>Enter</kbd>
      </form>
      <div className="demo-role">
        <span>Демо-роль</span>
        <select
          aria-label="Демо-роль"
          value={current.role}
          onChange={(e) => switchRole(e.target.value as Role)}
        >
          <option>Сотрудник</option>
          <option>Руководитель</option>
          <option>Администратор</option>
        </select>
      </div>
      <div className="user-select">
        <span className="avatar">
          {current.role === 'Администратор' ? 'АС' : current.department.slice(0, 2).toUpperCase()}
        </span>
        <select
          aria-label="Текущий пользователь"
          value={userId}
          onChange={(e) => {
            selectUser(e.target.value);
            setSearch('');
            navigate(home);
          }}
        >
          {catalog!.users
            .filter((u) => u.role === current.role)
            .map((u) => (
              <option key={u.id} value={u.id}>
                {u.name}
              </option>
            ))}
        </select>
        <ChevronsUpDown size={13} />
      </div>
    </header>
  );
}

