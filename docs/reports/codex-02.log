+    search: str = "",
+    department: str = "",
+    category: str = "",
+    status: str = "",
+    priority: str = "",
+    overdue: bool = False,
+    cluster: str = "",
+    authorDepartment: str = "",
+    targetDepartment: str = "",
+    offset: int = Query(0, ge=0),
+    limit: int = Query(100, ge=1, le=500),
+):
+    query = filters(
+        db,
+        select(m.Ticket).where(visible_clause(user)),
+        search,
+        department,
+        category,
+        status,
+        priority,
+        overdue,
+        cluster,
+        authorDepartment,
+        targetDepartment,
+    )
+    return [
+        ticket_view(db, t)
+        for t in db.scalars(
+            query.order_by(m.Ticket.created_at.desc()).offset(offset).limit(limit)
+        )
+    ]
