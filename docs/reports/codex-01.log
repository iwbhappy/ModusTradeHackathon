+      <Route path="/analytics" element={current.role === 'Руководитель' ? <AnalyticsPage/> : <Navigate to={home} replace/>}/>
+      <Route path="/routing" element={current.role === 'Администратор' ? <RoutingPage/> : <Navigate to={home} replace/>}/>
