+    <div className="app-content"><header className="topbar"><form className="global-search" onSubmit={e => { e.preventDefault(); navigate(`${home}?search=${encodeURIComponent(search)}`); }}><Search size={17}/><input aria-label="Поиск обращений" placeholder="Найти обращение по тексту или ID" value={search} onChange={e => setSearch(e.target.value)}/><kbd>Enter</kbd></form><div className="demo-role"><span>Демо-роль</span><select aria-label="Демо-роль" value={current.role} onChange={e => switchRole(e.target.value as Role)}><option>Сотрудник</option><option>Руководитель</option><option>Администратор</option></select></div><div className="user-select"><span className="avatar">{current.role === 'Администратор' ? 'АС' : current.department.slice(0, 2).toUpperCase()}</span><select aria-label="Текущий пользователь" value={userId} onChange={e => { selectUser(e.target.value); navigate(home); }}>{catalog.users.filter(u => u.role === current.role).map(u => <option key={u.id} value={u.id}>{u.name}</option>)}</select><ChevronsUpDown size={13}/></div></header>
+    <main key={userId}><div className="breadcrumb"><span>Модус Трейд</span><span>/</span><span>Обратная связь сотрудников</span><div className="prototype-label"><CircleHelp size={13}/>Демонстрационные данные</div></div><Routes>
