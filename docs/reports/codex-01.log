+import { Badge, Empty, ErrorMessage, Field, Loading, PageTitle, Panel } from '../components/ui';
+
+export function CostFields({ frequency, minutes, onChange }: { frequency: Frequency; minutes: number; onChange: (frequency: Frequency, minutes: number) => void }) { return <div className="form-grid"><Field label="Как часто?"><select value={frequency} onChange={e => onChange(e.target.value as Frequency, minutes)}>{['ежедневно', 'еженедельно', 'ежемесячно', 'разово'].map(f => <option key={f}>{f}</option>)}</select></Field><Field label="Сколько времени теряете за раз?"><select value={minutes} onChange={e => onChange(frequency, Number(e.target.value))}>{[[15, '≈ 15 мин'], [30, '≈ 30 мин'], [60, '≈ 1 ч'], [120, '≈ 2 ч+']].map(([v, label]) => <option key={v} value={v}>{label}</option>)}</select></Field></div>; }
+export function NewTicket() {
+  const { catalog, userId, refresh, notify } = useApp(); const navigate = useNavigate();
+  const [draft, setDraft] = useState<TicketDraft>({ type: 'Проблема', category: catalog!.categories[0], targetDepartment: 'Закупки', text: '', solution: '', effect: '', priority: 'Средний', frequency: 'еженедельно', minutes: 30, attachments: [] });
+  const [similar, setSimilar] = useState<Ticket[]>([]); const [finding, setFinding] = useState(false); const [route, setRoute] = useState<RoutePreview | null>(null); const [routeError, setRouteError] = useState(''); const [structure, setStructure] = useState<Structure | null>(null);
+  const [busy, setBusy] = useState(false); const [error, setError] = useState(''); const [joinId, setJoinId] = useState(''); const [context, setContext] = useState('');
+  const change = <K extends keyof TicketDraft>(key: K, value: TicketDraft[K]) => setDraft(d => ({ ...d, [key]: value }));
+  useEffect(() => { let live = true; setFinding(draft.text.length >= 8); const timer = setTimeout(() => { findSimilar(draft.text, userId).then(t => { if (live) setSimilar(t); }).catch(e => { if (live) setError(e.message); }).finally(() => { if (live) setFinding(false); }); }, 450); return () => { live = false; clearTimeout(timer); }; }, [draft.text, userId]);
+  useEffect(() => { let live = true; setRoute(null); setRouteError(''); previewRouting(draft.category, draft.targetDepartment).then(r => { if (live) setRoute(r); }).catch(e => { if (live) setRouteError(e.message); }); return () => { live = false; }; }, [draft.category, draft.targetDepartment]);
+  if (!catalog) return null;
+  return <><Link to="/mine" className="back-link"><ArrowLeft size={15}/>Мои обращения</Link><PageTitle title="Новое обращение" subtitle="Опишите ситуацию. Система направит обращение ответственному."/>
+    <div className="compose-layout"><form className="panel compose-form" onSubmit={async e => { e.preventDefault(); setBusy(true); setError(''); try { const t = await createTicket(draft, userId); await refresh(); notify(`${t.id}: обращение зарегистрировано`); navigate(`/tickets/${t.id}`); } catch (e) { setError((e as Error).message); } finally { setBusy(false); } }}>
+    <div className="panel-heading"><h2>Содержание обращения</h2><span className="quiet-label">Обязательные поля отмечены *</span></div><div className="panel-body">
+    <fieldset className="type-field"><legend>Тип обращения *</legend><div className="segmented">{(['Проблема', 'Предложение', 'Положительный отзыв'] as TicketType[]).map(type => <button type="button" key={type} className={type === draft.type ? 'selected' : ''} onClick={() => change('type', type)}>{type}</button>)}</div></fieldset>
+    <div className="form-grid"><Field label="Категория *"><select value={draft.category} onChange={e => change('category', e.target.value)}>{catalog.categories.map(c => <option key={c}>{c}</option>)}</select></Field><Field label="К какому подразделению относится *"><select value={draft.targetDepartment} onChange={e => change('targetDepartment', e.target.value)}>{catalog.departments.map(d => <option key={d}>{d}</option>)}</select></Field></div>
+    <Field label="Описание ситуации *" hint="Что происходит, на каком этапе и как это влияет на работу. Не указывайте конфиденциальные сведения."><textarea required minLength={20} maxLength={6000} rows={7} placeholder="Например: в заявках на закупку оборудования не хватает назначения изделия и требуемых параметров…" value={draft.text} onChange={e => { change('text', e.target.value); setStructure(null); }}/></Field>
+    <div className="structure-button"><button type="button" disabled={busy || draft.text.trim().length < 20} onClick={async () => { setBusy(true); setError(''); try { setStructure(await suggestStructure(draft.text)); } catch (e) { setError((e as Error).message); } finally { setBusy(false); } }}><Wand2 size={16}/>Структурировать текст</button><small>Автоподсказка · текст можно проверить</small></div>
+    {structure && <div className="system-box"><div className="section-label"><ScanSearch size={16}/><strong>Предлагаемая структура</strong><span className="badge blue">Автоподсказка</span></div><dl className="structure"><dt>Проблема</dt><dd>{structure.problem}</dd><dt>Предлагаемое решение</dt><dd>{structure.solution}</dd><dt>Ожидаемый эффект</dt><dd>{structure.effect}</dd></dl><p className="small">Категория: {structure.category} · Приоритет: {structure.priority}</p><div className="button-row"><button type="button" onClick={() => { setDraft(d => ({ ...d, text: structure.problem, solution: structure.solution, effect: structure.effect, category: structure.category, priority: structure.priority })); setStructure(null); notify('Структура принята. Поля доступны для редактирования.'); }}><Check size={15}/>Принять</button><button type="button" onClick={() => setStructure(null)}>Отклонить</button></div></div>}
+    <Field label="Предлагаемое решение"><textarea rows={3} placeholder="Как, по вашему мнению, можно улучшить ситуацию?" value={draft.solution} onChange={e => change('solution', e.target.value)}/></Field>
+    {draft.effect && <Field label="Ожидаемый эффект"><textarea rows={2} value={draft.effect} onChange={e => change('effect', e.target.value)}/></Field>}
+    <div className="attachment-row"><label className="button"><Paperclip size={15}/>Прикрепить файл<input type="file" className="sr-only" multiple onChange={e => change('attachments', [...new Set([...draft.attachments, ...Array.from(e.target.files || []).map(f => f.name)])])}/></label><small>В прототипе сохраняются только имена файлов</small></div>
+    {draft.attachments.map(name => <span className="file-chip" key={name}><Paperclip size={13}/>{name}<button type="button" className="icon-button" aria-label={`Удалить ${name}`} onClick={() => change('attachments', draft.attachments.filter(n => n !== name))}><X size={13}/></button></span>)}
+    {draft.type === 'Проблема' && <section className="cost-box"><div className="section-label"><Clock3 size={17}/><h2>Стоимость проблемы</h2></div><p>Два ответа помогут расставить приоритеты по потерям времени.</p><CostFields frequency={draft.frequency} minutes={draft.minutes} onChange={(f, m) => setDraft(d => ({ ...d, frequency: f, minutes: m }))}/><div className="cost-result">Ваша оценка: <strong className="mono">≈ {number(monthly(draft.frequency, draft.minutes))}</strong> чел.-ч/мес{draft.frequency === 'разово' && <small>Разовая потеря: {draft.minutes} мин. Не включается в ежемесячные потери.</small>}</div></section>}
+    <ErrorMessage text={routeError}/>{route ? <div className="route-preview"><Send size={18}/><div><strong>Обращение получит: {route.assignee.name}</strong>{route.fallback && <p className="overdue">{route.primary.name} в отпуске. Выбран резервный ответственный.</p>}<p>Первый ответ до <b>{date(route.responseDueAt)}</b> · решение до {date(route.dueAt)}</p><small>{route.responseDays} и {route.resolutionDays} рабочих дней по правилу категории</small></div></div> : !routeError && <Loading/>}
+    <ErrorMessage text={error}/><div className="form-footer"><Link to="/mine" className="button">Отмена</Link><button className="primary" disabled={busy || !route || draft.text.trim().length < 20}><Send size={16}/>{busy ? 'Сохранение…' : 'Отправить обращение'}</button></div></div></form>
+    <aside className="similar-panel"><Panel title="Похожие обращения" aside={<ScanSearch size={17}/>}><div className="panel-body"><p className="muted small">Возможно, эту проблему уже решают. Присоединитесь и добавьте свой контекст.</p>{finding ? <Loading/> : !similar.length ? <Empty text={draft.text.length < 8 ? 'Начните описывать ситуацию' : 'Похожих открытых обращений нет'}/> : similar.map(t => {
+      const joined = t.authorId === userId || t.participants.some(p => p.userId === userId);
+      return <article className="similar-card" key={t.id}><div className="between"><span className="mono ticket-id">{t.id}</span><Badge status={t.status}/></div><h3>{t.title}</h3><p className="small muted">{t.participants.length + 1} участников · {new Set([t.authorDepartment, ...t.participants.map(p => p.department)]).size} подразделения</p>{t.type === 'Проблема' && <div className="small">≈ <span className="mono">{number(cost(t))}</span> чел.-ч/мес</div>}{joined ? <Link className="text-button" to={`/tickets/${t.id}`}>Уже в ваших обращениях <ArrowRight size={14}/></Link> : <button type="button" className="text-button" onClick={() => { setJoinId(joinId === t.id ? '' : t.id); setContext(''); }}>У меня то же самое → присоединиться</button>}
+      {joinId === t.id && <div className="join-form"><Field label="Ваш контекст *"><textarea rows={3} value={context} onChange={e => setContext(e.target.value)} placeholder="Где и как возникает у вас?"/></Field>{t.type === 'Проблема' && <p className="small">К потерям добавится ваша оценка: {number(monthly(draft.frequency, draft.minutes))} чел.-ч/мес. Измените её в блоке «Стоимость проблемы».</p>}<button type="button" className="primary" disabled={busy || context.trim().length < 10} onClick={async () => { setBusy(true); setError(''); try { await joinTicket(t.id, context, draft.frequency, draft.minutes, userId); await refresh(); notify(`Вы присоединились к ${t.id}`); navigate(`/tickets/${t.id}`); } catch (e) { setError((e as Error).message); } finally { setBusy(false); } }}>Присоединиться</button></div>}</article>;
+    })}</div></Panel><div className="privacy-note"><strong>Что произойдёт дальше</strong><p>Ответственный увидит обращение в очереди. Все ответы, изменения статуса и результат появятся в карточке обращения.</p></div></aside></div>
+  </>;
+}
diff --git a/frontend/src/pages/TicketDetail.tsx b/frontend/src/pages/TicketDetail.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..960b2612508ab29b6b894b4bbade1a9b93a627f0
--- /dev/null
+++ b/frontend/src/pages/TicketDetail.tsx
@@ -0,0 +1,50 @@
+import { useEffect, useState } from 'react';
+import { Link, useNavigate, useParams } from 'react-router-dom';
+import { ArrowLeft, Check, CheckCheck, Clock3, CornerUpLeft, MessageSquare, Paperclip, ScanSearch, Send, UserRound, Wand2 } from 'lucide-react';
+import { addComment, confirmResolution, draftResponse, getTicket, listTickets, reassign, updateStatus } from '../api';
+import { useApp } from '../store';
+import type { Status, Ticket } from '../types';
+import { businessDays, cost, date, deadline, number, overdue, terminal } from '../lib/format';
+import { Badge, ErrorMessage, Field, Loading, PageTitle, Panel } from '../components/ui';
+
+export function TicketDetail() {
+  const { id = '' } = useParams(); const navigate = useNavigate(); const { catalog, userId, revision, refresh, notify } = useApp();
+  const [t, setTicket] = useState<Ticket | null>(null); const [related, setRelated] = useState<Ticket[]>([]); const [loading, setLoading] = useState(true); const [error, setError] = useState('');
+  const [comment, setComment] = useState(''); const [status, setStatus] = useState<Status>('В работе'); const [actionText, setActionText] = useState(''); const [busy, setBusy] = useState(false); const [assignee, setAssignee] = useState(''); const [reason, setReason] = useState(''); const [returning, setReturning] = useState(false); const [returnReason, setReturnReason] = useState(''); const [draft, setDraft] = useState('');
+  useEffect(() => { let live = true; setLoading(true); setError(''); getTicket(id, userId).then(async ticket => { if (!live) return; setTicket(ticket); setAssignee(ticket.assigneeId); const list = ticket.clusterId ? await listTickets(userId, { cluster: ticket.clusterId }) : []; if (live) setRelated(list); }).catch(e => { if (live) { setTicket(null); setError(e.message); } }).finally(() => { if (live) setLoading(false); }); return () => { live = false; }; }, [id, userId, revision]);
+  if (!catalog) return null;
+  const current = catalog.users.find(u => u.id === userId)!;
+  const home = current.role === 'Сотрудник' ? '/mine' : current.role === 'Руководитель' ? '/inbox' : '/routing';
+  if (loading) return <Loading/>;
+  if (!t) return <><Link className="back-link" to={home}><ArrowLeft size={15}/>Вернуться</Link><ErrorMessage text={error}/></>;
+  const manager = current.role === 'Руководитель'; const author = t.authorId === userId;
+  const owner = catalog.users.find(u => u.id === t.assigneeId)!;
+  const run = async (operation: () => Promise<unknown>, message: string) => { setBusy(true); setError(''); try { await operation(); await refresh(); notify(message); } catch (e) { setError((e as Error).message); } finally { setBusy(false); } };
+  const stageDefs = [
+    { title: 'Зарегистрировано', statuses: ['Новое'], plan: t.createdAt },
+    { title: 'Рассмотрение', statuses: ['На рассмотрении', 'Ожидает уточнения'], plan: t.responseDueAt },
+    { title: 'В работе', statuses: ['В работе', 'Возвращено автором'], plan: businessDays(new Date(t.responseDueAt), 1) },
+    { title: 'Результат', statuses: ['Реализовано', 'Отклонено'], plan: t.dueAt },
+    { title: t.status === 'Отклонено' ? 'Завершено' : 'Подтверждение', statuses: ['Закрыто'], plan: businessDays(new Date(t.dueAt), 3) }
+  ];
+  return <><Link to={home} className="back-link"><ArrowLeft size={15}/>{manager ? 'Входящие' : 'Мои обращения'}</Link><PageTitle title={t.title} subtitle={`${t.id} · ${t.type} · ${t.category}`} action={<Badge status={t.status}/>}/>
+    <Panel className="tracking-panel"><div className="tracking-summary"><div><Clock3 size={17}/><strong className={overdue(t) ? 'overdue' : ''}>{deadline(t)}</strong></div><span>Ответственный: <b>{owner.name}</b></span><span>Обещанный срок решения: <b>{date(t.dueAt)}</b></span></div><ol className="tracking">{stageDefs.map((stage, i) => { const event = t.events.find(e => e.status && stage.statuses.includes(e.status)); const fact = event?.date || (i === 4 ? t.closedAt : undefined); return <li className={fact ? 'complete' : ''} key={stage.title}><span className="track-circle">{fact ? <Check size={13}/> : i + 1}</span><div><strong>{stage.title}</strong><small>{fact ? date(fact) : `План: ${date(stage.plan)}`}</small></div></li>; })}</ol></Panel>
+    <ErrorMessage text={error}/><div className="detail-layout"><div className="detail-main">
+      {t.rejection && t.status === 'Отклонено' && <Panel title="Причина отказа"><div className="panel-body"><p>{t.rejection}</p><p className="small muted">Мотивировка сохранена в истории обращения.</p></div></Panel>}
+      {t.changed && ['Реализовано', 'Закрыто', 'Возвращено автором'].includes(t.status) && <Panel title="Что изменилось" aside={<CheckCheck size={17}/>}><div className="panel-body"><p>{t.changed}</p>{t.confirmed && <div className="success-line"><CheckCheck size={16}/>Результат подтверждён автором</div>}{author && t.status === 'Реализовано' && <div className="confirmation"><p><strong>Проверьте результат в своей работе</strong></p><div className="button-row"><button className="primary" disabled={busy} onClick={() => run(() => confirmResolution(id, true, '', userId), 'Решение подтверждено. Обращение закрыто.')}><CheckCheck size={16}/>Проблема решена</button><button disabled={busy} onClick={() => setReturning(!returning)}><CornerUpLeft size={16}/>Не решена — вернуть</button></div>{returning && <div className="return-form"><Field label="Что осталось нерешённым? *"><textarea rows={3} value={returnReason} onChange={e => setReturnReason(e.target.value)}/></Field><button disabled={busy || returnReason.trim().length < 10} onClick={() => run(() => confirmResolution(id, false, returnReason, userId), 'Обращение возвращено в работу. Срок обновлён.')} className="primary">Вернуть ответственному</button></div>}</div>}</div></Panel>}
+      <Panel title="Описание обращения"><div className="panel-body"><p className="preserve">{t.text}</p>{t.solution && <><h3>Предлагаемое решение</h3><p className="preserve">{t.solution}</p></>}{t.effect && <><h3>Ожидаемый эффект</h3><p>{t.effect}</p></>}{t.attachments.length > 0 && <div className="attachment-list">{t.attachments.map(file => <span className="file-chip" key={file}><Paperclip size={14}/>{file}<small>имя файла</small></span>)}</div>}</div></Panel>
+      <Panel title="Обсуждение" aside={<span className="mono muted">{t.comments.length}</span>}><div className="panel-body">{!t.comments.length && <p className="muted">Комментариев пока нет. Здесь можно уточнить контекст обращения.</p>}{t.comments.map(c => <article className="comment" key={c.id}><div className="comment-heading"><UserRound size={15}/><strong>{c.author}</strong><time>{date(c.date)}</time></div><p className="preserve">{c.text}</p></article>)}{author && t.status === 'Ожидает уточнения' && <div className="inline-attention"><MessageSquare size={16}/>Ответьте на запрос. Обращение вернётся на рассмотрение.</div>}<form onSubmit={e => { e.preventDefault(); run(async () => { await addComment(id, comment, userId); setComment(''); }, 'Комментарий сохранён'); }}><Field label={author && t.status === 'Ожидает уточнения' ? 'Ответ на запрос уточнения' : 'Новый комментарий'}><textarea rows={3} placeholder="Добавьте информацию по обращению…" value={comment} onChange={e => setComment(e.target.value)} required maxLength={6000}/></Field><button disabled={busy || !comment.trim()} className="primary"><Send size={15}/>Отправить</button></form></div></Panel>
+      {t.participants.length > 0 && <Panel title="Присоединились к обращению" aside={<span className="mono muted">{t.participants.length}</span>}><div className="panel-body">{t.participants.map(p => <article className="participant" key={p.userId}><strong>{catalog.users.find(u => u.id === p.userId)?.name}</strong><small>{p.department}</small><p>{p.context}</p></article>)}</div></Panel>}
+      <Panel title="История событий"><ol className="event-history">{[...t.events].reverse().map(e => <li key={e.id}><span className="history-dot"/><div><div className="between"><strong>{e.actor}</strong><time>{date(e.date)}</time></div><p>{e.text}</p></div></li>)}</ol></Panel>
+    </div><aside className="detail-aside">
+      <Panel title="Сведения"><dl className="meta-list"><dt>Автор</dt><dd>{catalog.users.find(u => u.id === t.authorId)?.name}</dd><dt>Подразделение автора</dt><dd>{t.authorDepartment}</dd><dt>К чему относится</dt><dd>{t.targetDepartment}</dd><dt>Приоритет</dt><dd>{t.priority}</dd><dt>Создано</dt><dd>{date(t.createdAt)}</dd><dt>Первый ответ</dt><dd>{t.firstResponseAt ? date(t.firstResponseAt) : `До ${date(t.responseDueAt)}`}</dd>{!t.firstResponseAt && new Date(t.responseDueAt).getTime() < Date.now() && <dd className="overdue">Первый ответ просрочен</dd>}{t.type === 'Проблема' && <><dt>Стоимость проблемы</dt><dd className="cost-number"><span className="mono">≈ {number(cost(t))}</span> чел.-ч/мес<small>{t.frequency}, {t.minutes} мин за раз · включая оценки участников</small></dd></>}</dl></Panel>
+      {manager && !terminal(t) && <Panel title="Действия ответственного"><div className="panel-body"><form onSubmit={e => { e.preventDefault(); run(async () => { await updateStatus(id, status, actionText, userId); setActionText(''); setDraft(''); }, 'Статус и история обновлены'); }}><Field label="Новый статус"><select value={status} onChange={e => { setStatus(e.target.value as Status); setDraft(''); }}>{(['На рассмотрении', 'В работе', 'Ожидает уточнения', 'Реализовано', 'Отклонено'] as Status[]).map(s => <option disabled={s === t.status} key={s}>{s}</option>)}</select></Field>
+      {status === 'Отклонено' && <Field label="Шаблон мотивировки"><select defaultValue="" onChange={e => { if (e.target.value) setActionText(e.target.value); }}><option value="">Выберите шаблон</option><option>Сейчас нет подходящего помещения. Вернёмся к вопросу при перепланировке рабочих помещений.</option><option>Реализация требует ресурсов, которые не предусмотрены в текущем плане. Повторно рассмотрим предложение в следующем квартале.</option><option>Предложенное изменение не соответствует обязательным требованиям безопасности. Предлагаем обсудить альтернативное решение.</option></select></Field>}
+      <Field label={status === 'Реализовано' ? 'Что изменилось *' : status === 'Отклонено' ? 'Мотивировка отказа *' : status === 'Ожидает уточнения' ? 'Что нужно уточнить *' : 'Комментарий к действию'}><textarea rows={5} value={actionText} onChange={e => setActionText(e.target.value)} required={['Реализовано', 'Отклонено', 'Ожидает уточнения'].includes(status)} minLength={['Реализовано', 'Отклонено', 'Ожидает уточнения'].includes(status) ? 10 : undefined}/></Field>
+      <button type="button" className="text-button" disabled={busy} onClick={() => run(async () => setDraft(await draftResponse(id, status, userId)), 'Черновик подготовлен. Проверьте и отредактируйте текст.')}><Wand2 size={15}/>Черновик ответа</button>
+      {draft && <div className="system-box"><span className="quiet-label">Автоподсказка</span><p className="small">{draft}</p><div className="button-row"><button type="button" onClick={() => { setActionText(draft); setDraft(''); }}>Принять</button><button type="button" onClick={() => setDraft('')}>Отклонить</button></div></div>}
+      <button className="primary full-width" disabled={busy || status === t.status || (['Реализовано', 'Отклонено', 'Ожидает уточнения'].includes(status) && actionText.trim().length < 10)}>Сохранить решение</button></form>
+      <hr/><form onSubmit={e => { e.preventDefault(); run(async () => { await reassign(id, assignee, reason, userId); setReason(''); navigate('/inbox'); }, 'Обращение переназначено'); }}><h3>Переназначить</h3><Field label="Новый ответственный"><select value={assignee} onChange={e => setAssignee(e.target.value)}>{catalog.users.filter(u => u.role === 'Руководитель').map(u => <option key={u.id} value={u.id} disabled={u.vacation}>{u.name}{u.vacation ? ' · в отпуске' : ''}</option>)}</select></Field><Field label="Причина переназначения *"><textarea rows={2} value={reason} onChange={e => setReason(e.target.value)} required minLength={10}/></Field><button disabled={busy || assignee === t.assigneeId || reason.trim().length < 10}>Переназначить</button></form></div></Panel>}
+      {t.clusterId && <Panel title="Связанные обращения" aside={<ScanSearch size={16}/>}><div className="panel-body"><h3>{catalog.clusters.find(c => c.id === t.clusterId)?.title}</h3><p className="small muted">Доступная вам часть кластера</p><div className="cluster-cost"><strong className="mono">≈ {number(related.reduce((sum, item) => sum + cost(item), 0))}</strong><span>чел.-ч/мес</span></div><p className="small">{[...new Set(related.flatMap(item => [item.authorDepartment, item.targetDepartment, ...item.participants.map(p => p.department)]))].join(', ')}</p>{related.filter(item => item.id !== id).slice(0, 6).map(item => <Link className="related-link" to={`/tickets/${item.id}`} key={item.id}><span className="mono">{item.id}</span>{item.title}</Link>)}{manager && <Link to={`/analytics?cluster=${t.clusterId}`} className="text-button">Весь кластер в аналитике</Link>}</div></Panel>}
+    </aside></div></>;
+}
diff --git a/frontend/src/pages/TicketList.tsx b/frontend/src/pages/TicketList.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..3ab19b54084ec73373079c2de1fbf4204421796a
--- /dev/null
+++ b/frontend/src/pages/TicketList.tsx
@@ -0,0 +1,40 @@
+import { useEffect, useMemo, useState } from 'react';
+import { Link, useSearchParams } from 'react-router-dom';
+import { ArrowDownWideNarrow, ArrowRight, Clock3, Plus, Search, SlidersHorizontal } from 'lucide-react';
+import { listTickets } from '../api';
+import { useApp } from '../store';
+import type { Ticket } from '../types';
+import { cost, overdue } from '../lib/format';
+import { Badge, Empty, ErrorMessage, Loading, PageTitle, Panel, TicketsTable } from '../components/ui';
+
+export function TicketList({ mode }: { mode: 'mine' | 'inbox' }) {
+  const { catalog, userId, revision } = useApp(); const [params, setParams] = useSearchParams();
+  const [tickets, setTickets] = useState<Ticket[]>([]); const [loading, setLoading] = useState(true); const [error, setError] = useState(''); const [sort, setSort] = useState('date');
+  useEffect(() => { let live = true; setLoading(true); setError(''); listTickets(userId).then(t => { if (live) setTickets(t); }).catch(e => { if (live) setError(e.message); }).finally(() => { if (live) setLoading(false); }); return () => { live = false; }; }, [userId, revision]);
+  const set = (key: string, value: string) => { const next = new URLSearchParams(params); if (value) next.set(key, value); else next.delete(key); setParams(next); };
+  const tab = params.get('tab') || 'Все'; const search = params.get('search') || '';
+  const filtered = useMemo(() => tickets.filter(t =>
+    (!search || `${t.id} ${t.title} ${t.text}`.toLowerCase().includes(search.toLowerCase())) &&
+    (!params.get('department') || t.targetDepartment === params.get('department')) &&
+    (!params.get('category') || t.category === params.get('category')) &&
+    (!params.get('status') || t.status === params.get('status')) &&
+    (!params.get('priority') || t.priority === params.get('priority')) &&
+    (!params.get('deadline') || (params.get('deadline') === 'overdue' ? overdue(t) : !overdue(t) && !['Реализовано', 'Закрыто', 'Отклонено'].includes(t.status) && new Date(t.dueAt).getTime() - Date.now() < 3 * 86400000)) &&
+    (tab === 'Все' || (tab === 'Новые' ? t.status === 'Новое' : tab === 'Просрочены' ? overdue(t) : tab === 'Ждут уточнения' ? t.status === 'Ожидает уточнения' : t.status === 'В работе' || t.status === 'Возвращено автором'))
+  ).sort((a, b) => sort === 'cost' ? cost(b) - cost(a) : sort === 'deadline' ? a.dueAt.localeCompare(b.dueAt) : b.createdAt.localeCompare(a.createdAt)), [tickets, params, search, tab, sort]);
+  if (!catalog) return null;
+  const actionTickets = tickets.filter(t => t.authorId === userId && ['Ожидает уточнения', 'Реализовано'].includes(t.status));
+  return <><PageTitle title={mode === 'mine' ? 'Мои обращения' : 'Входящие'} subtitle={mode === 'mine' ? 'Ваши обращения и проблемы, к которым вы присоединились' : 'Обращения, назначенные вам и вашему подразделению'} action={mode === 'mine' ? <Link className="button primary" to="/new"><Plus size={17}/>Новое обращение</Link> : <div className="quiet-label"><Clock3 size={16}/>Сроки в рабочих днях</div>}/>
+    {mode === 'mine' && actionTickets.length > 0 && <section className="action-needed"><div className="section-label"><Clock3 size={16}/><strong>Требуют вашего действия</strong><span className="count">{actionTickets.length}</span></div><div className="action-needed-items">{actionTickets.map(t => <Link to={`/tickets/${t.id}`} key={t.id}><div><span className="mono">{t.id}</span><strong>{t.title}</strong><small>{t.status === 'Реализовано' ? 'Проверьте и подтвердите результат' : 'Ответственный запросил уточнение'}</small></div><ArrowRight size={18}/></Link>)}</div></section>}
+    <Panel><div className="list-tabs" role="group" aria-label="Быстрые фильтры">{(mode === 'mine' ? ['Все', 'В работе', 'Ждут уточнения'] : ['Все', 'Новые', 'Просрочены', 'Ждут уточнения', 'В работе']).map(name => <button key={name} className={`${tab === name ? 'active' : ''} ${name === 'Просрочены' ? 'amber-tab' : ''}`} onClick={() => set('tab', name)}>{name}<span>{tickets.filter(t => name === 'Все' || (name === 'Новые' ? t.status === 'Новое' : name === 'Просрочены' ? overdue(t) : name === 'Ждут уточнения' ? t.status === 'Ожидает уточнения' : ['В работе', 'Возвращено автором'].includes(t.status))).length}</span></button>)}</div>
+      <div className="filters"><div className="search-field"><Search size={16}/><input aria-label="Поиск в списке" placeholder="Поиск по ID или тексту" value={search} onChange={e => set('search', e.target.value)}/></div>
+      {mode === 'inbox' && <><select aria-label="Подразделение проблемы" value={params.get('department') || ''} onChange={e => set('department', e.target.value)}><option value="">Все подразделения</option>{catalog.departments.map(d => <option key={d}>{d}</option>)}</select><select aria-label="Категория" value={params.get('category') || ''} onChange={e => set('category', e.target.value)}><option value="">Все категории</option>{catalog.categories.map(c => <option key={c}>{c}</option>)}</select></>}
+      <select aria-label="Статус" value={params.get('status') || ''} onChange={e => set('status', e.target.value)}><option value="">Все статусы</option>{catalog.statuses.map(s => <option key={s}>{s}</option>)}</select>
+      {mode === 'inbox' && <><select aria-label="Приоритет" value={params.get('priority') || ''} onChange={e => set('priority', e.target.value)}><option value="">Приоритет</option>{['Высокий', 'Средний', 'Низкий'].map(s => <option key={s}>{s}</option>)}</select><select aria-label="Срок" value={params.get('deadline') || ''} onChange={e => set('deadline', e.target.value)}><option value="">Любой срок</option><option value="overdue">Просрочены</option><option value="soon">До 3 дней</option></select></>}
+      {params.size > 0 && <button className="text-button" onClick={() => setParams({})}>Сбросить</button>}</div>
+      <div className="table-toolbar"><span><SlidersHorizontal size={14}/>Найдено: <strong className="mono">{filtered.length}</strong></span><label><ArrowDownWideNarrow size={15}/><select aria-label="Сортировка" value={sort} onChange={e => setSort(e.target.value)}><option value="date">Сначала новые</option><option value="deadline">По сроку решения</option>{mode === 'inbox' && <option value="cost">По стоимости проблемы</option>}</select></label></div>
+      <ErrorMessage text={error}/>{loading ? <Loading/> : tickets.length ? <TicketsTable tickets={filtered} users={catalog.users} showCost={mode === 'inbox'}/> : <Empty><Link to="/new">Создать обращение</Link></Empty>}
+      <div className="table-footer"><span>Показано {filtered.length} из {tickets.length}</span><span>{mode === 'mine' ? 'Свои и присоединённые обращения' : 'Личные назначения и подразделение ответственного'}</span></div>
+    </Panel><div className="list-note"><Badge status="Реализовано"/><span>После реализации автор подтверждает результат. Только тогда обращение закрывается.</span></div>
+  </>;
+}
diff --git a/frontend/src/store.ts b/frontend/src/store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..21cb132309b207e73fee6b1dc271e396e4533e13
--- /dev/null
+++ b/frontend/src/store.ts
@@ -0,0 +1,17 @@
+import { create } from 'zustand';
+import type { Catalog, Role } from './types';
+import { getCatalog } from './api';
+interface AppState {
+  catalog: Catalog | null; userId: string; revision: number; notice: string;
+  load: () => Promise<void>; selectUser: (id: string) => void; selectRole: (role: Role) => void;
+  refresh: () => Promise<void>; notify: (text: string) => void;
+}
+const stored = localStorage.getItem('signal-user') || 'employee-1';
+export const useApp = create<AppState>((set, get) => ({
+  catalog: null, userId: stored, revision: 0, notice: '',
+  load: async () => { const catalog = await getCatalog(); const userId = catalog.users.some(u => u.id === get().userId) ? get().userId : catalog.users[0].id; set({ catalog, userId }); },
+  selectUser: userId => { localStorage.setItem('signal-user', userId); set({ userId }); },
+  selectRole: role => { const target = get().catalog?.users.find(u => u.role === role); if (target) get().selectUser(target.id); },
+  refresh: async () => { const catalog = await getCatalog(); set(s => ({ catalog, revision: s.revision + 1 })); },
+  notify: notice => set({ notice })
+}));
diff --git a/frontend/src/styles.css b/frontend/src/styles.css
new file mode 100644
index 0000000000000000000000000000000000000000..d95aee1f582eb3e7ff58d7fbe947e9e3dc90d795
--- /dev/null
+++ b/frontend/src/styles.css
@@ -0,0 +1,331 @@
+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+:root { font-family: 'Golos Text', sans-serif; color: #263342; background: #F5F6F8; font-size: 13px; font-synthesis: none; text-rendering: optimizeLegibility; -webkit-font-smoothing: antialiased; font-weight: 400; }
+* { box-sizing: border-box; }
+body { margin: 0; }
+button, input, textarea, select { font: inherit; }
+button, .button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 33px; padding: 7px 12px; border: 1px solid #DDE1E6; border-radius: 4px; background: white; color: #34465B; font-weight: 500; cursor: pointer; line-height: 1.25; text-decoration: none; transition: background-color .12s; }
+button:hover, .button:hover { background: #F0F3F7; border-color: #BFC9D5; }
+button:disabled { opacity: .5; cursor: default; }
+button.primary, .button.primary { background: #2457A6; border-color: #2457A6; color: white; }
+button.primary:hover, .button.primary:hover { background: #1E4889; }
+:focus-visible { outline: 2px solid #487DBE; outline-offset: 3px; }
+a { color: #2457A6; text-decoration: none; }
+a:hover { text-decoration: underline; }
+h1, h2, h3, p, dl { margin: 0; }
+h1 { font-size: 25px; font-weight: 600; letter-spacing: -.6px; line-height: 1.35; color: #202F42; }
+h2 { font-size: 14px; font-weight: 600; line-height: 1.5; }
+h3 { font-size: 13px; font-weight: 500; margin-bottom: 8px; line-height: 1.5; }
+p { line-height: 1.7; margin-bottom: 12px; }
+p:last-child { margin-bottom: 0; }
+small { font-size: 11px; line-height: 1.55; color: #7A8491; }
+svg { flex-shrink: 0; stroke-width: 1.65; }
+.mono, .numeric { font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums; }
+.numeric { text-align: right; }
+.muted { color: #778290; }
+.small { font-size: 12px; }
+.steel { color: #1E3A5F; }
+.overdue { color: #B46B00; }
+.preserve { white-space: pre-wrap; overflow-wrap: anywhere; }
+.app-shell { min-height: 100vh; }
+.sidebar { position: fixed; inset: 0 auto 0 0; width: 208px; background: #1B2430; color: #B1BBC8; display: flex; flex-direction: column; padding: 26px 12px 18px; z-index: 30; }
+.brand { display: flex; gap: 11px; align-items: center; margin: 0 11px 40px; color: white; font-size: 20px; font-weight: 600; letter-spacing: 1.6px; }
+.brand:hover { text-decoration: none; }
+.brand-mark { width: 35px; height: 35px; background: #2E4056; border: 1px solid #53647A; border-radius: 4px; display: grid; place-items: center; }
+.brand small { display: block; color: #8E9CAF; font-size: 8px; font-weight: 400; letter-spacing: 1.6px; margin-top: 2px; }
+.workspace-label { font-size: 8px; letter-spacing: 1.4px; color: #748295; margin: 0 12px 13px; }
+.sidebar nav { display: flex; flex-direction: column; gap: 5px; }
+.sidebar nav a { display: flex; align-items: center; gap: 10px; min-height: 39px; padding: 9px 12px; color: #ACB8C7; border: 1px solid transparent; border-radius: 4px; font-size: 12px; }
+.sidebar nav a svg { width: 17px; height: 17px; }
+.sidebar nav a.active { background: #2A3B50; border-color: #3D526A; color: white; }
+.sidebar nav a:hover { text-decoration: none; background: #263447; color: white; }
+.sidebar nav a:last-child { margin-top: 20px; }
