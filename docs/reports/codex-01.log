+++ b/frontend/src/pages/TicketDetail.tsx
@@ -0,0 +1,50 @@
+import { useEffect, useState } from 'react';
+import { Link, useNavigate, useParams } from 'react-router-dom';
+import { ArrowLeft, Check, CheckCheck, Clock3, CornerUpLeft, MessageSquare, Paperclip, ScanSearch, Send, UserRound, Wand2 } from 'lucide-react';
+import { addComment, confirmResolution, draftResponse, getTicket, listTickets, reassign, updateStatus } from '../api';
+import { useApp } from '../store';
+import type { Status, Ticket } from '../types';
+import { businessDays, cost, date, deadline, number, overdue, terminal } from '../lib/format';
+import { Badge, ErrorMessage, Field, Loading, PageTitle, Panel } from '../components/ui';
+
+export function TicketDetail() {
+  const { id = '' } = useParams(); const navigate = useNavigate(); const { catalog, userId, revision, refresh, notify } = useApp();
+  const [t, setTicket] = useState<Ticket | null>(null); const [related, setRelated] = useState<Ticket[]>([]); const [loading, setLoading] = useState(true); const [error, setError] = useState('');
+  const [comment, setComment] = useState(''); const [status, setStatus] = useState<Status>('В работе'); const [actionText, setActionText] = useState(''); const [busy, setBusy] = useState(false); const [assignee, setAssignee] = useState(''); const [reason, setReason] = useState(''); const [returning, setReturning] = useState(false); const [returnReason, setReturnReason] = useState(''); const [draft, setDraft] = useState('');
+  useEffect(() => { let live = true; setLoading(true); setError(''); getTicket(id, userId).then(async ticket => { if (!live) return; setTicket(ticket); setAssignee(ticket.assigneeId); const list = await listTickets(userId, { cluster: ticket.clusterId }); if (live) setRelated(list); }).catch(e => { if (live) { setTicket(null); setError(e.message); } }).finally(() => { if (live) setLoading(false); }); return () => { live = false; }; }, [id, userId, revision]);
+  if (!catalog) return null;
+  const current = catalog.users.find(u => u.id === userId)!;
+  const home = current.role === 'Сотрудник' ? '/mine' : current.role === 'Руководитель' ? '/inbox' : '/routing';
+  if (loading) return <Loading/>;
+  if (!t) return <><Link className="back-link" to={home}><ArrowLeft size={15}/>Вернуться</Link><ErrorMessage text={error}/></>;
+  const manager = current.role === 'Руководитель'; const author = t.authorId === userId;
+  const owner = catalog.users.find(u => u.id === t.assigneeId)!;
+  const run = async (operation: () => Promise<unknown>, message: string) => { setBusy(true); setError(''); try { await operation(); await refresh(); notify(message); } catch (e) { setError((e as Error).message); } finally { setBusy(false); } };
+  const stageDefs = [
+    { title: 'Зарегистрировано', statuses: ['Новое'], plan: t.createdAt },
+    { title: 'Рассмотрение', statuses: ['На рассмотрении', 'Ожидает уточнения'], plan: t.responseDueAt },
+    { title: 'В работе', statuses: ['В работе', 'Возвращено автором'], plan: businessDays(new Date(t.responseDueAt), 1) },
+    { title: 'Результат', statuses: ['Реализовано', 'Отклонено'], plan: t.dueAt },
+    { title: t.status === 'Отклонено' ? 'Завершено' : 'Подтверждение', statuses: ['Закрыто'], plan: businessDays(new Date(t.dueAt), 3) }
+  ];
+  return <><Link to={home} className="back-link"><ArrowLeft size={15}/>{manager ? 'Входящие' : 'Мои обращения'}</Link><PageTitle title={t.title} subtitle={`${t.id} · ${t.type} · ${t.category}`} action={<Badge status={t.status}/>}/>
+    <Panel className="tracking-panel"><div className="tracking-summary"><div><Clock3 size={17}/><strong className={overdue(t) ? 'overdue' : ''}>{deadline(t)}</strong></div><span>Ответственный: <b>{owner.name}</b></span><span>Обещанный срок решения: <b>{date(t.dueAt)}</b></span></div><ol className="tracking">{stageDefs.map((stage, i) => { const event = t.events.find(e => e.status && stage.statuses.includes(e.status)); const fact = event?.date || (i === 4 ? t.closedAt : undefined); return <li className={fact ? 'complete' : ''} key={stage.title}><span className="track-circle">{fact ? <Check size={13}/> : i + 1}</span><div><strong>{stage.title}</strong><small>{fact ? date(fact) : `План: ${date(stage.plan)}`}</small></div></li>; })}</ol></Panel>
+    <ErrorMessage text={error}/><div className="detail-layout"><div className="detail-main">
+      {t.rejection && t.status === 'Отклонено' && <Panel title="Причина отказа"><div className="panel-body"><p>{t.rejection}</p><p className="small muted">Мотивировка сохранена в истории обращения.</p></div></Panel>}
+      {t.changed && ['Реализовано', 'Закрыто', 'Возвращено автором'].includes(t.status) && <Panel title="Что изменилось" aside={<CheckCheck size={17}/>}><div className="panel-body"><p>{t.changed}</p>{t.confirmed && <div className="success-line"><CheckCheck size={16}/>Результат подтверждён автором</div>}{author && t.status === 'Реализовано' && <div className="confirmation"><p><strong>Проверьте результат в своей работе</strong></p><div className="button-row"><button className="primary" disabled={busy} onClick={() => run(() => confirmResolution(id, true, '', userId), 'Решение подтверждено. Обращение закрыто.')}><CheckCheck size={16}/>Проблема решена</button><button disabled={busy} onClick={() => setReturning(!returning)}><CornerUpLeft size={16}/>Не решена — вернуть</button></div>{returning && <div className="return-form"><Field label="Что осталось нерешённым? *"><textarea rows={3} value={returnReason} onChange={e => setReturnReason(e.target.value)}/></Field><button disabled={busy || returnReason.trim().length < 10} onClick={() => run(() => confirmResolution(id, false, returnReason, userId), 'Обращение возвращено в работу. Срок обновлён.')} className="primary">Вернуть ответственному</button></div>}</div>}</div></Panel>}
+      <Panel title="Описание обращения"><div className="panel-body"><p className="preserve">{t.text}</p>{t.solution && <><h3>Предлагаемое решение</h3><p className="preserve">{t.solution}</p></>}{t.effect && <><h3>Ожидаемый эффект</h3><p>{t.effect}</p></>}{t.attachments.length > 0 && <div className="attachment-list">{t.attachments.map(file => <span className="file-chip" key={file}><Paperclip size={14}/>{file}<small>имя файла</small></span>)}</div>}</div></Panel>
+      <Panel title="Обсуждение" aside={<span className="mono muted">{t.comments.length}</span>}><div className="panel-body">{!t.comments.length && <p className="muted">Комментариев пока нет. Здесь можно уточнить контекст обращения.</p>}{t.comments.map(c => <article className="comment" key={c.id}><div className="comment-heading"><UserRound size={15}/><strong>{c.author}</strong><time>{date(c.date)}</time></div><p className="preserve">{c.text}</p></article>)}{author && t.status === 'Ожидает уточнения' && <div className="inline-attention"><MessageSquare size={16}/>Ответьте на запрос. Обращение вернётся на рассмотрение.</div>}<form onSubmit={e => { e.preventDefault(); run(async () => { await addComment(id, comment, userId); setComment(''); }, 'Комментарий сохранён'); }}><Field label={author && t.status === 'Ожидает уточнения' ? 'Ответ на запрос уточнения' : 'Новый комментарий'}><textarea rows={3} placeholder="Добавьте информацию по обращению…" value={comment} onChange={e => setComment(e.target.value)} required maxLength={6000}/></Field><button disabled={busy || !comment.trim()} className="primary"><Send size={15}/>Отправить</button></form></div></Panel>
+      {t.participants.length > 0 && <Panel title="Присоединились к обращению" aside={<span className="mono muted">{t.participants.length}</span>}><div className="panel-body">{t.participants.map(p => <article className="participant" key={p.userId}><strong>{catalog.users.find(u => u.id === p.userId)?.name}</strong><small>{p.department}</small><p>{p.context}</p></article>)}</div></Panel>}
+      <Panel title="История событий"><ol className="event-history">{[...t.events].reverse().map(e => <li key={e.id}><span className="history-dot"/><div><div className="between"><strong>{e.actor}</strong><time>{date(e.date)}</time></div><p>{e.text}</p></div></li>)}</ol></Panel>
+    </div><aside className="detail-aside">
+      <Panel title="Сведения"><dl className="meta-list"><dt>Автор</dt><dd>{catalog.users.find(u => u.id === t.authorId)?.name}</dd><dt>Подразделение автора</dt><dd>{t.authorDepartment}</dd><dt>К чему относится</dt><dd>{t.targetDepartment}</dd><dt>Приоритет</dt><dd>{t.priority}</dd><dt>Создано</dt><dd>{date(t.createdAt)}</dd><dt>Первый ответ</dt><dd>{t.firstResponseAt ? date(t.firstResponseAt) : `До ${date(t.responseDueAt)}`}</dd>{!t.firstResponseAt && new Date(t.responseDueAt).getTime() < Date.now() && <dd className="overdue">Первый ответ просрочен</dd>}{t.type === 'Проблема' && <><dt>Стоимость проблемы</dt><dd className="cost-number"><span className="mono">≈ {number(cost(t))}</span> чел.-ч/мес<small>{t.frequency}, {t.minutes} мин за раз · включая оценки участников</small></dd></>}</dl></Panel>
+      {manager && !terminal(t) && <Panel title="Действия ответственного"><div className="panel-body"><form onSubmit={e => { e.preventDefault(); run(async () => { await updateStatus(id, status, actionText, userId); setActionText(''); setDraft(''); }, 'Статус и история обновлены'); }}><Field label="Новый статус"><select value={status} onChange={e => { setStatus(e.target.value as Status); setDraft(''); }}>{(['На рассмотрении', 'В работе', 'Ожидает уточнения', 'Реализовано', 'Отклонено'] as Status[]).map(s => <option disabled={s === t.status} key={s}>{s}</option>)}</select></Field>
+      {status === 'Отклонено' && <Field label="Шаблон мотивировки"><select defaultValue="" onChange={e => { if (e.target.value) setActionText(e.target.value); }}><option value="">Выберите шаблон</option><option>Сейчас нет подходящего помещения. Вернёмся к вопросу при перепланировке рабочих помещений.</option><option>Реализация требует ресурсов, которые не предусмотрены в текущем плане. Повторно рассмотрим предложение в следующем квартале.</option><option>Предложенное изменение не соответствует обязательным требованиям безопасности. Предлагаем обсудить альтернативное решение.</option></select></Field>}
+      <Field label={status === 'Реализовано' ? 'Что изменилось *' : status === 'Отклонено' ? 'Мотивировка отказа *' : status === 'Ожидает уточнения' ? 'Что нужно уточнить *' : 'Комментарий к действию'}><textarea rows={5} value={actionText} onChange={e => setActionText(e.target.value)} required={['Реализовано', 'Отклонено', 'Ожидает уточнения'].includes(status)} minLength={['Реализовано', 'Отклонено', 'Ожидает уточнения'].includes(status) ? 10 : undefined}/></Field>
+      <button type="button" className="text-button" disabled={busy} onClick={() => run(async () => setDraft(await draftResponse(id, status, userId)), 'Черновик подготовлен. Проверьте и отредактируйте текст.')}><Wand2 size={15}/>Черновик ответа</button>
+      {draft && <div className="system-box"><span className="quiet-label">Автоподсказка</span><p className="small">{draft}</p><div className="button-row"><button type="button" onClick={() => { setActionText(draft); setDraft(''); }}>Принять</button><button type="button" onClick={() => setDraft('')}>Отклонить</button></div></div>}
+      <button className="primary full-width" disabled={busy || status === t.status || (['Реализовано', 'Отклонено', 'Ожидает уточнения'].includes(status) && actionText.trim().length < 10)}>Сохранить решение</button></form>
+      <hr/><form onSubmit={e => { e.preventDefault(); run(async () => { await reassign(id, assignee, reason, userId); setReason(''); navigate('/inbox'); }, 'Обращение переназначено'); }}><h3>Переназначить</h3><Field label="Новый ответственный"><select value={assignee} onChange={e => setAssignee(e.target.value)}>{catalog.users.filter(u => u.role === 'Руководитель').map(u => <option key={u.id} value={u.id} disabled={u.vacation}>{u.name}{u.vacation ? ' · в отпуске' : ''}</option>)}</select></Field><Field label="Причина переназначения *"><textarea rows={2} value={reason} onChange={e => setReason(e.target.value)} required minLength={10}/></Field><button disabled={busy || assignee === t.assigneeId || reason.trim().length < 10}>Переназначить</button></form></div></Panel>}
+      <Panel title="Связанные обращения" aside={<ScanSearch size={16}/>}><div className="panel-body"><h3>{catalog.clusters.find(c => c.id === t.clusterId)?.title}</h3><p className="small muted">Доступная вам часть кластера</p><div className="cluster-cost"><strong className="mono">≈ {number(related.reduce((sum, item) => sum + cost(item), 0))}</strong><span>чел.-ч/мес</span></div><p className="small">{[...new Set(related.flatMap(item => [item.authorDepartment, item.targetDepartment, ...item.participants.map(p => p.department)]))].join(', ')}</p>{related.filter(item => item.id !== id).slice(0, 6).map(item => <Link className="related-link" to={`/tickets/${item.id}`} key={item.id}><span className="mono">{item.id}</span>{item.title}</Link>)}{manager && <Link to={`/analytics?cluster=${t.clusterId}`} className="text-button">Весь кластер в аналитике</Link>}</div></Panel>
+    </aside></div></>;
+}
diff --git a/frontend/src/pages/TicketList.tsx b/frontend/src/pages/TicketList.tsx
new file mode 100644
