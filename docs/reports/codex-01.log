+import { useEffect, useMemo, useState } from 'react';
+import { Link, useSearchParams } from 'react-router-dom';
+import { ArrowDownWideNarrow, ArrowRight, Clock3, Plus, Search, SlidersHorizontal } from 'lucide-react';
+import { listTickets } from '../api';
+import { useApp } from '../store';
+import type { Ticket } from '../types';
+import { cost, overdue } from '../lib/format';
+import { Badge, Empty, ErrorMessage, Loading, PageTitle, Panel, TicketsTable } from '../components/ui';
+
+export function TicketList({ mode }: { mode: 'mine' | 'inbox' }) {
+  const { catalog, userId, revision } = useApp(); const [params, setParams] = useSearchParams();
+  const [tickets, setTickets] = useState<Ticket[]>([]); const [loading, setLoading] = useState(true); const [error, setError] = useState(''); const [sort, setSort] = useState('date');
+  useEffect(() => { let live = true; setLoading(true); setError(''); listTickets(userId).then(t => { if (live) setTickets(t); }).catch(e => { if (live) setError(e.message); }).finally(() => { if (live) setLoading(false); }); return () => { live = false; }; }, [userId, revision]);
+  const set = (key: string, value: string) => { const next = new URLSearchParams(params); if (value) next.set(key, value); else next.delete(key); setParams(next); };
+  const tab = params.get('tab') || 'Все'; const search = params.get('search') || '';
+  const filtered = useMemo(() => tickets.filter(t =>
+    (!search || `${t.id} ${t.title} ${t.text}`.toLowerCase().includes(search.toLowerCase())) &&
+    (!params.get('department') || t.targetDepartment === params.get('department')) &&
+    (!params.get('category') || t.category === params.get('category')) &&
+    (!params.get('status') || t.status === params.get('status')) &&
+    (!params.get('priority') || t.priority === params.get('priority')) &&
+    (!params.get('deadline') || (params.get('deadline') === 'overdue' ? overdue(t) : !overdue(t) && !['Реализовано', 'Закрыто', 'Отклонено'].includes(t.status) && new Date(t.dueAt).getTime() - Date.now() < 3 * 86400000)) &&
+    (tab === 'Все' || (tab === 'Новые' ? t.status === 'Новое' : tab === 'Просрочены' ? overdue(t) : tab === 'Ждут уточнения' ? t.status === 'Ожидает уточнения' : t.status === 'В работе' || t.status === 'Возвращено автором'))
+  ).sort((a, b) => sort === 'cost' ? cost(b) - cost(a) : sort === 'deadline' ? a.dueAt.localeCompare(b.dueAt) : b.createdAt.localeCompare(a.createdAt)), [tickets, params, search, tab, sort]);
+  if (!catalog) return null;
+  const actionTickets = tickets.filter(t => t.authorId === userId && ['Ожидает уточнения', 'Реализовано'].includes(t.status));
+  return <><PageTitle title={mode === 'mine' ? 'Мои обращения' : 'Входящие'} subtitle={mode === 'mine' ? 'Ваши обращения и проблемы, к которым вы присоединились' : 'Обращения, назначенные вам и вашему подразделению'} action={mode === 'mine' ? <Link className="button primary" to="/new"><Plus size={17}/>Новое обращение</Link> : <div className="quiet-label"><Clock3 size={16}/>Сроки в рабочих днях</div>}/>
+    {mode === 'mine' && actionTickets.length > 0 && <section className="action-needed"><div className="section-label"><Clock3 size={16}/><strong>Требуют вашего действия</strong><span className="count">{actionTickets.length}</span></div><div className="action-needed-items">{actionTickets.map(t => <Link to={`/tickets/${t.id}`} key={t.id}><div><span className="mono">{t.id}</span><strong>{t.title}</strong><small>{t.status === 'Реализовано' ? 'Проверьте и подтвердите результат' : 'Ответственный запросил уточнение'}</small></div><ArrowRight size={18}/></Link>)}</div></section>}
+    <Panel><div className="list-tabs" role="group" aria-label="Быстрые фильтры">{(mode === 'mine' ? ['Все', 'В работе', 'Ждут уточнения'] : ['Все', 'Новые', 'Просрочены', 'Ждут уточнения', 'В работе']).map(name => <button key={name} className={`${tab === name ? 'active' : ''} ${name === 'Просрочены' ? 'amber-tab' : ''}`} onClick={() => set('tab', name)}>{name}<span>{tickets.filter(t => name === 'Все' || (name === 'Новые' ? t.status === 'Новое' : name === 'Просрочены' ? overdue(t) : name === 'Ждут уточнения' ? t.status === 'Ожидает уточнения' : ['В работе', 'Возвращено автором'].includes(t.status))).length}</span></button>)}</div>
+      <div className="filters"><div className="search-field"><Search size={16}/><input aria-label="Поиск в списке" placeholder="Поиск по ID или тексту" value={search} onChange={e => set('search', e.target.value)}/></div>
+      {mode === 'inbox' && <><select aria-label="Подразделение проблемы" value={params.get('department') || ''} onChange={e => set('department', e.target.value)}><option value="">Все подразделения</option>{catalog.departments.map(d => <option key={d}>{d}</option>)}</select><select aria-label="Категория" value={params.get('category') || ''} onChange={e => set('category', e.target.value)}><option value="">Все категории</option>{catalog.categories.map(c => <option key={c}>{c}</option>)}</select></>}
+      <select aria-label="Статус" value={params.get('status') || ''} onChange={e => set('status', e.target.value)}><option value="">Все статусы</option>{catalog.statuses.map(s => <option key={s}>{s}</option>)}</select>
+      {mode === 'inbox' && <><select aria-label="Приоритет" value={params.get('priority') || ''} onChange={e => set('priority', e.target.value)}><option value="">Приоритет</option>{['Высокий', 'Средний', 'Низкий'].map(s => <option key={s}>{s}</option>)}</select><select aria-label="Срок" value={params.get('deadline') || ''} onChange={e => set('deadline', e.target.value)}><option value="">Любой срок</option><option value="overdue">Просрочены</option><option value="soon">До 3 дней</option></select></>}
+      {params.size > 0 && <button className="text-button" onClick={() => setParams({})}>Сбросить</button>}</div>
+      <div className="table-toolbar"><span><SlidersHorizontal size={14}/>Найдено: <strong className="mono">{filtered.length}</strong></span><label><ArrowDownWideNarrow size={15}/><select aria-label="Сортировка" value={sort} onChange={e => setSort(e.target.value)}><option value="date">Сначала новые</option><option value="deadline">По сроку решения</option>{mode === 'inbox' && <option value="cost">По стоимости проблемы</option>}</select></label></div>
+      <ErrorMessage text={error}/>{loading ? <Loading/> : tickets.length ? <TicketsTable tickets={filtered} users={catalog.users} showCost={mode === 'inbox'}/> : <Empty><Link to="/new">Создать обращение</Link></Empty>}
+      <div className="table-footer"><span>Показано {filtered.length} из {tickets.length}</span><span>{mode === 'mine' ? 'Свои и присоединённые обращения' : 'Личные назначения и подразделение ответственного'}</span></div>
+    </Panel><div className="list-note"><Badge status="Реализовано"/><span>После реализации автор подтверждает результат. Только тогда обращение закрывается.</span></div>
+  </>;
+}
diff --git a/frontend/src/store.ts b/frontend/src/store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..21cb132309b207e73fee6b1dc271e396e4533e13
--- /dev/null
+++ b/frontend/src/store.ts
@@ -0,0 +1,17 @@
+import { create } from 'zustand';
+import type { Catalog, Role } from './types';
+import { getCatalog } from './api';
+interface AppState {
+  catalog: Catalog | null; userId: string; revision: number; notice: string;
+  load: () => Promise<void>; selectUser: (id: string) => void; selectRole: (role: Role) => void;
+  refresh: () => Promise<void>; notify: (text: string) => void;
+}
+const stored = localStorage.getItem('signal-user') || 'employee-1';
+export const useApp = create<AppState>((set, get) => ({
+  catalog: null, userId: stored, revision: 0, notice: '',
+  load: async () => { const catalog = await getCatalog(); const userId = catalog.users.some(u => u.id === get().userId) ? get().userId : catalog.users[0].id; set({ catalog, userId }); },
+  selectUser: userId => { localStorage.setItem('signal-user', userId); set({ userId }); },
+  selectRole: role => { const target = get().catalog?.users.find(u => u.role === role); if (target) get().selectUser(target.id); },
+  refresh: async () => { const catalog = await getCatalog(); set(s => ({ catalog, revision: s.revision + 1 })); },
+  notify: notice => set({ notice })
+}));
diff --git a/frontend/src/styles.css b/frontend/src/styles.css
new file mode 100644
index 0000000000000000000000000000000000000000..d95aee1f582eb3e7ff58d7fbe947e9e3dc90d795
--- /dev/null
+++ b/frontend/src/styles.css
@@ -0,0 +1,331 @@
+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+:root { font-family: 'Golos Text', sans-serif; color: #263342; background: #F5F6F8; font-size: 13px; font-synthesis: none; text-rendering: optimizeLegibility; -webkit-font-smoothing: antialiased; font-weight: 400; }
+* { box-sizing: border-box; }
+body { margin: 0; }
+button, input, textarea, select { font: inherit; }
+button, .button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 33px; padding: 7px 12px; border: 1px solid #DDE1E6; border-radius: 4px; background: white; color: #34465B; font-weight: 500; cursor: pointer; line-height: 1.25; text-decoration: none; transition: background-color .12s; }
+button:hover, .button:hover { background: #F0F3F7; border-color: #BFC9D5; }
+button:disabled { opacity: .5; cursor: default; }
+button.primary, .button.primary { background: #2457A6; border-color: #2457A6; color: white; }
+button.primary:hover, .button.primary:hover { background: #1E4889; }
+:focus-visible { outline: 2px solid #487DBE; outline-offset: 3px; }
+a { color: #2457A6; text-decoration: none; }
+a:hover { text-decoration: underline; }
+h1, h2, h3, p, dl { margin: 0; }
+h1 { font-size: 25px; font-weight: 600; letter-spacing: -.6px; line-height: 1.35; color: #202F42; }
+h2 { font-size: 14px; font-weight: 600; line-height: 1.5; }
+h3 { font-size: 13px; font-weight: 500; margin-bottom: 8px; line-height: 1.5; }
+p { line-height: 1.7; margin-bottom: 12px; }
+p:last-child { margin-bottom: 0; }
+small { font-size: 11px; line-height: 1.55; color: #7A8491; }
+svg { flex-shrink: 0; stroke-width: 1.65; }
+.mono, .numeric { font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums; }
+.numeric { text-align: right; }
+.muted { color: #778290; }
+.small { font-size: 12px; }
+.steel { color: #1E3A5F; }
+.overdue { color: #B46B00; }
+.preserve { white-space: pre-wrap; overflow-wrap: anywhere; }
+.app-shell { min-height: 100vh; }
+.sidebar { position: fixed; inset: 0 auto 0 0; width: 208px; background: #1B2430; color: #B1BBC8; display: flex; flex-direction: column; padding: 26px 12px 18px; z-index: 30; }
+.brand { display: flex; gap: 11px; align-items: center; margin: 0 11px 40px; color: white; font-size: 20px; font-weight: 600; letter-spacing: 1.6px; }
+.brand:hover { text-decoration: none; }
+.brand-mark { width: 35px; height: 35px; background: #2E4056; border: 1px solid #53647A; border-radius: 4px; display: grid; place-items: center; }
+.brand small { display: block; color: #8E9CAF; font-size: 8px; font-weight: 400; letter-spacing: 1.6px; margin-top: 2px; }
+.workspace-label { font-size: 8px; letter-spacing: 1.4px; color: #748295; margin: 0 12px 13px; }
+.sidebar nav { display: flex; flex-direction: column; gap: 5px; }
+.sidebar nav a { display: flex; align-items: center; gap: 10px; min-height: 39px; padding: 9px 12px; color: #ACB8C7; border: 1px solid transparent; border-radius: 4px; font-size: 12px; }
+.sidebar nav a svg { width: 17px; height: 17px; }
+.sidebar nav a.active { background: #2A3B50; border-color: #3D526A; color: white; }
+.sidebar nav a:hover { text-decoration: none; background: #263447; color: white; }
+.sidebar nav a:last-child { margin-top: 20px; }
+.nav-end { margin-left: auto; width: 12px !important; color: #7D8C9F; }
+.sidebar-bottom { margin-top: auto; }
+.security-note { display: flex; gap: 9px; margin: 22px 12px; align-items: flex-start; font-size: 11px; }
+.security-note svg { color: #91A6B6; }
+.security-note small { display: block; font-size: 10px; margin-top: 4px; color: #738397; }
+.sidebar-bottom button { border-color: #344151; background: transparent; color: #94A3B6; width: 100%; font-size: 10px; padding-inline: 7px; }
+.sidebar-bottom button:hover { color: white; background: #263447; }
+.version { display: block; text-align: center; color: #617186; font-size: 8px; letter-spacing: 1.1px; margin-top: 18px; }
+.app-content { margin-left: 208px; min-height: 100vh; display: flex; flex-direction: column; }
+.topbar { display: flex; align-items: center; min-height: 65px; border-bottom: 1px solid #DDE1E6; padding: 0 28px; background: #fff; gap: 22px; }
+.global-search { display: flex; align-items: center; color: #8B95A3; flex: 1; max-width: 620px; gap: 10px; min-width: 150px; }
+.global-search input { border: 0; outline: 0; width: 100%; padding: 8px 0; font-size: 12px; }
+.global-search kbd { border: 1px solid #E1E6EB; border-radius: 3px; padding: 1px 4px; font-family: inherit; font-size: 9px; color: #A0A8B2; }
+.demo-role { display: flex; align-items: center; gap: 7px; margin-left: auto; padding-left: 17px; border-left: 1px solid #E6E9ED; white-space: nowrap; }
+.demo-role > span { color: #8A94A0; font-size: 10px; }
+.demo-role select { min-height: 30px; font-size: 11px; padding-right: 20px; width: 132px; }
+.user-select { display: flex; align-items: center; gap: 8px; min-width: 0; }
+.avatar { display: grid; place-items: center; background: #EBEFF4; color: #51657C; border: 1px solid #DAE1E8; width: 30px; height: 30px; border-radius: 4px; font-size: 10px; }
+.user-select select { border: 0; background: transparent; width: 172px; appearance: none; font-size: 11px; padding-inline: 0; }
+.user-select > svg { color: #7A8794; }
+main { flex: 1; padding: 0 28px 30px; max-width: 1770px; width: 100%; margin: 0 auto; }
+.breadcrumb { display: flex; align-items: center; gap: 11px; color: #929AA6; font-size: 10px; height: 51px; }
+.breadcrumb > span:last-of-type { color: #637182; }
+.prototype-label { display: flex; align-items: center; gap: 5px; margin-left: auto; color: #8D98A5; font-size: 9px; }
+.page-title { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin: 8px 0 23px; }
+.page-title p { margin-top: 7px; font-size: 12px; color: #7A8593; }
+.page-title > .badge { flex-shrink: 0; }
+.panel { background: #fff; border: 1px solid #DDE1E6; border-radius: 4px; overflow: hidden; margin-bottom: 20px; }
+.panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 49px; padding: 13px 18px; border-bottom: 1px solid #E5E9ED; }
+.panel-heading > svg { color: #7D8D9E; }
+.panel-body { padding: 18px; }
+.quiet-label { display: inline-flex; align-items: center; gap: 6px; font-size: 10px; color: #7B8795; font-weight: 400; }
+.badge { display: inline-flex; align-items: center; gap: 5px; border: 1px solid; padding: 3px 6px; line-height: 1.1; font-size: 9px; white-space: nowrap; border-radius: 3px; font-weight: 400; }
+.badge.blue { background: #F0F5FA; border-color: #D4DFEB; color: #486786; }
+.badge.success { background: #F1F6F3; border-color: #D1E1D8; color: #50765E; }
+.badge.attention { background: #FFF8EB; border-color: #EBD9B6; color: #9C6E22; }
+.badge.muted { background: #F3F4F6; border-color: #DDE1E6; color: #77818B; }
+.status-dot { width: 4px; height: 4px; border-radius: 2px; background: currentColor; }
+.action-needed { border: 1px solid #EAD8B6; border-left: 3px solid #C77700; border-radius: 4px; background: #FFFCF6; padding: 15px 17px; margin: 0 0 22px; }
+.section-label { display: flex; align-items: center; gap: 8px; font-size: 12px; }
+.section-label svg { color: #6E7D8D; }
+.action-needed .section-label svg { color: #AF751F; }
+.count { padding: 1px 5px; font-size: 10px; border: 1px solid #E2D3B6; border-radius: 3px; margin-left: 2px; color: #9C702E; }
+.action-needed-items { display: flex; flex-wrap: wrap; gap: 12px 22px; margin-top: 12px; }
+.action-needed-items a { flex: 1 1 240px; display: flex; align-items: center; justify-content: space-between; color: #3A4A5C; font-size: 12px; }
+.action-needed-items .mono { font-size: 10px; color: #9C804D; margin-right: 8px; }
+.action-needed-items strong { font-weight: 400; }
+.action-needed-items small { display: block; margin: 4px 0 0 45px; color: #9A8A6C; }
+.list-tabs { display: flex; padding: 0 18px; gap: 23px; border-bottom: 1px solid #DDE1E6; overflow-x: auto; }
+.list-tabs button { min-height: 47px; border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: transparent; font-size: 11px; padding: 10px 0; color: #7D8793; white-space: nowrap; }
+.list-tabs button.active { border-bottom-color: #2457A6; color: #2457A6; }
+.list-tabs button span { background: #F0F2F5; font-size: 9px; padding: 2px 5px; border-radius: 3px; }
+.list-tabs button.amber-tab { color: #B1741C; }
+.list-tabs button.amber-tab.active { border-bottom-color: #C77700; }
+.filters { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 15px 18px; border-bottom: 1px solid #E6E9ED; }
+input, textarea, select { border: 1px solid #D7DDE4; color: #344356; border-radius: 4px; background: white; padding: 8px 10px; width: 100%; min-height: 34px; }
+input::placeholder, textarea::placeholder { color: #9CA5B1; }
+textarea { resize: vertical; line-height: 1.65; }
+select { cursor: pointer; padding-right: 23px; }
+.filters select { width: auto; max-width: 230px; font-size: 10px; min-height: 32px; }
+.search-field { display: flex; align-items: center; border: 1px solid #D7DDE4; border-radius: 4px; padding-left: 9px; color: #9BA4B0; flex: 1; min-width: 170px; max-width: 300px; }
+.search-field input { border: 0; min-height: 30px; font-size: 11px; outline: 0; background: transparent; }
+.table-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 10px 18px; font-size: 10px; color: #8A94A0; }
+.table-toolbar > span, .table-toolbar label { display: flex; align-items: center; gap: 7px; }
+.table-toolbar strong { color: #4A596A; font-size: 10px; font-weight: 400; }
+.table-toolbar select { border: 0; font-size: 10px; min-height: 20px; padding-block: 2px; width: auto; }
+.table-wrap { overflow-x: auto; }
+table { width: 100%; border-collapse: collapse; text-align: left; font-size: 11px; }
+thead { background: #F8F9FB; color: #83909D; font-size: 9px; font-weight: 400; }
+th { font-weight: 400; padding: 11px 14px; border-bottom: 1px solid #DDE1E6; white-space: nowrap; }
+td { padding: 7px 14px; height: 44px; border-bottom: 1px solid #EDF0F3; vertical-align: middle; }
+tbody tr:last-child td { border-bottom: 0; }
+tbody tr:hover { background: #F9FBFD; }
+td strong { font-weight: 500; }
+td small { display: block; font-size: 9px; margin-top: 3px; }
+.ticket-link { display: flex; align-items: center; gap: 9px; color: #34465B; font-weight: 500; font-size: 10px; }
+.ticket-link > span:last-child { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 280px; }
+.ticket-id { color: #8292A2; font-size: 9px; white-space: nowrap; font-weight: 400; }
+.ticket-meta { font-size: 8px; color: #97A0AB; margin-left: 45px; white-space: nowrap; }
+.person-cell { max-width: 125px; font-size: 9px; line-height: 1.6; }
+.tickets-table td { font-size: 9px; padding-inline: 10px; height: 44px; }
+.tickets-table th { padding-inline: 10px; }
+.event-cell { max-width: 140px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.event-cell > small { overflow: hidden; }
+.table-footer { display: flex; justify-content: space-between; gap: 12px; padding: 11px 18px; color: #929CA8; font-size: 9px; border-top: 1px solid #E6E9ED; }
+.list-note { display: flex; align-items: center; gap: 9px; color: #929CA8; font-size: 10px; }
+.footer { display: flex; justify-content: space-between; padding: 16px 28px; border-top: 1px solid #E1E5EA; color: #98A1AC; font-size: 9px; }
+.back-link { display: inline-flex; align-items: center; gap: 6px; color: #7E8B9A; font-size: 11px; margin: 3px 0 14px; }
+.compose-layout { display: grid; grid-template-columns: minmax(0, 1fr) 305px; gap: 22px; align-items: start; }
+.compose-form > .panel-body { padding: 22px; }
+.field { display: flex; flex-direction: column; gap: 7px; margin-bottom: 18px; width: 100%; }
+.field > span, .type-field legend { font-size: 11px; font-weight: 500; color: #536375; }
+.field > small { font-size: 10px; }
+.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
+.type-field { border: 0; padding: 0; margin: 0 0 22px; }
+.type-field legend { margin-bottom: 9px; }
+.segmented { display: flex; gap: 0; }
+.segmented button { border-radius: 0; border-right: 0; flex: 1; font-size: 11px; white-space: nowrap; }
+.segmented button:first-child { border-radius: 4px 0 0 4px; }
+.segmented button:last-child { border-radius: 0 4px 4px 0; border-right: 1px solid #DDE1E6; }
+.segmented button.selected { background: #EDF3FA; color: #2457A6; border-color: #9DB6D6; }
+.segmented button.selected + button { border-left-color: #9DB6D6; }
+.segmented.compact button { padding: 7px 13px; font-size: 10px; }
+.structure-button { display: flex; align-items: center; gap: 12px; margin: -4px 0 22px; }
+.structure-button button { color: #496582; font-size: 11px; }
+.structure-button small { font-size: 9px; }
+.system-box { background: #F4F7FA; border: 1px solid #D9E2EB; padding: 14px; border-radius: 4px; margin: 12px 0 18px; }
+.system-box p { margin-top: 8px; }
+.structure { margin-top: 14px; }
+.structure dt { font-size: 10px; color: #788798; margin-bottom: 4px; }
+.structure dd { font-size: 11px; line-height: 1.6; margin: 0 0 12px; }
+.attachment-row { display: flex; align-items: center; gap: 12px; margin: 4px 0 18px; }
+.attachment-row .button { font-size: 10px; }
+.attachment-row small { font-size: 9px; }
+.file-chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 7px; background: #F4F6F8; border: 1px solid #E0E5EA; border-radius: 3px; font-size: 10px; margin: 0 6px 9px 0; max-width: 100%; overflow-wrap: anywhere; }
+.cost-box { border-top: 1px solid #E3E8ED; border-bottom: 1px solid #E3E8ED; padding: 20px 0; margin: 12px 0 22px; }
+.cost-box p { font-size: 11px; color: #8A94A0; margin: 7px 0 17px; }
+.cost-result { color: #7D8997; font-size: 11px; }
+.cost-result strong { font-size: 15px; font-weight: 400; color: #1E3A5F; margin-inline: 4px; }
+.cost-result small { display: block; margin-top: 6px; }
+.route-preview { display: flex; align-items: flex-start; gap: 11px; border: 1px solid #DDE5ED; border-radius: 4px; padding: 14px; background: #F7F9FC; margin: 10px 0 22px; }
+.route-preview > svg { color: #5D7898; margin-top: 2px; }
+.route-preview strong { font-size: 11px; font-weight: 500; }
+.route-preview p { font-size: 10px; color: #748292; margin: 5px 0 2px; }
+.route-preview p.overdue { color: #B46B00; }
+.route-preview small { font-size: 9px; }
+.form-footer { display: flex; justify-content: space-between; border-top: 1px solid #E7EBEF; padding-top: 18px; }
+.similar-panel .panel-body { padding: 15px; }
+.similar-card { border-top: 1px solid #E4E8ED; padding: 16px 0 0; margin-top: 17px; }
+.similar-card h3 { margin-top: 10px; font-size: 12px; }
+.similar-card p { font-size: 10px; }
+.similar-card .badge { font-size: 8px; }
+.similar-card .text-button { margin-top: 9px; font-size: 10px; justify-content: flex-start; text-align: left; line-height: 1.6; }
+.join-form { margin-top: 13px; border-left: 2px solid #CBD9E7; padding-left: 12px; }
+.privacy-note { padding: 0 12px; font-size: 10px; color: #8B96A2; }
+.privacy-note strong { color: #637487; font-weight: 500; }
+.privacy-note p { margin-top: 8px; }
+.text-button { display: inline-flex; align-items: center; gap: 5px; min-height: 24px; padding: 0; border: 0; background: transparent; color: #2457A6; font-size: 11px; font-weight: 400; cursor: pointer; }
+.text-button:hover { background: transparent; text-decoration: underline; }
+.icon-button { border: 0; background: transparent; padding: 4px; min-height: 24px; color: #7B8A9B; border-radius: 3px; }
+.button-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
+.empty { min-height: 135px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; padding: 25px; text-align: center; color: #96A2AF; }
+.empty strong { font-size: 11px; font-weight: 400; }
+.loading { display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 100px; color: #8693A2; font-size: 12px; }
+.spin { animation: spin 1s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+@media (prefers-reduced-motion: reduce) { .spin { animation: none; } * { transition: none !important; } }
+.error { color: #9C432F; background: #FFF5F2; border: 1px solid #E9CFC6; border-radius: 4px; padding: 12px; font-size: 12px; margin: 12px 0; }
+.tracking-panel { margin-bottom: 22px; }
+.tracking-summary { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 14px 18px; border-bottom: 1px solid #E5E9EE; font-size: 10px; color: #7A8796; }
+.tracking-summary > div { display: flex; align-items: center; gap: 7px; color: #4C6886; }
+.tracking-summary b { font-weight: 500; color: #536579; }
+.tracking { display: flex; padding: 23px 22px; list-style: none; }
+.tracking li { display: flex; align-items: flex-start; gap: 9px; flex: 1; position: relative; }
+.tracking li:not(:last-child)::after { content: ''; position: absolute; height: 1px; background: #DDE4EB; top: 11px; left: 27px; right: 6px; }
+.track-circle { width: 23px; height: 23px; border-radius: 4px; border: 1px solid #CCD7E2; background: #F7F9FB; color: #8E9CAC; display: grid; place-items: center; font-family: 'JetBrains Mono', monospace; font-size: 10px; flex-shrink: 0; position: relative; z-index: 1; }
+.tracking li.complete .track-circle { background: #1E3A5F; border-color: #1E3A5F; color: white; }
+.tracking li > div { background: white; z-index: 1; padding-right: 9px; }
+.tracking strong { font-weight: 500; font-size: 10px; display: block; margin: 3px 0 5px; }
+.tracking small { display: block; font-size: 9px; }
+.detail-layout { display: grid; grid-template-columns: minmax(0, 1fr) 310px; gap: 22px; align-items: start; }
+.detail-main .panel-body { font-size: 12px; }
+.detail-aside .panel-body { padding: 16px; }
+.meta-list { padding: 16px 18px; }
+.meta-list dt { font-size: 10px; color: #9AA4AE; margin: 0 0 5px; }
+.meta-list dd { margin: 0 0 17px; font-size: 11px; color: #526375; }
+.meta-list dd:last-child { margin-bottom: 0; }
+.meta-list dd small { display: block; margin-top: 6px; font-size: 9px; }
+.cost-number > span { color: #1E3A5F; font-size: 17px; }
+.comment { border-bottom: 1px solid #EDF0F3; padding: 0 0 15px; margin-bottom: 17px; }
+.comment-heading { display: flex; align-items: center; gap: 7px; font-size: 10px; color: #738499; margin-bottom: 7px; }
+.comment-heading strong { font-weight: 500; }
+.comment-heading time { margin-left: auto; font-size: 9px; color: #9AA4AF; }
+.comment p { font-size: 12px; }
+.event-history { list-style: none; padding: 20px; margin: 0; }
+.event-history li { display: flex; gap: 14px; font-size: 11px; padding-bottom: 22px; position: relative; }
+.event-history li:last-child { padding-bottom: 0; }
+.event-history li:not(:last-child)::before { content: ''; position: absolute; left: 3px; top: 9px; bottom: 0; width: 1px; background: #DDE5ED; }
+.history-dot { width: 7px; height: 7px; border: 1px solid #9AAEC3; background: white; border-radius: 2px; margin-top: 4px; flex-shrink: 0; z-index: 1; }
+.event-history li > div { flex: 1; }
+.event-history strong { font-size: 10px; font-weight: 500; color: #6D7E91; }
+.event-history time { font-size: 9px; color: #9DA6B1; }
+.event-history p { font-size: 11px; color: #85919D; margin-top: 5px; }
+.between { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+.full-width { width: 100%; margin-top: 15px; }
+hr { border: 0; border-top: 1px solid #E5EAF0; margin: 23px 0 18px; }
+.inline-attention { display: flex; align-items: center; gap: 8px; background: #FFF9ED; color: #9B752E; font-size: 11px; padding: 12px; margin-bottom: 16px; border: 1px solid #EBDDBE; border-radius: 4px; }
+.confirmation { margin-top: 20px; border-top: 1px solid #E3E9EE; padding-top: 15px; }
+.success-line { display: flex; align-items: center; gap: 7px; color: #4F7B60; font-size: 11px; margin-top: 15px; }
+.return-form { margin-top: 18px; }
+.cluster-cost { display: flex; align-items: baseline; gap: 7px; margin: 16px 0 9px; }
+.cluster-cost strong { color: #1E3A5F; font-size: 22px; font-weight: 400; }
+.cluster-cost span { font-size: 10px; color: #8A95A2; }
+.related-link { display: block; padding: 11px 0; border-top: 1px solid #E7ECF0; font-size: 10px; line-height: 1.65; }
+.related-link span { color: #8B9BAD; margin-right: 7px; }
+.participant { border-bottom: 1px solid #E8EDF1; margin-bottom: 13px; padding-bottom: 13px; font-size: 11px; }
+.participant:last-child { border: 0; margin: 0; padding: 0; }
+.participant small { margin-left: 10px; font-size: 9px; }
+.participant p { margin-top: 7px; color: #7F8C99; font-size: 11px; }
+.done-intro { display: flex; align-items: center; gap: 15px; border: 1px solid #D5E0D9; border-radius: 4px; padding: 20px; background: #F1F6F3; color: #527460; margin-bottom: 25px; }
+.done-intro strong { font-size: 13px; font-weight: 500; }
+.done-intro p { font-size: 11px; margin-top: 6px; color: #7D9585; }
+.improvements-feed { max-width: 1120px; }
+.improvement-top { display: flex; align-items: center; gap: 14px; border-bottom: 1px solid #E8EDF1; padding: 12px 18px; font-size: 10px; color: #7D8B9B; }
+.improvement-top time { margin-left: auto; color: #99A3AE; }
+.before-after { display: grid; grid-template-columns: 1fr 20px 1fr; gap: 22px; align-items: start; margin-top: 20px; font-size: 11px; }
+.before-after > svg { color: #9AACBD; margin-top: 25px; }
+.eyebrow { color: #9AA5B0; font-size: 9px; letter-spacing: 1.1px; }
+.before-after p { margin-top: 8px; }
+.before-after > div:first-child p { color: #8A95A0; }
+.improvement-footer { border-top: 1px solid #E7ECF1; padding-top: 14px; margin-top: 17px; display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: 12px; color: #8A97A4; font-size: 10px; }
+.improvement-footer > span:first-child { display: flex; align-items: center; gap: 7px; }
