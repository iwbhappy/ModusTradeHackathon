+      {t.participants.length > 0 && <Panel title="Присоединились к обращению" aside={<span className="mono muted">{t.participants.length}</span>}><div className="panel-body">{t.participants.map(p => <article className="participant" key={p.userId}><strong>{catalog.users.find(u => u.id === p.userId)?.name}</strong><small>{p.department}</small><p>{p.context}</p></article>)}</div></Panel>}
+      <Panel title="История событий"><ol className="event-history">{[...t.events].reverse().map(e => <li key={e.id}><span className="history-dot"/><div><div className="between"><strong>{e.actor}</strong><time>{date(e.date)}</time></div><p>{e.text}</p></div></li>)}</ol></Panel>
+    </div><aside className="detail-aside">
+      <Panel title="Сведения"><dl className="meta-list"><dt>Автор</dt><dd>{catalog.users.find(u => u.id === t.authorId)?.name}</dd><dt>Подразделение автора</dt><dd>{t.authorDepartment}</dd><dt>К чему относится</dt><dd>{t.targetDepartment}</dd><dt>Приоритет</dt><dd>{t.priority}</dd><dt>Создано</dt><dd>{date(t.createdAt)}</dd><dt>Первый ответ</dt><dd>{t.firstResponseAt ? date(t.firstResponseAt) : `До ${date(t.responseDueAt)}`}</dd>{!t.firstResponseAt && new Date(t.responseDueAt).getTime() < Date.now() && <dd className="overdue">Первый ответ просрочен</dd>}{t.type === 'Проблема' && <><dt>Стоимость проблемы</dt><dd className="cost-number"><span className="mono">≈ {number(cost(t))}</span> чел.-ч/мес<small>{t.frequency}, {t.minutes} мин за раз · включая оценки участников</small></dd></>}</dl></Panel>
