@@ -0,0 +1,29 @@
+import { useState } from 'react';
+import { Link, useSearchParams } from 'react-router-dom';
+import { ArrowRight, Pencil, ShieldCheck, Users } from 'lucide-react';
+import { saveRule, setVacation } from '../api';
+import { useApp } from '../store';
+import type { Rule } from '../types';
+import { ErrorMessage, Field, Modal, PageTitle, Panel } from '../components/ui';
+
+export function RoutingPage() {
+  const { catalog, userId, refresh, notify } = useApp(); const [editing, setEditing] = useState<Rule | null>(null); const [busy, setBusy] = useState(false); const [error, setError] = useState('');
+  if (!catalog) return null;
+  const name = (id: string) => catalog.users.find(u => u.id === id)?.name;
+  return <><PageTitle title="Категории и маршрутизация" subtitle="Ответственные, резервное назначение и сроки рассмотрения"/><div className="info-strip"><ShieldCheck size={19}/><div><strong>Обращение всегда получит ответственного</strong><p>Если основной в отпуске, система выберет резервного. Переключатель отпуска находится в разделе <Link to="/users">«Пользователи и роли»</Link>.</p></div></div><Panel title="Правила назначения" aside={<span className="quiet-label">{catalog.rules.length} правил · сроки в рабочих днях</span>}><div className="table-wrap"><table className="routing-table"><thead><tr><th>Категория / подразделение</th><th>Основной ответственный</th><th>Резервный ответственный</th><th className="numeric">Первый ответ</th><th className="numeric">Решение</th><th/></tr></thead><tbody>{catalog.rules.map(rule => <tr key={rule.id}><td><strong>{rule.category}</strong><small>{rule.department || 'Все подразделения'}</small></td><td>{name(rule.primaryId)}{catalog.users.find(u => u.id === rule.primaryId)?.vacation && <span className="vacation-tag">В отпуске → резервный</span>}</td><td>{name(rule.backupId)}{catalog.users.find(u => u.id === rule.backupId)?.vacation && <span className="vacation-tag">В отпуске</span>}</td><td className="numeric mono">{rule.responseDays} дн.</td><td className="numeric mono">{rule.resolutionDays} дн.</td><td><button className="icon-button" aria-label={`Редактировать правило: ${rule.category}`} onClick={() => { setEditing({ ...rule }); setError(''); }}><Pencil size={15}/></button></td></tr>)}</tbody></table></div></Panel><div className="routing-explanation"><h2>Как выбирается маршрут</h2><p>Сначала проверяется совпадение категории и подразделения. Затем — общее правило категории. Отпуск влияет на новые обращения; существующие назначения сохраняются. Если оба ответственных отсутствуют, форма подачи предлагает исправить правило.</p><p>Для демонстрации: отправьте руководителя закупок в отпуск и создайте обращение в категории «Межотдельное взаимодействие».</p></div>
+    {editing && <Modal title="Редактирование правила" onClose={() => { if (!busy) setEditing(null); }}><form onSubmit={async e => { e.preventDefault(); setBusy(true); setError(''); try { await saveRule(editing, userId); await refresh(); setEditing(null); notify('Правило маршрутизации сохранено'); } catch (e) { setError((e as Error).message); } finally { setBusy(false); } }}><Field label="Категория"><select value={editing.category} onChange={e => setEditing({ ...editing, category: e.target.value })}>{catalog.categories.map(c => <option key={c}>{c}</option>)}</select></Field><Field label="Подразделение проблемы"><select value={editing.department} onChange={e => setEditing({ ...editing, department: e.target.value })}><option value="">Все подразделения</option>{catalog.departments.map(d => <option key={d}>{d}</option>)}</select></Field>{(['primaryId', 'backupId'] as const).map(key => <Field key={key} label={key === 'primaryId' ? 'Основной ответственный' : 'Резервный ответственный'}><select value={editing[key]} onChange={e => setEditing({ ...editing, [key]: e.target.value })}>{catalog.users.filter(u => u.role === 'Руководитель').map(u => <option key={u.id} value={u.id}>{u.name}{u.vacation ? ' · в отпуске' : ''}</option>)}</select></Field>)}<div className="form-grid"><Field label="SLA первого ответа, раб. дней"><input type="number" min={1} max={60} required value={editing.responseDays} onChange={e => setEditing({ ...editing, responseDays: Number(e.target.value) })}/></Field><Field label="SLA решения, раб. дней"><input type="number" min={editing.responseDays} max={120} required value={editing.resolutionDays} onChange={e => setEditing({ ...editing, resolutionDays: Number(e.target.value) })}/></Field></div><ErrorMessage text={error}/><div className="button-row"><button type="button" disabled={busy} onClick={() => setEditing(null)}>Отмена</button><button className="primary" disabled={busy}>Сохранить правило</button></div></form></Modal>}
+  </>;
+}
+export function UsersPage() {
+  const [params] = useSearchParams();
+  const { catalog, userId, refresh, notify } = useApp(); const [department, setDepartment] = useState(''); const [role, setRole] = useState(''); const [busy, setBusy] = useState(false); const [error, setError] = useState('');
+  if (!catalog) return null;
+  const search = params.get('search')?.toLowerCase() || '';
+  const filtered = catalog.users.filter(u => (!department || department === u.department) && (!role || role === u.role) && (!search || `${u.name} ${u.department} ${u.role} ${u.id}`.toLowerCase().includes(search)));
+  return <><PageTitle title="Пользователи и роли" subtitle="Демонстрационные пользователи обозначены ролями и подразделениями"/><Panel title="Матрица доступа" aside={<ShieldCheck size={17}/>}><div className="access-grid">{[
+    ['Сотрудник', 'Свои обращения и те, к которым присоединился. Подача, комментарии и подтверждение своего результата.'],
+    ['Ответственный', 'Личные назначения и обращения подразделения ответственного. Статусы, уточнения, решения и переназначение.'],
+    ['Руководитель', 'Очередь своего подразделения и сводная аналитика компании. В демо объединён с ответственным в одну роль.'],
+    ['Администратор', 'Настройки категорий, маршрутов, сроков и пользователей. Доступ к содержимому обращений не предоставляется.']
+  ].map(([name, description]) => <div key={name}><h3>{name}</h3><p>{description}</p></div>)}</div><div className="table-footer"><span>Всем ролям доступны итоговые улучшения в «Сделано»; похожие обращения показываются сотруднику при подаче.</span></div></Panel><Panel title="Пользователи" aside={<Users size={17}/>}><div className="filters"><select aria-label="Фильтр пользователей по подразделению" value={department} onChange={e => setDepartment(e.target.value)}><option value="">Все подразделения</option>{catalog.departments.map(d => <option key={d}>{d}</option>)}</select><select aria-label="Фильтр пользователей по роли" value={role} onChange={e => setRole(e.target.value)}><option value="">Все роли</option>{['Сотрудник', 'Руководитель', 'Администратор'].map(r => <option key={r}>{r}</option>)}</select><span className="quiet-label">Показано {filtered.length}</span></div><ErrorMessage text={error}/><div className="table-wrap"><table><thead><tr><th>Пользователь</th><th>Подразделение</th><th>Роль</th><th>Доступность</th></tr></thead><tbody>{filtered.map(u => <tr key={u.id}><td><strong>{u.name}</strong><small className="mono">{u.id}</small></td><td>{u.department}</td><td>{u.role}</td><td>{u.role === 'Руководитель' ? <button role="switch" aria-checked={u.vacation} className="vacation-switch" disabled={busy} onClick={async () => { setBusy(true); setError(''); try { await setVacation(u.id, !u.vacation, userId); await refresh(); notify(`${u.name}: ${u.vacation ? 'доступен' : 'в отпуске'}`); } catch (e) { setError((e as Error).message); } finally { setBusy(false); } }}><span className={`switch-track ${u.vacation ? 'on' : ''}`}><i/></span>{u.vacation ? 'В отпуске' : 'Доступен'}</button> : <span className="muted">Доступен</span>}</td></tr>)}</tbody></table></div></Panel><Link to="/routing" className="text-button">Проверить правила назначения<ArrowRight size={15}/></Link></>;
+}
diff --git a/frontend/src/pages/Analytics.tsx b/frontend/src/pages/Analytics.tsx
