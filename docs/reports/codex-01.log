lex-start; font-size: 10px; gap: 8px; } .tracking { flex-direction: column; padding: 16px; gap: 13px; } .tracking li { gap: 12px; } .tracking li:not(:last-child)::after { top: 23px; left: 11px; width: 1px; height: 28px; right: auto; } .tracking li > div { display: flex; align-items: center; justify-content: space-between; width: 100%; background: transparent; } .tracking strong { font-size: 11px; margin: 5px 0; } .tracking small { font-size: 10px; } .detail-aside { display: block; } .detail-main .panel-body { padding: 15px; } .detail-layout { gap: 0; } .detail-main .button-row { flex-direction: column; align-items: stretch; } .event-history .between { align-items: flex-start; flex-wrap: wrap; gap: 5px; } .footer { font-size: 8px; padding: 13px 15px; gap: 15px; } .list-tabs { gap: 19px; padding-inline: 13px; } .list-tabs button { font-size: 10px; } .action-needed-items strong { display: block; margin-top: 5px; } .action-needed-items small { margin-left: 0; } .table-footer { flex-wrap: wrap; } .list-note { align-items: flex-start; line-height: 1.7; } .before-after { grid-template-columns: 1fr; gap: 10px; } .before-after > svg { transform: rotate(90deg); margin: 0; } .improvement-footer > span:first-child { align-items: flex-start; line-height: 1.6; } .kpi-row { grid-template-columns: 1fr 1fr; } .kpi { border-bottom: 1px solid #E6EAEF; } .kpi > span { min-height: 14px; } .heatmap { min-width: 740px; } .access-grid { grid-template-columns: 1fr; } .modal-backdrop { padding: 15px; } .panel-heading .quiet-label { font-size: 8px; } .toast { bottom: 15px; right: 15px; } }
