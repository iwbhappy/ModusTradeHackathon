+      {draft && <div className="system-box"><span className="quiet-label">Автоподсказка</span><p className="small">{draft}</p><div className="button-row"><button type="button" onClick={() => { setActionText(draft); setDraft(''); }}>Принять</button><button type="button" onClick={() => setDraft('')}>Отклонить</button></div></div>}
+      <button className="primary full-width" disabled={busy || status === t.status || (['Реализовано', 'Отклонено', 'Ожидает уточнения'].includes(status) && actionText.trim().length < 10)}>Сохранить решение</button></form>
+      <hr/><form onSubmit={e => { e.preventDefault(); run(async () => { await reassign(id, assignee, reason, userId); setReason(''); navigate('/inbox'); }, 'Обращение переназначено'); }}><h3>Переназначить</h3><Field label="Новый ответственный"><select value={assignee} onChange={e => setAssignee(e.target.value)}>{catalog.users.filter(u => u.role === 'Руководитель').map(u => <option key={u.id} value={u.id} disabled={u.vacation}>{u.name}{u.vacation ? ' · в отпуске' : ''}</option>)}</select></Field><Field label="Причина переназначения *"><textarea rows={2} value={reason} onChange={e => setReason(e.target.value)} required minLength={10}/></Field><button disabled={busy || assignee === t.assigneeId || reason.trim().length < 10}>Переназначить</button></form></div></Panel>}
+      <Panel title="Связанные обращения" aside={<ScanSearch size={16}/>}><div className="panel-body"><h3>{catalog.clusters.find(c => c.id === t.clusterId)?.title}</h3><p className="small muted">Доступная вам часть кластера</p><div className="cluster-cost"><strong className="mono">≈ {number(related.reduce((sum, item) => sum + cost(item), 0))}</strong><span>чел.-ч/мес</span></div><p className="small">{[...new Set(related.flatMap(item => [item.authorDepartment, item.targetDepartment, ...item.participants.map(p => p.department)]))].join(', ')}</p>{related.filter(item => item.id !== id).slice(0, 6).map(item => <Link className="related-link" to={`/tickets/${item.id}`} key={item.id}><span className="mono">{item.id}</span>{item.title}</Link>)}{manager && <Link to={`/analytics?cluster=${t.clusterId}`} className="text-button">Весь кластер в аналитике</Link>}</div></Panel>
+    </aside></div></>;
+}
diff --git a/frontend/src/pages/TicketList.tsx b/frontend/src/pages/TicketList.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..3ab19b54084ec73373079c2de1fbf4204421796a
--- /dev/null
+++ b/frontend/src/pages/TicketList.tsx
@@ -0,0 +1,40 @@
+import { useEffect, useMemo, useState } from 'react';
+import { Link, useSearchParams } from 'react-router-dom';
+import { ArrowDownWideNarrow, ArrowRight, Clock3, Plus, Search, SlidersHorizontal } from 'lucide-react';
+import { listTickets } from '../api';
+import { useApp } from '../store';
+import type { Ticket } from '../types';
+import { cost, overdue } from '../lib/format';
+import { Badge, Empty, ErrorMessage, Loading, PageTitle, Panel, TicketsTable } from '../components/ui';
+
+export function TicketList({ mode }: { mode: 'mine' | 'inbox' }) {
+  const { catalog, userId, revision } = useApp(); const [params, setParams] = useSearchParams();
+  const [tickets, setTickets] = useState<Ticket[]>([]); const [loading, setLoading] = useState(true); const [error, setError] = useState(''); const [sort, setSort] = useState('date');
+  useEffect(() => { let live = true; setLoading(true); setError(''); listTickets(userId).then(t => { if (live) setTickets(t); }).catch(e => { if (live) setError(e.message); }).finally(() => { if (live) setLoading(false); }); return () => { live = false; }; }, [userId, revision]);
+  const set = (key: string, value: string) => { const next = new URLSearchParams(params); if (value) next.set(key, value); else next.delete(key); setParams(next); };
+  const tab = params.get('tab') || 'Все'; const search = params.get('search') || '';
+  const filtered = useMemo(() => tickets.filter(t =>
+    (!search || `${t.id} ${t.title} ${t.text}`.toLowerCase().includes(search.toLowerCase())) &&
+    (!params.get('department') || t.targetDepartment === params.get('department')) &&
+    (!params.get('category') || t.category === params.get('category')) &&
+    (!params.get('status') || t.status === params.get('status')) &&
+    (!params.get('priority') || t.priority === params.get('priority')) &&
+    (!params.get('deadline') || (params.get('deadline') === 'overdue' ? overdue(t) : !overdue(t) && !['Реализовано', 'Закрыто', 'Отклонено'].includes(t.status) && new Date(t.dueAt).getTime() - Date.now() < 3 * 86400000)) &&
+    (tab === 'Все' || (tab === 'Новые' ? t.status === 'Новое' : tab === 'Просрочены' ? overdue(t) : tab === 'Ждут уточнения' ? t.status === 'Ожидает уточнения' : t.status === 'В работе' || t.status === 'Возвращено автором'))
+  ).sort((a, b) => sort === 'cost' ? cost(b) - cost(a) : sort === 'deadline' ? a.dueAt.localeCompare(b.dueAt) : b.createdAt.localeCompare(a.createdAt)), [tickets, params, search, tab, sort]);
+  if (!catalog) return null;
+  const actionTickets = tickets.filter(t => t.authorId === userId && ['Ожидает уточнения', 'Реализовано'].includes(t.status));
+  return <><PageTitle title={mode === 'mine' ? 'Мои обращения' : 'Входящие'} subtitle={mode === 'mine' ? 'Ваши обращения и проблемы, к которым вы присоединились' : 'Обращения, назначенные вам и вашему подразделению'} action={mode === 'mine' ? <Link className="button primary" to="/new"><Plus size={17}/>Новое обращение</Link> : <div className="quiet-label"><Clock3 size={16}/>Сроки в рабочих днях</div>}/>
+    {mode === 'mine' && actionTickets.length > 0 && <section className="action-needed"><div className="section-label"><Clock3 size={16}/><strong>Требуют вашего действия</strong><span className="count">{actionTickets.length}</span></div><div className="action-needed-items">{actionTickets.map(t => <Link to={`/tickets/${t.id}`} key={t.id}><div><span className="mono">{t.id}</span><strong>{t.title}</strong><small>{t.status === 'Реализовано' ? 'Проверьте и подтвердите результат' : 'Ответственный запросил уточнение'}</small></div><ArrowRight size={18}/></Link>)}</div></section>}
+    <Panel><div className="list-tabs" role="group" aria-label="Быстрые фильтры">{(mode === 'mine' ? ['Все', 'В работе', 'Ждут уточнения'] : ['Все', 'Новые', 'Просрочены', 'Ждут уточнения', 'В работе']).map(name => <button key={name} className={`${tab === name ? 'active' : ''} ${name === 'Просрочены' ? 'amber-tab' : ''}`} onClick={() => set('tab', name)}>{name}<span>{tickets.filter(t => name === 'Все' || (name === 'Новые' ? t.status === 'Новое' : name === 'Просрочены' ? overdue(t) : name === 'Ждут уточнения' ? t.status === 'Ожидает уточнения' : ['В работе', 'Возвращено автором'].includes(t.status))).length}</span></button>)}</div>
+      <div className="filters"><div className="search-field"><Search size={16}/><input aria-label="Поиск в списке" placeholder="Поиск по ID или тексту" value={search} onChange={e => set('search', e.target.value)}/></div>
+      {mode === 'inbox' && <><select aria-label="Подразделение проблемы" value={params.get('department') || ''} onChange={e => set('department', e.target.value)}><option value="">Все подразделения</option>{catalog.departments.map(d => <option key={d}>{d}</option>)}</select><select aria-label="Категория" value={params.get('category') || ''} onChange={e => set('category', e.target.value)}><option value="">Все категории</option>{catalog.categories.map(c => <option key={c}>{c}</option>)}</select></>}
+      <select aria-label="Статус" value={params.get('status') || ''} onChange={e => set('status', e.target.value)}><option value="">Все статусы</option>{catalog.statuses.map(s => <option key={s}>{s}</option>)}</select>
+      {mode === 'inbox' && <><select aria-label="Приоритет" value={params.get('priority') || ''} onChange={e => set('priority', e.target.value)}><option value="">Приоритет</option>{['Высокий', 'Средний', 'Низкий'].map(s => <option key={s}>{s}</option>)}</select><select aria-label="Срок" value={params.get('deadline') || ''} onChange={e => set('deadline', e.target.value)}><option value="">Любой срок</option><option value="overdue">Просрочены</option><option value="soon">До 3 дней</option></select></>}
+      {params.size > 0 && <button className="text-button" onClick={() => setParams({})}>Сбросить</button>}</div>
+      <div className="table-toolbar"><span><SlidersHorizontal size={14}/>Найдено: <strong className="mono">{filtered.length}</strong></span><label><ArrowDownWideNarrow size={15}/><select aria-label="Сортировка" value={sort} onChange={e => setSort(e.target.value)}><option value="date">Сначала новые</option><option value="deadline">По сроку решения</option>{mode === 'inbox' && <option value="cost">По стоимости проблемы</option>}</select></label></div>
+      <ErrorMessage text={error}/>{loading ? <Loading/> : tickets.length ? <TicketsTable tickets={filtered} users={catalog.users} showCost={mode === 'inbox'}/> : <Empty><Link to="/new">Создать обращение</Link></Empty>}
+      <div className="table-footer"><span>Показано {filtered.length} из {tickets.length}</span><span>{mode === 'mine' ? 'Свои и присоединённые обращения' : 'Личные назначения и подразделение ответственного'}</span></div>
+    </Panel><div className="list-note"><Badge status="Реализовано"/><span>После реализации автор подтверждает результат. Только тогда обращение закрывается.</span></div>
+  </>;
+}
diff --git a/frontend/src/store.ts b/frontend/src/store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..21cb132309b207e73fee6b1dc271e396e4533e13
--- /dev/null
+++ b/frontend/src/store.ts
@@ -0,0 +1,17 @@
+import { create } from 'zustand';
+import type { Catalog, Role } from './types';
+import { getCatalog } from './api';
+interface AppState {
+  catalog: Catalog | null; userId: string; revision: number; notice: string;
+  load: () => Promise<void>; selectUser: (id: string) => void; selectRole: (role: Role) => void;
+  refresh: () => Promise<void>; notify: (text: string) => void;
+}
+const stored = localStorage.getItem('signal-user') || 'employee-1';
+export const useApp = create<AppState>((set, get) => ({
+  catalog: null, userId: stored, revision: 0, notice: '',
+  load: async () => { const catalog = await getCatalog(); const userId = catalog.users.some(u => u.id === get().userId) ? get().userId : catalog.users[0].id; set({ catalog, userId }); },
+  selectUser: userId => { localStorage.setItem('signal-user', userId); set({ userId }); },
+  selectRole: role => { const target = get().catalog?.users.find(u => u.role === role); if (target) get().selectUser(target.id); },
+  refresh: async () => { const catalog = await getCatalog(); set(s => ({ catalog, revision: s.revision + 1 })); },
+  notify: notice => set({ notice })
+}));
