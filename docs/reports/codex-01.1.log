+    <div className="attachment-row">
+      <label className="button"><Paperclip size={15}/>Прикрепить файл
+        <input type="file" className="sr-only" multiple onChange={(e) => {
+          onChange([...new Set([...names, ...Array.from(e.target.files || []).map((f) => f.name)])]);
+          e.target.value = '';
+        }}/>
+      </label>
+      <small>В прототипе сохраняются только имена файлов</small>
+    </div>
+    {names.map((name) => <span className="file-chip" key={name}>
+      <Paperclip size={13}/>{name}
+      <button type="button" className="icon-button" aria-label={`Удалить ${name}`}
+        onClick={() => onChange(names.filter((value) => value !== name))}><X size={13}/></button>
+    </span>)}
+  </>;
+}
diff --git a/frontend/src/pages/new-ticket/ContentFields.tsx b/frontend/src/pages/new-ticket/ContentFields.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5982911a6ad68f2191869989c8c05f0c59168e8f
--- /dev/null
+++ b/frontend/src/pages/new-ticket/ContentFields.tsx
@@ -0,0 +1,79 @@
+import type { Dispatch, SetStateAction } from 'react';
+import { Clock3 } from 'lucide-react';
+import { Field } from '../../components/ui';
+import { useApp } from '../../store';
+import type { TicketDraft, TicketType } from '../../types';
+import { monthly, number } from '../../lib/format';
+import { Attachments } from './Attachments';
+import { StructureSuggestion } from './StructureSuggestion';
+import { CostFields } from './CostFields';
+
+export function ContentFields({ draft, setDraft, busy, setBusy }: {
+  draft: TicketDraft;
+  setDraft: Dispatch<SetStateAction<TicketDraft>>;
+  busy: boolean;
+  setBusy: (busy: boolean) => void;
+}) {
+  const { catalog, notify } = useApp();
+  if (!catalog) return null;
+  const change = <K extends keyof TicketDraft>(key: K, value: TicketDraft[K]) =>
+    setDraft((previous) => ({ ...previous, [key]: value }));
+  return <>
+    <fieldset className="type-field"><legend>Тип обращения *</legend>
+      <div className="segmented">
+        {(['Проблема', 'Предложение', 'Положительный отзыв'] as TicketType[]).map((type) =>
+          <button type="button" key={type} className={type === draft.type ? 'selected' : ''}
+            onClick={() => change('type', type)}>{type}</button>)}
+      </div>
+    </fieldset>
+    <div className="form-grid">
+      <Field label="Категория *">
+        <select value={draft.category} onChange={(e) => change('category', e.target.value)}>
+          {catalog.categories.map((category) => <option key={category}>{category}</option>)}
+        </select>
+      </Field>
+      <Field label="К какому подразделению относится *">
+        <select value={draft.targetDepartment}
+          onChange={(e) => change('targetDepartment', e.target.value)}>
+          {catalog.departments.map((department) => <option key={department}>{department}</option>)}
+        </select>
+      </Field>
+    </div>
+    <Field label="Кратко о сути" hint={`${draft.title.length}/80 · Необязательно: можно оставить пустым`}>
+      <input maxLength={80} value={draft.title} onChange={(e) => change('title', e.target.value)}
+        placeholder="Например: не хватает параметров в заявке на закупку"/>
+    </Field>
+    <Field label="Описание ситуации *"
+      hint="Что происходит и как это влияет на работу. Без конфиденциальных сведений.">
+      <textarea required minLength={20} maxLength={6000} rows={7} value={draft.text}
+        onChange={(e) => change('text', e.target.value)}
+        placeholder="Например: в заявках на закупку не хватает назначения изделия и параметров…"/>
+    </Field>
+    <StructureSuggestion text={draft.text} busy={busy} setBusy={setBusy} onAccept={(structure) => {
+      setDraft((previous) => ({ ...previous, title: structure.title, text: structure.problem,
+        solution: structure.solution, effect: structure.effect, category: structure.category,
+        priority: structure.priority }));
+      notify('Структура принята. Поля доступны для редактирования.');
+    }}/>
+    <Field label="Предлагаемое решение">
+      <textarea rows={3} value={draft.solution} onChange={(e) => change('solution', e.target.value)}
+        placeholder="Как, по вашему мнению, можно улучшить ситуацию?"/>
+    </Field>
+    {draft.effect && <Field label="Ожидаемый эффект">
+      <textarea rows={2} value={draft.effect} onChange={(e) => change('effect', e.target.value)}/>
+    </Field>}
+    <Attachments names={draft.attachments} onChange={(names) => change('attachments', names)}/>
+    {draft.type === 'Проблема' && <section className="cost-box">
+      <div className="section-label"><Clock3 size={17}/><h2>Стоимость проблемы</h2></div>
+      <p>Два ответа помогут расставить приоритеты по потерям времени.</p>
+      <CostFields frequency={draft.frequency} minutes={draft.minutes}
+        onChange={(frequency, minutes) => setDraft((previous) => ({ ...previous, frequency, minutes }))}/>
+      <div className="cost-result">Ваша оценка:{' '}
+        <strong className="mono">≈ {number(monthly(draft.frequency, draft.minutes))}</strong>{' '}чел.-ч/мес
+        {draft.frequency === 'разово' && <small>
+          Разовая потеря: {draft.minutes} мин. Не включается в ежемесячные потери.
+        </small>}
+      </div>
+    </section>}
+  </>;
+}
diff --git a/frontend/src/pages/new-ticket/CostFields.tsx b/frontend/src/pages/new-ticket/CostFields.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..fb4a78167ed930a69ea55762429967c30b6acff0
--- /dev/null
+++ b/frontend/src/pages/new-ticket/CostFields.tsx
@@ -0,0 +1,23 @@
+import type { Frequency } from '../../types';
+import { Field } from '../../components/ui';
+
+export function CostFields({ frequency, minutes, onChange }: {
+  frequency: Frequency;
+  minutes: number;
+  onChange: (frequency: Frequency, minutes: number) => void;
+}) {
+  return <div className="form-grid">
+    <Field label="Как часто?">
+      <select value={frequency} onChange={(e) => onChange(e.target.value as Frequency, minutes)}>
+        {['ежедневно', 'еженедельно', 'ежемесячно', 'разово'].map((value) =>
+          <option key={value}>{value}</option>)}
+      </select>
+    </Field>
+    <Field label="Сколько времени теряете за раз?">
+      <select value={minutes} onChange={(e) => onChange(frequency, Number(e.target.value))}>
+        {[[15, '≈ 15 мин'], [30, '≈ 30 мин'], [60, '≈ 1 ч'], [120, '≈ 2 ч+']].map(([value, label]) =>
+          <option key={value} value={value}>{label}</option>)}
+      </select>
+    </Field>
+  </div>;
+}
diff --git a/frontend/src/pages/new-ticket/JoinTicket.tsx b/frontend/src/pages/new-ticket/JoinTicket.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..67122e887a7dea9183ecfe394f4624f2ed5075d0
--- /dev/null
+++ b/frontend/src/pages/new-ticket/JoinTicket.tsx
@@ -0,0 +1,45 @@
+import { useState } from 'react';
+import { useNavigate } from 'react-router-dom';
+import type { Dispatch, SetStateAction } from 'react';
+import type { TicketDraft } from '../../types';
+import { joinTicket } from '../../api';
+import { useApp } from '../../store';
+import { ErrorMessage, Field } from '../../components/ui';
+import { monthly, number } from '../../lib/format';
+import { CostFields } from './CostFields';
+
+export function JoinTicket({ ticketId, problem, draft, setDraft }: {
+  ticketId: string;
+  problem: boolean;
+  draft: TicketDraft;
+  setDraft: Dispatch<SetStateAction<TicketDraft>>;
+}) {
+  const { userId, refresh, notify } = useApp();
+  const navigate = useNavigate();
+  const [context, setContext] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  return <div className="join-form">
+    <Field label="Ваш контекст *"><textarea rows={3} value={context}
+      onChange={(e) => setContext(e.target.value)} placeholder="Где и как возникает у вас?"/></Field>
+    {problem && <>
+      <CostFields frequency={draft.frequency} minutes={draft.minutes}
+        onChange={(frequency, minutes) => setDraft((previous) => ({ ...previous, frequency, minutes }))}/>
+      <p className="small">К потерям добавится ваша оценка:{' '}
+        {number(monthly(draft.frequency, draft.minutes))} чел.-ч/мес.</p>
+    </>}
+    <ErrorMessage text={error}/>
+    <button type="button" className="primary" disabled={busy || context.trim().length < 10}
+      onClick={async () => {
+        setBusy(true);
+        setError('');
+        try {
+          await joinTicket(ticketId, context, draft.frequency, draft.minutes, userId);
+          await refresh();
+          notify(`Вы присоединились к ${ticketId}`);
+          navigate(`/tickets/${ticketId}`);
+        } catch (error) { setError((error as Error).message); }
+        finally { setBusy(false); }
+      }}>Присоединиться</button>
+  </div>;
+}
diff --git a/frontend/src/pages/new-ticket/RoutingPreview.tsx b/frontend/src/pages/new-ticket/RoutingPreview.tsx
new file mode 100644
