-      attachments: [],
-      clusterId: raw.cluster || detectCluster(raw.text + ' ' + raw.category),
-    };
-  };
-  const tickets = originals.map((r, i) =>
-    make(i, {
-      ...r,
-      type: r.type as TicketType,
-      priority: r.priority as Priority,
-      status: r.status as Status,
