import type { Analytics, Ticket } from '../types';
import { cost, date, number, overdue } from '../lib/format';
import { Badge, Empty, ErrorMessage, Loading, Modal, PageTitle, Panel } from '../components/ui';

const palette = [
  '#1E3A5F',
  '#48729A',
  '#7595B3',
  '#A3B7C9',
  '#C8D4DF',
  '#DDE4EA',
  '#5B7F78',
  '#99AAA5',
];
function Distribution({
  title,
  data,
}: {
  title: string;
  data: { label: string; value: number }[];
}) {
  const sum = data.reduce((s, x) => s + x.value, 0);
  return (
    <Panel title={title}>
      <div className="distribution">
        <div
          className="stacked-bar"
          role="img"
          aria-label={data.map((x) => `${x.label}: ${x.value}`).join(', ')}
        >
          {data.map((d, i) => (
            <span
              key={d.label}
              style={{
                width: `${sum ? (d.value / sum) * 100 : 0}%`,
                background: palette[i % palette.length],
              }}
              title={`${d.label}: ${d.value}`}
            />
          ))}
        </div>
        {data.map((d, i) => (
          <div className="distribution-row" key={d.label}>
            <span className="legend-square" style={{ background: palette[i % palette.length] }} />
            <span>{d.label}</span>
            <strong className="mono">{d.value}</strong>
            <small className="mono">{sum ? Math.round((d.value / sum) * 100) : 0}%</small>
          </div>
        ))}
      </div>
    </Panel>
  );
}
function WeeklyChart({ tickets }: { tickets: Ticket[] }) {
  const data = useMemo(() => {
    const current = new Date();
    current.setDate(current.getDate() - ((current.getDay() + 6) % 7));
    current.setHours(0, 0, 0, 0);
    return Array.from({ length: 10 }, (_, i) => {
      const start = new Date(current);
      start.setDate(start.getDate() - (9 - i) * 7);
      const end = new Date(start);
      end.setDate(end.getDate() + 7);
      return {
        start,
        incoming: tickets.filter(
          (t) => new Date(t.createdAt) >= start && new Date(t.createdAt) < end,
        ).length,
        done: tickets.filter(
          (t) =>
            t.implementedAt &&
            new Date(t.implementedAt) >= start &&
            new Date(t.implementedAt) < end &&
            ['Реализовано', 'Закрыто'].includes(t.status),
        ).length,
      };
    });
  }, [tickets]);
  const max = Math.max(4, ...data.flatMap((d) => [d.incoming, d.done]));
  return (
    <div className="weekly-chart">
      <svg
        viewBox="0 0 900 190"
        role="img"
        aria-label="Обращения по неделям за последние 10 недель"
      >
        <title>Новые и реализованные обращения по неделям</title>
        {[0, 1, 2, 3, 4].map((i) => (
          <g key={i}>
            <line x1="35" x2="885" y1={150 - i * 33} y2={150 - i * 33} stroke="#E9EDF1" />
            <text x="23" y={154 - i * 33} textAnchor="end" fill="#7A8491" fontSize="10">
              {Math.round((max * i) / 4)}
            </text>
          </g>
        ))}
        {data.map((d, i) => (
          <g key={i}>
            <title>
              {date(d.start)}: новых {d.incoming}, реализовано {d.done}
            </title>
            <rect
              x={52 + i * 84}
              y={150 - (d.incoming / max) * 132}
              width="21"
              height={(d.incoming / max) * 132}
              fill="#1E3A5F"
              rx="2"
            />
            <rect
              x={77 + i * 84}
              y={150 - (d.done / max) * 132}
              width="21"
              height={(d.done / max) * 132}
              fill="#A3B7C9"
              rx="2"
            />
            <text x={75 + i * 84} y="177" textAnchor="middle" fill="#6C7785" fontSize="10">
              {new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'short' })
                .format(d.start)
                .replace('.', '')}
            </text>
          </g>
        ))}
      </svg>
    </div>
  );
}
export function AnalyticsPage() {
  const { userId, selectUser } = useApp();
  const [params, setParams] = useSearchParams();
  const [days, setDays] = useState(90);
  const [data, setData] = useState<Analytics | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [drill, setDrill] = useState<{ title: string; tickets: Ticket[] } | null>(null);
  useEffect(() => {
    let live = true;
    setLoading(true);
    getAnalytics(days, userId)
      .then((result) => {
        if (live) {
          setData(result);
          const cluster = params.get('cluster');
          if (cluster)
            setDrill({
              title: result.clusters.find((c) => c.id === cluster)?.title || 'Кластер',
              tickets: result.tickets.filter((t) => t.clusterId === cluster),
            });
        }
      })
      .catch((e) => {
        if (live) setError(e.message);
      })
      .finally(() => {
        if (live) setLoading(false);
      });
    return () => {
      live = false;
    };
  }, [days, userId, params]);
  if (!data && loading) return <Loading />;
  if (!data) return <ErrorMessage text={error} />;
  const tickets = data.tickets;
  const group = (key: 'type' | 'status' | 'category') =>
    [...new Set(tickets.map((t) => t[key]))]
      .map((label) => ({ label, value: tickets.filter((t) => t[key] === label).length }))
      .sort((a, b) => b.value - a.value);
  const problems = tickets.filter((t) => t.type === 'Проблема');
  const matrixMax = Math.max(
    1,
    ...data.departments.flatMap((a) =>
      data.departments.map(
        (b) => problems.filter((t) => t.authorDepartment === a && t.targetDepartment === b).length,
      ),
    ),
  );
  const cells = (a: string, b: string) =>
    problems.filter((t) => t.authorDepartment === a && t.targetDepartment === b);
  const show = (title: string, list: Ticket[]) => setDrill({ title, tickets: list });
  return (
    <>
      <PageTitle
        title="Аналитика обращений"
        subtitle="Повторяющиеся проблемы, потери времени и результат изменений · вся компания"
        action={
          <div className="segmented compact">
            {[
              [30, '30 дней'],
              [90, '90 дней'],
              [0, 'Всё время'],
            ].map(([value, label]) => (
              <button
                key={value}
                className={days === value ? 'selected' : ''}
                onClick={() => {
                  setDays(Number(value));
                  setDrill(null);
                }}
              >
                {label}
              </button>
            ))}
          </div>
        }
      />
      <ErrorMessage text={error} />
      {loading && <Loading />}
      <div className="kpi-row">
        {[
          ['Рассмотрено', `${number(data.considered)}%`, 'Есть первый ответ'],
          [
            'До первого ответа',
            `${number(data.medianHours)} ч`,
            `Медиана · среднее ${number(data.averageHours)} ч`,
          ],
          [
            'Результат зафиксирован',
            `${number(data.resultRate)}%`,
            'Решение или мотивированный отказ',
          ],
          ['Реализовано', `${data.implemented}`, 'По дате реализации за период'],
          ['Подтверждено авторами', `${data.confirmed}`, 'Результат проверен в работе'],
        ].map(([label, value, hint]) => (
          <div className="kpi" key={label}>
            <span>{label}</span>
            <strong className="mono">{value}</strong>
            <small>{hint}</small>
          </div>
        ))}
      </div>
      <div className="analytics-top">
        <Panel
          title="Динамика по неделям"
          aside={
            <div className="chart-legend">
              <span>
                <i />
                Новые
              </span>
              <span>
                <i />
                Реализовано
              </span>
            </div>
          }
        >
          <WeeklyChart tickets={tickets} />
        </Panel>
        <Panel title="Контроль SLA" aside={<Clock3 size={17} />}>
          <div className="sla-summary">
            <strong className="mono overdue">{tickets.filter(overdue).length}</strong>
            <span>обращений с просроченным решением</span>
          </div>
          <div className="sla-list">
            {data.departments
              .map((d) => ({
                d,
                list: tickets.filter(
                  (t) =>
                    overdue(t) && data.users.find((u) => u.id === t.assigneeId)?.department === d,
                ),
              }))
              .filter((x) => x.list.length)
              .sort((a, b) => b.list.length - a.list.length)
              .map(({ d, list }) => (
                <button key={d} onClick={() => show(`Просрочены · ${d}`, list)}>
                  <span>{d}</span>
                  <span className="sla-bar">
                    <i
                      style={{
                        width: `${(list.length / Math.max(1, tickets.filter(overdue).length)) * 100}%`,
                      }}
                    />
                  </span>
                  <strong className="mono overdue">{list.length}</strong>
                  <ArrowUpRight size={14} />
                </button>
              ))}
          </div>
          {!tickets.some(overdue) && <p className="panel-body muted">Просроченных обращений нет</p>}
        </Panel>
      </div>
      <div className="distribution-grid">
        <Distribution title="По типам" data={group('type')} />
        <Distribution title="По статусам" data={group('status')} />
        <Distribution title="По категориям" data={group('category')} />
      </div>
      <Panel
        title="Повторяющиеся проблемы"
        aside={
          <span className="quiet-label">
            <ScanSearch size={15} />
            Анализ системы
          </span>
        }
      >
        <div className="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Кластер</th>
                <th className="numeric">Обращения</th>
                <th>Затронутые подразделения</th>
                <th className="numeric">≈ чел.-ч/мес</th>
                <th className="numeric">Тренд за 30 дн.</th>
                <th />
              </tr>
            </thead>
            <tbody>
              {data.clusters.map((cluster) => {
                const list = tickets.filter((t) => t.clusterId === cluster.id);
                const delta = data.clusterTrends[cluster.id] || 0;
                return (
                  <tr key={cluster.id}>
                    <td>
                      <button
                        className="text-button cluster-title"
                        onClick={() => show(cluster.title, list)}
                      >
                        {cluster.title}
                      </button>
                    </td>
                    <td className="numeric mono">{list.length}</td>
                    <td className="departments-cell">
                      {[
                        ...new Set(
                          list.flatMap((t) => [
                            t.authorDepartment,
                            t.targetDepartment,
                            ...t.participants.map((p) => p.department),
                          ]),
                        ),
                      ].join(', ') || '—'}
                    </td>
                    <td className="numeric mono">
                      {number(list.reduce((s, t) => s + cost(t), 0))}
                    </td>
                    <td className="numeric">
                      <span className="trend">
                        {delta > 0 ? (
                          <ArrowUp size={13} />
                        ) : delta < 0 ? (
                          <ArrowDown size={13} />
                        ) : null}
                        {delta > 0 ? '+' : ''}
                        {delta}
                      </span>
                    </td>
                    <td>
                      <button
                        className="icon-button"
                        aria-label={`Открыть кластер: ${cluster.title}`}
                        onClick={() => show(cluster.title, list)}
                      >
                        <ArrowUpRight size={15} />
                      </button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <div className="table-footer">
          <span>Оценки авторов и участников · ежедневно = 22, еженедельно = 4 раза в месяц</span>
          <span>Разовые потери не входят в месяц</span>
        </div>
      </Panel>
      <Panel
        title="Матрица межотдельного трения"
        className="matrix-panel"
        aside={
          <span className="quiet-label">
            <Grid2X2 size={15} />
            Нажмите на ячейку для просмотра
          </span>
        }
      >
        <div className="matrix-description">
          Строка — подразделение автора. Столбец — подразделение или процесс, к которому относится
          обращение.
        </div>
        <div className="table-wrap">
          <table className="heatmap">
            <thead>
              <tr>
                <th>
                  Кто сообщает <span>→ о ком</span>
                </th>
                {data.departments.map((d) => (
                  <th key={d}>{d}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {data.departments.map((a) => (
                <tr key={a}>
                  <th>{a}</th>
                  {data.departments.map((b) => {
                    const count = cells(a, b).length;
                    const strength = count / matrixMax;
                    const color = count
                      ? ['#EBF0F6', '#CBDAE8', '#95AFC9', '#567FA6', '#1E3A5F'][
                          Math.min(4, Math.floor(strength * 4))
                        ]
                      : '#F5F6F8';
                    return (
                      <td key={b}>
                        <button
                          title={`${a} → ${b}: ${count}`}
                          aria-label={`${a} сообщает о ${b}: ${count} обращений`}
                          onClick={() => show(`${a} → ${b}`, cells(a, b))}
                          style={{ background: color, color: strength > 0.65 ? '#fff' : '#1E3A5F' }}
                          className="mono"
                        >
                          {count || '—'}
                        </button>
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div className="heatmap-legend">
          <span>Меньше обращений</span>
          {['#F5F6F8', '#EBF0F6', '#CBDAE8', '#95AFC9', '#567FA6', '#1E3A5F'].map((c) => (
            <i key={c} style={{ background: c }} />
          ))}
          <span>Больше обращений</span>
        </div>
      </Panel>
      <div className="analytics-note">
        <ChartNoAxesCombined size={16} />
        <span>
          За период: {tickets.length} обращений по дате создания. Тренд всегда сравнивает последние
          30 дней с предыдущими 30 по всей истории, независимо от фильтра.
        </span>
      </div>
      {drill && (
        <Modal
          title={drill.title}
          onClose={() => {
            setDrill(null);
            if (params.has('cluster')) setParams({});
          }}
        >
          <div className="drill-summary">
            <ListFilter size={16} />
            {drill.tickets.length} обращений · ≈{' '}
            {number(drill.tickets.reduce((s, t) => s + cost(t), 0))} чел.-ч/мес
          </div>
          {!drill.tickets.length ? (
            <Empty text="Обращений на этом стыке нет" />
          ) : (
            <div className="drill-list">
              {drill.tickets.map((t) => (
                <article key={t.id}>
                  <div className="between">
                    <span className="mono ticket-id">{t.id}</span>
                    <Badge status={t.status} />
                  </div>
                  <h3>{t.title}</h3>
                  <p className="small muted">
                    {t.authorDepartment} → {t.targetDepartment} · {date(t.createdAt)}
                  </p>
                  <Link
                    className="text-button"
                    to={`/tickets/${t.id}`}
                    onClick={() => {
                      selectUser(t.assigneeId);
                      setDrill(null);
                    }}
                  >
                    Открыть как ответственный <ArrowUpRight size={14} />
                  </Link>
                </article>
              ))}
            </div>
          )}
        </Modal>
      )}
    </>
  );
}
import { useState } from 'react';
import { Link, useSearchParams } from 'react-router-dom';
import { ArrowRight, Pencil, ShieldCheck, Users } from 'lucide-react';
import { saveRule, setVacation } from '../api';
import { useApp } from '../store';
import type { Rule } from '../types';
import { ErrorMessage, Field, Modal, PageTitle, Panel } from '../components/ui';

export function RoutingPage() {
  const { catalog, userId, refresh, notify } = useApp();
  const [editing, setEditing] = useState<Rule | null>(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');
  if (!catalog) return null;
  const name = (id: string) => catalog.users.find((u) => u.id === id)?.name;
  return (
    <>
      <PageTitle
        title="Категории и маршрутизация"
        subtitle="Ответственные, резервное назначение и сроки рассмотрения"
      />
      <div className="info-strip">
        <ShieldCheck size={19} />
        <div>
          <strong>Обращение всегда получит ответственного</strong>
          <p>
            Если основной в отпуске, система выберет резервного. Переключатель отпуска находится в
            разделе <Link to="/users">«Пользователи и роли»</Link>.
          </p>
        </div>
      </div>
      <Panel
        title="Правила назначения"
        aside={
          <span className="quiet-label">{catalog.rules.length} правил · сроки в рабочих днях</span>
        }
      >
        <div className="table-wrap">
          <table className="routing-table">
            <thead>
              <tr>
                <th>Категория / подразделение</th>
                <th>Основной ответственный</th>
                <th>Резервный ответственный</th>
                <th className="numeric">Первый ответ</th>
                <th className="numeric">Решение</th>
                <th />
              </tr>
            </thead>
            <tbody>
              {catalog.rules.map((rule) => (
                <tr key={rule.id}>
                  <td>
                    <strong>{rule.category}</strong>
                    <small>{rule.department || 'Все подразделения'}</small>
                  </td>
                  <td>
                    {name(rule.primaryId)}
                    {catalog.users.find((u) => u.id === rule.primaryId)?.vacation && (
                      <span className="vacation-tag">В отпуске → резервный</span>
                    )}
                  </td>
                  <td>
                    {name(rule.backupId)}
                    {catalog.users.find((u) => u.id === rule.backupId)?.vacation && (
                      <span className="vacation-tag">В отпуске</span>
                    )}
                  </td>
                  <td className="numeric mono">{rule.responseDays} дн.</td>
                  <td className="numeric mono">{rule.resolutionDays} дн.</td>
                  <td>
                    <button
                      className="icon-button"
                      aria-label={`Редактировать правило: ${rule.category}`}
                      onClick={() => {
                        setEditing({ ...rule });
                        setError('');
                      }}
                    >
                      <Pencil size={15} />
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Panel>
      <div className="routing-explanation">
        <h2>Как выбирается маршрут</h2>
        <p>
          Сначала проверяется совпадение категории и подразделения. Затем — общее правило категории.
          Отпуск влияет на новые обращения; существующие назначения сохраняются. Если оба
          ответственных отсутствуют, форма подачи предлагает исправить правило.
        </p>
        <p>
          Для демонстрации: отправьте руководителя закупок в отпуск и создайте обращение в категории
          «Межотдельное взаимодействие».
        </p>
      </div>
                <p>{t.rejection}</p>
                <p className="small muted">Мотивировка сохранена в истории обращения.</p>
              </div>
            </Panel>
          )}
          {t.changed && ['Реализовано', 'Закрыто', 'Возвращено автором'].includes(t.status) && (
            <Panel title="Что изменилось" aside={<CheckCheck size={17} />}>
              <div className="panel-body">
                <p>{t.changed}</p>
                {t.confirmed && (
                  <div className="success-line">
                    <CheckCheck size={16} />
                    Результат подтверждён автором
                  </div>
                )}
                {author && t.status === 'Реализовано' && (
                  <div className="confirmation">
                    <p>
                      <strong>Проверьте результат в своей работе</strong>
                    </p>
                    <div className="button-row">
                      <button
                        className="primary"
                        disabled={busy}
                        onClick={() =>
                          run(
                            () => confirmResolution(id, true, '', userId),
                            'Решение подтверждено. Обращение закрыто.',
                          )
                        }
                      >
                        <CheckCheck size={16} />
                        Проблема решена
                      </button>
                      <button disabled={busy} onClick={() => setReturning(!returning)}>
                        <CornerUpLeft size={16} />
                        Не решена — вернуть
                      </button>
                    </div>
                    {returning && (
                      <div className="return-form">
                        <Field label="Что осталось нерешённым? *">
                          <textarea
                            rows={3}
                            value={returnReason}
                            onChange={(e) => setReturnReason(e.target.value)}
                          />
                        </Field>
                        <button
                          disabled={busy || returnReason.trim().length < 10}
                          onClick={() =>
                            run(
                              () => confirmResolution(id, false, returnReason, userId),
                              'Обращение возвращено в работу. Срок обновлён.',
                            )
                          }
                          className="primary"
                        >
                          Вернуть ответственному
                        </button>
                      </div>
                    )}
                  </div>
                )}
              </div>
            </Panel>
          )}
          <Panel title="Описание обращения">
            <div className="panel-body">
              <p className="preserve">{t.text}</p>
              {t.solution && (
                <>
                  <h3>Предлагаемое решение</h3>
                  <p className="preserve">{t.solution}</p>
                </>
              )}
              {t.effect && (
                <>
                  <h3>Ожидаемый эффект</h3>
                  <p>{t.effect}</p>
                </>
              )}
              {t.attachments.length > 0 && (
                <div className="attachment-list">
                  {t.attachments.map((file) => (
                    <span className="file-chip" key={file}>
                      <Paperclip size={14} />
                      {file}
                      <small>имя файла</small>
                    </span>
                  ))}
                </div>
              )}
            </div>
          </Panel>
          <Panel title="Обсуждение" aside={<span className="mono muted">{t.comments.length}</span>}>
            <div className="panel-body">
              {!t.comments.length && (
                <p className="muted">
                  Комментариев пока нет. Здесь можно уточнить контекст обращения.
                </p>
              )}
              {t.comments.map((c) => (
                <article className="comment" key={c.id}>
                  <div className="comment-heading">
                    <UserRound size={15} />
                    <strong>{c.author}</strong>
                    <time>{date(c.date)}</time>
                  </div>
                  <p className="preserve">{c.text}</p>
                </article>
              ))}
              {author && t.status === 'Ожидает уточнения' && (
                <div className="inline-attention">
                  <MessageSquare size={16} />
                  Ответьте на запрос. Обращение вернётся на рассмотрение.
                </div>
              )}
              <form
                onSubmit={(e) => {
                  e.preventDefault();
                  run(async () => {
                    await addComment(id, comment, userId);
                    setComment('');
                  }, 'Комментарий сохранён');
                }}
              >
                <Field
                  label={
                    author && t.status === 'Ожидает уточнения'
                      ? 'Ответ на запрос уточнения'
                      : 'Новый комментарий'
                  }
                >
                  <textarea
                    rows={3}
                    placeholder="Добавьте информацию по обращению…"
                    value={comment}
                    onChange={(e) => setComment(e.target.value)}
                    required
                    maxLength={6000}
                  />
                </Field>
                <button disabled={busy || !comment.trim()} className="primary">
                  <Send size={15} />
                  Отправить
                </button>
              </form>
            </div>
          </Panel>
          {t.participants.length > 0 && (
            <Panel
              title="Присоединились к обращению"
              aside={<span className="mono muted">{t.participants.length}</span>}
            >
              <div className="panel-body">
                {t.participants.map((p) => (
                  <article className="participant" key={p.userId}>
                    <strong>{catalog.users.find((u) => u.id === p.userId)?.name}</strong>
                    <small>{p.department}</small>
                    <p>{p.context}</p>
                  </article>
                ))}
              </div>
            </Panel>
          )}
          <Panel title="История событий">
            <ol className="event-history">
              {[...t.events].reverse().map((e) => (
                <li key={e.id}>
                  <span className="history-dot" />
                  <div>
                    <div className="between">
                      <strong>{e.actor}</strong>
                      <time>{date(e.date)}</time>
                    </div>
                    <p>{e.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </Panel>
        </div>
        <aside className="detail-aside">
          <Panel title="Сведения">
            <dl className="meta-list">
              <dt>Автор</dt>
              <dd>{catalog.users.find((u) => u.id === t.authorId)?.name}</dd>
              <dt>Подразделение автора</dt>
              <dd>{t.authorDepartment}</dd>
              <dt>К чему относится</dt>
              <dd>{t.targetDepartment}</dd>
              <dt>Приоритет</dt>
              <dd>{t.priority}</dd>
              <dt>Создано</dt>
              <dd>{date(t.createdAt)}</dd>
              <dt>Первый ответ</dt>
              <dd>{t.firstResponseAt ? date(t.firstResponseAt) : `До ${date(t.responseDueAt)}`}</dd>
              {!t.firstResponseAt && new Date(t.responseDueAt).getTime() < Date.now() && (
                <dd className="overdue">Первый ответ просрочен</dd>
              )}
              {t.type === 'Проблема' && (
                <>
                  <dt>Стоимость проблемы</dt>
                  <dd className="cost-number">
                    <span className="mono">≈ {number(cost(t))}</span> чел.-ч/мес
                    <small>
                      {t.frequency}, {t.minutes} мин за раз · включая оценки участников
                    </small>
                  </dd>
                </>
              )}
            </dl>
          </Panel>
          {manager && !terminal(t) && (
            <Panel title="Действия ответственного">
              <div className="panel-body">
                <form
                  onSubmit={(e) => {
                    e.preventDefault();
                    run(async () => {
                      await updateStatus(id, status, actionText, userId);
                      setActionText('');
                      setDraft('');
                    }, 'Статус и история обновлены');
                  }}
                >
                  <Field label="Новый статус">
                    <select
                      value={status}
                      onChange={(e) => {
                        setStatus(e.target.value as Status);
                        setDraft('');
                      }}
                    >
                      {(
                        [
                          'На рассмотрении',
                          'В работе',
                          'Ожидает уточнения',
                          'Реализовано',
                          'Отклонено',
                        ] as Status[]
                      ).map((s) => (
                        <option disabled={s === t.status} key={s}>
                          {s}
                        </option>
                      ))}
                    </select>
                  </Field>
                  {status === 'Отклонено' && (
                    <Field label="Шаблон мотивировки">
                      <select
                        defaultValue=""
                        onChange={(e) => {
                          if (e.target.value) setActionText(e.target.value);
                        }}
                      >
                        <option value="">Выберите шаблон</option>
                        <option>
                          Сейчас нет подходящего помещения. Вернёмся к вопросу при перепланировке
                          рабочих помещений.
                        </option>
                        <option>
                          Реализация требует ресурсов, которые не предусмотрены в текущем плане.
                          Повторно рассмотрим предложение в следующем квартале.
                        </option>
                        <option>
                          Предложенное изменение не соответствует обязательным требованиям
                          безопасности. Предлагаем обсудить альтернативное решение.
                        </option>
                      </select>
                    </Field>
                  )}
                  <Field
                    label={
                      status === 'Реализовано'
                        ? 'Что изменилось *'
                        : status === 'Отклонено'
                          ? 'Мотивировка отказа *'
                          : status === 'Ожидает уточнения'
                            ? 'Что нужно уточнить *'
                            : 'Комментарий к действию'
                    }
                  >
                    <textarea
                      rows={5}
                      value={actionText}
                      onChange={(e) => setActionText(e.target.value)}
                      required={['Реализовано', 'Отклонено', 'Ожидает уточнения'].includes(status)}
                      minLength={
                        ['Реализовано', 'Отклонено', 'Ожидает уточнения'].includes(status)
                          ? 10
                          : undefined
                      }
                    />
                  </Field>
                  <button
                    type="button"
                    className="text-button"
                    disabled={busy}
                    onClick={() =>
                      run(
                        async () => setDraft(await draftResponse(id, status, userId)),
                        'Черновик подготовлен. Проверьте и отредактируйте текст.',
                      )
                    }
                  >
                    <Wand2 size={15} />
                    Черновик ответа
                  </button>
                  {draft && (
                    <div className="system-box">
                      <span className="quiet-label">Автоподсказка</span>
                      <p className="small">{draft}</p>
                      <div className="button-row">
                        <button
                          type="button"
                          onClick={() => {
                            setActionText(draft);
                            setDraft('');
                          }}
                        >
                          Принять
                        </button>
                        <button type="button" onClick={() => setDraft('')}>
                          Отклонить
                        </button>
                      </div>
                    </div>
                  )}
                  <button
                    className="primary full-width"
                    disabled={
                      busy ||
                      status === t.status ||
                      (['Реализовано', 'Отклонено', 'Ожидает уточнения'].includes(status) &&
                        actionText.trim().length < 10)
                    }
                  >
                    Сохранить решение
                  </button>
                </form>
                <hr />
                <form
                  onSubmit={(e) => {
                    e.preventDefault();
                    run(async () => {
                      await reassign(id, assignee, reason, userId);
                      setReason('');
                      navigate('/inbox');
                    }, 'Обращение переназначено');
                  }}
                >
                  <h3>Переназначить</h3>
                  <Field label="Новый ответственный">
                    <select value={assignee} onChange={(e) => setAssignee(e.target.value)}>
                      {catalog.users
                        .filter((u) => u.role === 'Руководитель')
                        .map((u) => (
                          <option key={u.id} value={u.id} disabled={u.vacation}>
                            {u.name}
                            {u.vacation ? ' · в отпуске' : ''}
                          </option>
                        ))}
                    </select>
                  </Field>
                  <Field label="Причина переназначения *">
                    <textarea
                      rows={2}
                      value={reason}
                      onChange={(e) => setReason(e.target.value)}
                      required
                      minLength={10}
                    />
                  </Field>
                  <button disabled={busy || assignee === t.assigneeId || reason.trim().length < 10}>
                    Переназначить
                  </button>
                </form>
              </div>
            </Panel>
          )}
          {t.clusterId && (
            <Panel title="Связанные обращения" aside={<ScanSearch size={16} />}>
              <div className="panel-body">
                <h3>{catalog.clusters.find((c) => c.id === t.clusterId)?.title}</h3>
                <p className="small muted">Доступная вам часть кластера</p>
                <div className="cluster-cost">
                  <strong className="mono">
                    ≈ {number(related.reduce((sum, item) => sum + cost(item), 0))}
                  </strong>
                  <span>чел.-ч/мес</span>
                </div>
                <p className="small">
                  {[
                    ...new Set(
                      related.flatMap((item) => [
                        item.authorDepartment,
                        item.targetDepartment,
                        ...item.participants.map((p) => p.department),
                      ]),
                    ),
                  ].join(', ')}
                </p>
                {related
                  .filter((item) => item.id !== id)
                  .slice(0, 6)
                  .map((item) => (
                    <Link className="related-link" to={`/tickets/${item.id}`} key={item.id}>
                      <span className="mono">{item.id}</span>
                      {item.title}
                    </Link>
                  ))}
                {manager && (
                  <Link to={`/analytics?cluster=${t.clusterId}`} className="text-button">
                    Весь кластер в аналитике
                  </Link>
                )}
              </div>
            </Panel>
          )}
        </aside>
      </div>
    </>
  );
}

