+import { Send } from 'lucide-react';
+import type { RoutePreview } from '../../types';
+import { date } from '../../lib/format';
+
+export function RoutingPreview({ route }: { route: RoutePreview }) {
+  return <div className="route-preview"><Send size={18}/><div>
+    <strong>Обращение получит: {route.assignee.name}</strong>
+    {route.fallback && <p className="overdue">
+      {route.primary.name} в отпуске. Выбран резервный ответственный.
+    </p>}
+    <p>Первый ответ до <b>{date(route.responseDueAt)}</b> · решение до {date(route.dueAt)}</p>
+    <small>{route.responseDays} и {route.resolutionDays} рабочих дней по правилу категории</small>
+  </div></div>;
+}
diff --git a/frontend/src/pages/new-ticket/SimilarTickets.tsx b/frontend/src/pages/new-ticket/SimilarTickets.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..dec467b0e707d24db0db1b59d84808f0b603ec36
--- /dev/null
+++ b/frontend/src/pages/new-ticket/SimilarTickets.tsx
@@ -0,0 +1,70 @@
+import { useEffect, useState, type Dispatch, type SetStateAction } from 'react';
+import { Link } from 'react-router-dom';
+import { ArrowRight, ScanSearch } from 'lucide-react';
+import { findSimilar } from '../../api';
+import type { SimilarTicket, TicketDraft } from '../../types';
+import { useApp } from '../../store';
+import { cost, number } from '../../lib/format';
+import { Badge, Empty, ErrorMessage, Loading, Panel } from '../../components/ui';
+import { JoinTicket } from './JoinTicket';
+
+export function SimilarTickets({ draft, setDraft }: {
+  draft: TicketDraft;
+  setDraft: Dispatch<SetStateAction<TicketDraft>>;
+}) {
+  const { userId } = useApp();
+  const [similar, setSimilar] = useState<SimilarTicket[]>([]);
+  const [finding, setFinding] = useState(false);
+  const [joinId, setJoinId] = useState('');
+  const [error, setError] = useState('');
+  useEffect(() => {
+    let live = true;
+    setFinding(draft.text.length >= 8);
+    setError('');
+    const timer = setTimeout(() => {
+      findSimilar(draft.text, userId, {
+        category: draft.category, targetDepartment: draft.targetDepartment,
+      }).then((tickets) => { if (live) setSimilar(tickets); })
+        .catch((error) => { if (live) setError(error.message); })
+        .finally(() => { if (live) setFinding(false); });
+    }, 450);
+    return () => { live = false; clearTimeout(timer); };
+  }, [draft.text, draft.category, draft.targetDepartment, userId]);
+  return <aside className="similar-panel">
+    <Panel title="Похожие обращения" aside={<ScanSearch size={17}/>}>
+      <div className="panel-body">
+        <p className="muted small">Возможно, эту проблему уже решают. Присоединитесь и добавьте свой контекст.</p>
+        <ErrorMessage text={error}/>
+        {finding ? <Loading/> : !similar.length ? <Empty text={draft.text.length < 8
+          ? 'Начните описывать ситуацию' : 'Похожих открытых обращений нет'}/> : similar.map((ticket) => {
+          const joined = ticket.authorId === userId
+            || ticket.participants.some((participant) => participant.userId === userId);
+          const departments = new Set([
+            ticket.authorDepartment, ...ticket.participants.map((participant) => participant.department),
+          ]);
+          return <article className="similar-card" key={ticket.id}>
+            <div className="between"><span className="mono ticket-id">{ticket.id}</span>
+              <Badge status={ticket.status}/></div>
+            <h3>{ticket.title}</h3>
+            <p className="match-explanation">{ticket.matchExplanation}</p>
+            <p className="small muted">{ticket.participants.length + 1} участников · {departments.size} подразделения</p>
+            {ticket.type === 'Проблема' && <div className="small">
+              ≈ <span className="mono">{number(cost(ticket))}</span> чел.-ч/мес
+            </div>}
+            {joined ? <Link className="text-button" to={`/tickets/${ticket.id}`}>
+              Уже в ваших обращениях <ArrowRight size={14}/>
+            </Link> : <button type="button" className="text-button"
+              onClick={() => setJoinId(joinId === ticket.id ? '' : ticket.id)}>
+              У меня то же самое → присоединиться
+            </button>}
+            {joinId === ticket.id && <JoinTicket key={ticket.id} ticketId={ticket.id}
+              problem={ticket.type === 'Проблема'} draft={draft} setDraft={setDraft}/>}
+          </article>;
+        })}
+      </div>
+    </Panel>
+    <div className="privacy-note"><strong>Что произойдёт дальше</strong>
+      <p>Ответственный увидит обращение в очереди. Все ответы, изменения статуса и результат появятся в карточке обращения.</p>
+    </div>
+  </aside>;
+}
diff --git a/frontend/src/pages/new-ticket/StructureSuggestion.tsx b/frontend/src/pages/new-ticket/StructureSuggestion.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0b60c3e8cf39c3c83e346844c1312a2ee23d3574
--- /dev/null
+++ b/frontend/src/pages/new-ticket/StructureSuggestion.tsx
@@ -0,0 +1,46 @@
+import { useEffect, useState } from 'react';
+import { Check, ScanSearch, Wand2 } from 'lucide-react';
+import { suggestStructure } from '../../api';
+import type { Structure } from '../../types';
+import { ErrorMessage } from '../../components/ui';
+
+export function StructureSuggestion({ text, busy, setBusy, onAccept }: {
+  text: string;
+  busy: boolean;
+  setBusy: (busy: boolean) => void;
+  onAccept: (structure: Structure) => void;
+}) {
+  const [structure, setStructure] = useState<Structure | null>(null);
+  const [error, setError] = useState('');
+  useEffect(() => setStructure(null), [text]);
+  return <>
+    <div className="structure-button">
+      <button type="button" disabled={busy || text.trim().length < 20} onClick={async () => {
+        setBusy(true);
+        setError('');
+        try { setStructure(await suggestStructure(text)); }
+        catch (error) { setError((error as Error).message); }
+        finally { setBusy(false); }
+      }}><Wand2 size={16}/>Структурировать текст</button>
+      <small>Автоподсказка · текст можно проверить</small>
+    </div>
+    <ErrorMessage text={error}/>
+    {structure && <div className="system-box">
+      <div className="section-label"><ScanSearch size={16}/><strong>Предлагаемая структура</strong>
+        <span className="badge blue">Автоподсказка</span></div>
+      <dl className="structure">
+        <dt>Кратко о сути</dt><dd>{structure.title}</dd>
+        <dt>Проблема</dt><dd>{structure.problem}</dd>
+        <dt>Предлагаемое решение</dt><dd>{structure.solution}</dd>
+        <dt>Ожидаемый эффект</dt><dd>{structure.effect}</dd>
+      </dl>
+      <p className="small">Категория: {structure.category} · Приоритет: {structure.priority}</p>
+      <div className="button-row">
+        <button type="button" onClick={() => { onAccept(structure); setStructure(null); }}>
+          <Check size={15}/>Принять
+        </button>
+        <button type="button" onClick={() => setStructure(null)}>Отклонить</button>
+      </div>
+    </div>}
+  </>;
+}
