];
type Datum = { label: string; value: number };

export function Distribution({
  title,
  data,
  limit,
}: {
  title: string;
  data: Datum[];
  limit?: number;
}) {
  const [expanded, setExpanded] = useState(false);
  const total = data.reduce((sum, item) => sum + item.value, 0);
  const top = limit ? data.slice(0, limit) : data;
  const remaining = limit ? data.slice(limit) : [];
  const otherCount = remaining.reduce((sum, item) => sum + item.value, 0);
  const displayed = remaining.length
    ? [...top, { label: `Прочие (${remaining.length})`, value: otherCount }]
    : top;
  const values = (value: number) => (
    <>
      <strong className="mono">{value}</strong>
      <small className="mono">{total ? Math.round((value / total) * 100) : 0}%</small>
    </>
  );
  return (
    <Panel title={title}>
      <div className="distribution">
        <div
          className="stacked-bar"
          role="img"
          aria-label={displayed.map((item) => `${item.label}: ${item.value}`).join(', ')}
        >
          {displayed.map((item, index) => (
            <span
              key={item.label}
              title={`${item.label}: ${item.value}`}
              style={{
                width: `${total ? (item.value / total) * 100 : 0}%`,
                background: palette[index % palette.length],
              }}
            />
          ))}
        </div>
        {top.map((item, index) => (
          <div className="distribution-row" key={item.label}>
            <span
              className="legend-square"
              style={{ background: palette[index % palette.length] }}
            />
            <span>{item.label}</span>
            {values(item.value)}
          </div>
        ))}
        {remaining.length > 0 && (
          <>
            <button
              className="distribution-row other-categories"
              aria-expanded={expanded}
              aria-controls="other-category-list"
              onClick={() => setExpanded(!expanded)}
                width={step - 4}
                height="193"
                fill="transparent"
              />
              <rect
                x={center - barWidth - 2}
                y={y(week.incoming)}
                width={barWidth}
                height={baseline - y(week.incoming)}
                fill="#1E3A5F"
                rx="2"
              />
              <rect
                x={center + 2}
                y={y(week.done)}
                width={barWidth}
                height={baseline - y(week.done)}
                fill="#A3B7C9"
                rx="2"
              />
              <text x={center} y="237" textAnchor="middle" fill="#6C7785" fontSize="11">
                {date(week.start).split(' ').slice(0, 2).join(' ')}
              </text>
            </g>
          );
        })}
      </svg>
      <p className="weekly-chart-caption">Текущая неделя не завершена</p>
      {active && hovered !== null && (
        <div
          className="chart-tooltip"
          role="tooltip"
          style={{
            left: Math.max(0, Math.min(width - 190, 37 + step * (hovered + 0.5) - 85)),
          }}
        >
          <strong>Неделя с {date(active.start)}</strong>
          <span>
            Новые: <b>{active.incoming}</b>
          </span>
          <span>
            Реализовано: <b>{active.done}</b>
          </span>
        </div>
      )}
    </div>
  );
