        : `Спасибо за обращение «${t.title}». Приняли в работу. Проверим описанную ситуацию и зафиксируем результат в этой карточке.`;
}
import { catalogBase } from '../data/seed';
import { terminal } from '../lib/format';
import type { Analytics } from '../types';
import { db, pause, clone, user } from './storage';

export async function getAnalytics(days: number, userId: string): Promise<Analytics> {
  await pause();
  if (user(userId).role !== 'Руководитель') throw new Error('Аналитика доступна руководителю');
  const tickets = db.tickets.filter(
    (t) => !days || Date.now() - new Date(t.createdAt).getTime() <= days * 86400000,
  );
  const hours = tickets
    .filter((t) => t.firstResponseAt)
    .map(
      (t) => (new Date(t.firstResponseAt!).getTime() - new Date(t.createdAt).getTime()) / 3600000,
    )
    .sort((a, b) => a - b);
  const percent = (n: number) => (tickets.length ? (n / tickets.length) * 100 : 0);
  const inPeriod = (value?: string) =>
    !!value && (!days || Date.now() - new Date(value).getTime() <= days * 86400000);
  const clusterTrends = Object.fromEntries(
    catalogBase.clusters.map((c) => {
      const list = db.tickets.filter((t) => t.clusterId === c.id);
      const recent = list.filter(
        (t) => Date.now() - new Date(t.createdAt).getTime() <= 30 * 86400000,
      ).length;
      const previous = list.filter((t) => {
        const age = Date.now() - new Date(t.createdAt).getTime();
        return age > 30 * 86400000 && age <= 60 * 86400000;
      }).length;
      return [c.id, recent - previous];
    }),
  );
  return clone({
    tickets,
    clusters: catalogBase.clusters,
    clusterTrends,
    departments: catalogBase.departments,
    users: db.users,
    considered: percent(tickets.filter((t) => !!t.firstResponseAt).length),
    medianHours: hours.length
      ? (hours[Math.floor((hours.length - 1) / 2)] + hours[Math.floor(hours.length / 2)]) / 2
      : 0,
    averageHours: hours.length ? hours.reduce((a, b) => a + b, 0) / hours.length : 0,
    resultRate: percent(
      tickets.filter((t) => terminal(t) && (!!t.changed || !!t.rejection)).length,
    ),
    implemented: db.tickets.filter(
      (t) => ['Реализовано', 'Закрыто'].includes(t.status) && inPeriod(t.implementedAt),
    ).length,
    confirmed: db.tickets.filter((t) => t.confirmed && inPeriod(t.closedAt)).length,
  });
}
import { detectCluster } from '../data/seed';
import { businessDays, overdue, terminal } from '../lib/format';
import type { Frequency, Status, Ticket, TicketDraft, TicketFilters } from '../types';
import { db, pause, clone, user, ticket, canRead, assertManager, event, persist } from './storage';
import { route } from './routing';
function filterTickets(tickets: Ticket[], f: TicketFilters) {
  return tickets.filter(
    (t) =>
      (!f.search ||
        `${t.id} ${t.title} ${t.text}`.toLowerCase().includes(f.search.toLowerCase())) &&
      (!f.department || t.targetDepartment === f.department) &&
      (!f.category || t.category === f.category) &&
      (!f.status || t.status === f.status) &&
      (!f.priority || t.priority === f.priority) &&
      (!f.overdue || overdue(t)) &&
      (!f.cluster || t.clusterId === f.cluster) &&
      (!f.authorDepartment || t.authorDepartment === f.authorDepartment) &&
      (!f.targetDepartment || t.targetDepartment === f.targetDepartment),
  );
}

export async function listTickets(userId: string, filters: TicketFilters = {}): Promise<Ticket[]> {
  await pause();
  return clone(
    filterTickets(
      db.tickets.filter((t) => canRead(user(userId), t)),
      filters,
    ).sort((a, b) => b.createdAt.localeCompare(a.createdAt)),
  );
}
export async function getTicket(id: string, userId: string): Promise<Ticket> {
  await pause();
  const t = ticket(id);
  if (!canRead(user(userId), t))
    throw new Error(
      'Обращение недоступно для выбранного пользователя. Выберите автора или ответственного.',
    );
  return clone(t);
}
export async function createTicket(draft: TicketDraft, userId: string) {
  await pause();
  const author = user(userId);
  if (author.role !== 'Сотрудник') throw new Error('Подача доступна в роли сотрудника');
  if (draft.text.trim().length < 20) throw new Error('Опишите ситуацию: минимум 20 символов');
  const routing = route(draft.category, draft.targetDepartment);
  const now = new Date().toISOString();
  const t: Ticket = {
    ...clone(draft),
    id: `N-${String(db.tickets.filter((t) => t.id.startsWith('N-')).length + 1).padStart(3, '0')}`,
    text: draft.text.trim(),
    title: draft.text
      .trim()
      .split(/[.!?\n]/)[0]
      .slice(0, 100),
    authorId: userId,
    authorDepartment: author.department,
    assigneeId: routing.assignee.id,
    status: 'Новое',
    createdAt: now,
    responseDueAt: routing.responseDueAt,
    dueAt: routing.dueAt,
    events: [],
    comments: [],
    participants: [],
    changed: '',
    rejection: '',
    confirmed: false,
    clusterId: detectCluster(draft.text),
  };
  event(
    t,
    author,
    `Зарегистрировано. Назначен: ${routing.assignee.name}${routing.fallback ? ' (резервный: основной в отпуске)' : ''}. Первый ответ до ${new Date(routing.responseDueAt).toLocaleDateString('ru-RU')}`,
    'Новое',
  );
  db.tickets.push(t);
  persist();
  return clone(t);
}
export async function updateStatus(id: string, status: Status, text: string, userId: string) {
  await pause();
  const t = ticket(id);
  const actor = user(userId);
  assertManager(actor, t);
  if (
    !['На рассмотрении', 'В работе', 'Ожидает уточнения', 'Реализовано', 'Отклонено'].includes(
