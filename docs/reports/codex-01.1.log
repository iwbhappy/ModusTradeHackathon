diff --git a/frontend/src/lib/title.ts b/frontend/src/lib/title.ts
new file mode 100644
index 0000000000000000000000000000000000000000..224bb4ffaf2ffe9e062fb8f01178149e965355e4
--- /dev/null
+++ b/frontend/src/lib/title.ts
@@ -0,0 +1,14 @@
+const TITLE_LIMIT = 80;
+
+export function makeTitle(text: string, provided = ''): string {
+  if (provided.trim()) return provided.trim();
+  const sentence = text.trim().split(/[.!?\n]/u)[0].trim();
+  if (sentence.length <= TITLE_LIMIT) return sentence;
+  const words = sentence.split(/\s+/u);
+  const result: string[] = [];
+  for (const word of words) {
+    if ([...result, word].join(' ').length > TITLE_LIMIT - 1) break;
+    result.push(word);
+  }
+  return `${result.join(' ') || 'Обращение'}…`;
+}
