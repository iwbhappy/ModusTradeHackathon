+export interface SeedEntry {
+  id: string;
+  title: string;
+  text: string;
+  category: string;
+  authorId: string;
+  targetDepartment: string;
+  assigneeId?: string;
+  type?: TicketType;
+  priority?: Priority;
+  status: Status;
+  clusterId: string;
+  createdDaysAgo: number;
+  resolvedDaysAgo?: number;
+  responseHours?: number;
+  changed?: string;
+  rejection?: string;
