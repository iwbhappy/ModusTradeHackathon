  X,
} from 'lucide-react';
import { createTicket, findSimilar, joinTicket, previewRouting, suggestStructure } from '../api';
import { useApp } from '../store';
import type { Frequency, RoutePreview, Structure, Ticket, TicketDraft, TicketType } from '../types';
import { cost, date, monthly, number } from '../lib/format';
import { Badge, Empty, ErrorMessage, Field, Loading, PageTitle, Panel } from '../components/ui';

export function CostFields({
  frequency,
  minutes,
  onChange,
}: {
  frequency: Frequency;
  minutes: number;
  onChange: (frequency: Frequency, minutes: number) => void;
}) {
  return (
    <div className="form-grid">
      <Field label="Как часто?">
        <select value={frequency} onChange={(e) => onChange(e.target.value as Frequency, minutes)}>
          {['ежедневно', 'еженедельно', 'ежемесячно', 'разово'].map((f) => (
            <option key={f}>{f}</option>
          ))}
        </select>
      </Field>
      <Field label="Сколько времени теряете за раз?">
        <select value={minutes} onChange={(e) => onChange(frequency, Number(e.target.value))}>
          {[
            [15, '≈ 15 мин'],
            [30, '≈ 30 мин'],
            [60, '≈ 1 ч'],
            [120, '≈ 2 ч+'],
          ].map(([v, label]) => (
            <option key={v} value={v}>
              {label}
            </option>
          ))}
        </select>
      </Field>
    </div>
  );
}
