                  </td>
                  <td>
                    {name(rule.primaryId)}
                    {catalog.users.find((u) => u.id === rule.primaryId)?.vacation && (
                      <span className="vacation-tag">В отпуске → резервный</span>
                    )}
                  </td>
                  <td>
                    {name(rule.backupId)}
                    {catalog.users.find((u) => u.id === rule.backupId)?.vacation && (
                      <span className="vacation-tag">В отпуске</span>
