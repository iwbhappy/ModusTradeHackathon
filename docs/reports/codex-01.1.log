@@ -0,0 +1,91 @@
+import type { SeedEntry } from '../seed-entry';
+
+export const operationsTickets: SeedEntry[] = [
+  {
+    id: 'S-031', title: 'Приоритет заявки в IT виден только в переписке',
+    text: 'При оформлении заявки в IT не могу отметить, что остановилась выдача комплектов со склада. Пишу дополнительно в чат, но эта информация не попадает к резервному специалисту.',
+    category: 'Интеграции и IT', authorId: 'specialist-6',
+    targetDepartment: 'IT-разработка', assigneeId: 'manager-7', priority: 'Высокий',
+    status: 'Новое', clusterId: 'systems', createdDaysAgo: 0,
+    comments: [],
+  },
+  {
+    id: 'S-032', title: 'Разные суммы в договоре и приложении',
+    text: 'При изменении состава оборудования поправили приложение к договору, а итоговую сумму в основном тексте не обновили. Несоответствие заметили на повторном согласовании.',
+    category: 'Договорная работа', authorId: 'employee-3',
+    targetDepartment: 'Продажи', status: 'Закрыто', clusterId: 'documents',
+    createdDaysAgo: 19, resolvedDaysAgo: 5,
+    changed: 'Перед отправкой на согласование проверяется соответствие сумм договора и приложений. В листе проверки фиксируются номера редакций всех связанных документов и дата сверки.',
+    comments: ['Контроль нужен после каждого изменения комплекта, а не только перед первой отправкой.', 'Пакет после следующей замены оборудования прошёл сверку без расхождений.'],
+  },
+  {
+    id: 'S-033', title: 'Повторный перенос реквизитов в документы закрытия',
+    text: 'Реквизиты для закрывающих документов копирую из CRM в учётную систему вручную. Иногда используется старая карточка, и приходится перевыпускать документы.',
+    category: 'Интеграции и IT', authorId: 'employee-3',
+    targetDepartment: 'IT-разработка', assigneeId: 'manager-7',
+    status: 'Закрыто', clusterId: 'systems', createdDaysAgo: 18, resolvedDaysAgo: 4,
+    changed: 'Для документов закрытия используется единая подтверждённая версия реквизитов. При переносе фиксируются источник и дата проверки; несовпадение версий блокирует автоматическое заполнение.',
+    comments: ['Переносить будем только проверенные поля; изменения платёжных реквизитов требуют отдельного подтверждения.', 'На новом пакете повторный ввод не понадобился, версия реквизитов совпала.'],
+  },
+  {
+    id: 'S-034', title: 'Кто собирает итоговый пакет по этапу работ',
+    text: 'У инженера есть протоколы, у координатора — ведомость оборудования, у бухгалтерии — формы актов. Неясно, кто собирает единый пакет закрытия этапа и проверяет его полноту.',
+    category: 'Документооборот', authorId: 'employee-5',
+    targetDepartment: 'Бухгалтерия', status: 'На рассмотрении', clusterId: 'documents',
+    createdDaysAgo: 2,
+    comments: ['Предлагаем закрепить сбор пакета за координатором, а проверку состава — за бухгалтерией. Уточняем границу ответственности.'],
+  },
+  {
+    id: 'S-035', title: 'Закрывать сервисный этап до получения подписанного акта',
+    text: 'Чтобы очередь не висела, предлагаю закрывать этап сервиса сразу после выезда. Подписанный акт можно дособрать позже.',
+    category: 'Регламенты', authorId: 'employee-5',
+    targetDepartment: 'Бухгалтерия', type: 'Предложение', status: 'Отклонено',
+    clusterId: 'documents', createdDaysAgo: 17, resolvedDaysAgo: 3,
+    rejection: 'Закрытие до подтверждающих документов скрывает незавершённые обязательства. Оставляем этап открытым, но отделяем техническое завершение выезда от ожидания подписанного акта.',
+    comments: ['Не будем смешивать завершение работ с завершением документооборота: это разные контрольные точки.', 'Раздельные отметки решат вопрос видимости, предложение о досрочном закрытии снимаю.'],
+  },
+  {
+    id: 'S-036', title: 'Короткий справочник совместимости считывателей',
+    text: 'Менеджеры регулярно спрашивают инженера об одних и тех же сочетаниях контроллеров и считывателей. Было бы удобно иметь проверенную таблицу для предварительного подбора.',
+    category: 'Знания и наставничество', authorId: 'employee-4',
+    targetDepartment: 'Проектирование', type: 'Предложение', status: 'Реализовано',
+    clusterId: 'knowledge', createdDaysAgo: 16, resolvedDaysAgo: 1,
+    changed: 'Опубликована таблица проверенных сочетаний контроллеров и считывателей с интерфейсом и ограничениями. Назначен инженер, который обновляет её после стендовой проверки новой пары.',
+    comments: ['В таблице явно напишем, что это помощь для предварительного подбора, а не замена проектной проверки.'],
+  },
+  {
+    id: 'S-037', title: 'Итог технического совещания остаётся в личных заметках',
+    text: 'Обсудили замену оборудования и порядок поставки, но участники записали разные договорённости. Через день пришлось собираться повторно.',
+    category: 'Коммуникации', authorId: 'employee-6',
+    targetDepartment: 'Проектирование', status: 'Закрыто', clusterId: 'decisions',
+    createdDaysAgo: 15, resolvedDaysAgo: 2,
+    changed: 'Координатор публикует итог технического совещания в общей карточке: решение, владелец и дата исполнения. Участники подтверждают протокол до передачи заданий в смежные отделы.',
+    comments: ['Давайте подтверждать только итог, стенограмму всей встречи вести не нужно.', 'На следующем совещании протокол согласовали в тот же день, повторного обсуждения не потребовалось.'],
+  },
+  {
+    id: 'S-038', title: 'Статус проверки приложения к договору',
+    text: 'Приложение к договору на монтаж ушло на проверку, но видно только «на согласовании». Нужно понимать, ожидаем техническую проверку или замечания по документам.',
+    category: 'Договорная работа', authorId: 'employee-4',
+    targetDepartment: 'Продажи', status: 'Закрыто', clusterId: 'documents',
+    createdDaysAgo: 14, resolvedDaysAgo: 1,
+    changed: 'Маршрут согласования приложения разделён на техническую и документальную проверку. По каждому шагу отображаются ответственный, срок и открытые замечания.',
+    comments: ['Параллельную проверку оставим, но у каждого направления будет собственный статус.', 'Теперь понятно, у кого остаётся вопрос; звонить всем участникам по очереди не приходится.'],
+  },
+  {
+    id: 'S-039', title: 'Загрузка проектировщика при срочной замене оборудования',
+    text: 'Срочные проверки аналогов приходят поверх планового выпуска документации. Не вижу, какие замены можно отдать другому инженеру без потери контекста.',
+    category: 'Планирование ресурсов', authorId: 'employee-6',
+    targetDepartment: 'Проектирование', status: 'В работе', clusterId: 'decisions',
+    createdDaysAgo: 3,
+    comments: ['Собираем список замен с необходимой специализацией, чтобы распределять их без передачи всей документации.', 'Отдельно отмечу задания, где уже есть результаты проверки совместимости.'],
+  },
+  {
+    id: 'S-040', title: 'Лист готовности комплекта к отгрузке',
+    text: 'Камеры, накопители и крепления поступают в разные дни. Продажи видят отдельные приходы, но не могут ответить, собран ли уже комплект для передачи на монтаж.',
+    category: 'Информационная прозрачность', authorId: 'employee-4',
+    targetDepartment: 'Склад и логистика', status: 'Закрыто', clusterId: 'purchase',
+    createdDaysAgo: 13, resolvedDaysAgo: 0,
+    changed: 'У комплекта появился лист готовности с остатком неполученных позиций. Склад подтверждает полную комплектацию отдельной отметкой; менеджер видит её без доступа к закупочным ценам.',
+    comments: ['Частичную отгрузку тоже нужно отмечать, иначе лист будет показывать готовность уже выданного оборудования.', 'Разделение на выдано и готово к выдаче проверили: остаток комплекта отображается корректно.'],
+  },
+];
