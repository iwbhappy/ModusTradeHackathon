+    category: 'Проектная деятельность', authorId: 'employee-2',
+    targetDepartment: 'Проектирование', type: 'Предложение', status: 'Реализовано',
+    clusterId: 'documents', createdDaysAgo: 34, resolvedDaysAgo: 5,
+    changed: 'К новой редакции спецификации СКУД прикладывается ведомость отличий с номерами строк и причиной изменения. Проектная группа использует её при внутренней проверке перед выпуском.',
+    comments: ['Подойдёт ведомость с тремя разделами: добавлено, удалено, заменено.', 'Да, только сохраните номера строк предыдущей версии для сверки.'],
+  },
+  {
+    id: 'S-013', title: 'Кто подтверждает ёмкость аккумуляторов ОПС',
+    text: 'После добавления извещателей неясно, кто должен пересчитать резервное питание ОПС. Каждый считает, что это уже проверил смежный специалист.',
+    category: 'Постановка задач', authorId: 'employee-6',
+    targetDepartment: 'Проектирование', status: 'Закрыто', clusterId: 'decisions',
+    createdDaysAgo: 33, resolvedDaysAgo: 17,
+    changed: 'В лист проверки изменений ОПС включён пересчёт резервного питания с подписью инженера раздела. Без отметки проверяющего новая спецификация не передаётся в закупку.',
+    comments: ['Владельцем расчёта будет инженер раздела, проверку выполняет ведущий проектировщик.', 'На следующем изменении расчёт приложили сразу; вопрос между отделами снят.'],
+  },
+  {
+    id: 'S-014', title: 'Требования к архиву видео в исходных данных',
+    text: 'Подбираем регистратор, но глубина архива и режим записи остаются только в устном обсуждении. Потом меняется количество дисков и приходится пересчитывать КП.',
+    category: 'Межотдельное взаимодействие', authorId: 'employee-2',
+    targetDepartment: 'Продажи', status: 'Закрыто', clusterId: 'purchase',
+    createdDaysAgo: 32, resolvedDaysAgo: 16,
+    changed: 'В исходных данных на видеонаблюдение фиксируются глубина архива, разрешение и режим записи. Менеджер подтверждает эти параметры перед подбором накопителей и подготовкой КП.',
+    comments: ['Для первичного расчёта достаточно режима записи и требуемого срока хранения.', 'Параметры внесены в исходные данные. Повторный расчёт дисков больше не понадобился.'],
+  },
+  {
+    id: 'S-015', title: 'Автоматическое одобрение всех аналогов по цене',
+    text: 'Можно ли разрешить закупщику менять оборудование на более дешёвый аналог без проверки проектировщиком, если основные характеристики совпадают?',
+    category: 'Регламенты', authorId: 'employee-1',
+    targetDepartment: 'Проектирование', type: 'Предложение', status: 'Отклонено',
+    clusterId: 'catalog', createdDaysAgo: 31, resolvedDaysAgo: 14,
+    rejection: 'Совпадения основных характеристик недостаточно для проверки совместимости СКУД и ОПС. Автоматическое одобрение отклонено; ускорять будем проверку по заранее согласованному перечню допустимых аналогов.',
+    comments: ['Есть риск несовместимости протоколов и лицензий, который не виден в сравнении цен.', 'Тогда предложу инженеру заполнить перечень для часто используемых позиций.'],
+  },
+  {
+    id: 'S-016', title: 'Версия схемы для выезда наладчика',
+    text: 'Наладчик получил распечатку схемы до последнего изменения числа точек доступа. В общей папке лежат обе версии, и непонятно, какую брать на выезд.',
+    category: 'Хранение документов', authorId: 'specialist-5',
+    targetDepartment: 'Проектирование', status: 'Закрыто', clusterId: 'documents',
+    createdDaysAgo: 30, resolvedDaysAgo: 13,
+    changed: 'Для выезда формируется отдельная папка «Комплект для ПНР» с утверждённой версией схемы и датой выпуска. Старые редакции перемещаются в архив с пометкой «не для производства работ».',
+    comments: ['Нужна одна ссылка на утверждённый комплект, иначе офлайн-копии снова разойдутся.', 'Ссылка получена, на выезд выгрузили только утверждённую редакцию.'],
+  },
+  {
+    id: 'S-017', title: 'Доступ к исполнительной документации с телефона',
+    text: 'На ПНР приходится звонить в офис за каждой схемой: с телефона папка исполнительной документации открывается только частично. Нужен доступ к утверждённому комплекту без лишних разделов.',
+    category: 'Интеграции и IT', authorId: 'specialist-5',
+    targetDepartment: 'IT-разработка', assigneeId: 'manager-7',
+    status: 'Возвращено автором', clusterId: 'systems', createdDaysAgo: 8, resolvedDaysAgo: 2,
+    changed: 'Настроен мобильный просмотр утверждённых PDF-схем в отдельной папке с ограниченным доступом.',
+    comments: ['Проверьте доступ вне офисной сети, в том числе к схемам большого размера.', 'Небольшие файлы открываются, но многостраничная схема на мобильном соединении не загружается. Прошу доработать.'],
+  },
+  {
+    id: 'S-018', title: 'Проверка лицензий при подборе видеосервера',
+    text: 'В составе комплекта указали видеосервер, но забыли лицензии на часть каналов. На согласовании КП это не видно, потому что лицензии вынесены в другой раздел.',
+    category: 'Каталог и данные', authorId: 'employee-4',
+    targetDepartment: 'Проектирование', status: 'Реализовано', clusterId: 'catalog',
+    createdDaysAgo: 29, resolvedDaysAgo: 4,
+    changed: 'Для видеосервера создана связка с лицензиями и проверкой количества каналов. При подборе комплекта проектировщик видит предупреждение о непокрытых каналах до выпуска КП.',
+    comments: ['Проверка должна учитывать встроенные лицензии сервера, чтобы не купить их повторно.'],
+  },
+  {
+    id: 'S-019', title: 'Обязательные исходные данные для тендерной спецификации',
+    text: 'Тендерная документация приходит без точного количества дверей и типа прохода, а срок подготовки спецификации уже идёт. Нужна возможность отдельно отметить недостающие исходные данные.',
+    category: 'Информационная прозрачность', authorId: 'employee-2',
+    targetDepartment: 'Продажи', status: 'Закрыто', clusterId: 'purchase',
+    createdDaysAgo: 28, resolvedDaysAgo: 12,
+    changed: 'Для тендерного расчёта введён лист недостающих исходных данных. Дата начала технического подбора подтверждается после получения количества дверей, типов прохода и требований к интеграции.',
+    comments: ['Предлагаю не останавливать весь расчёт: готовые разделы можно продолжить.', 'Так и сделали: открытые вопросы перечислены отдельно, готовая часть передана вовремя.'],
+  },
+  {
+    id: 'S-020', title: 'Повторный ввод состава комплекта из CRM',
+    text: 'После согласования КП заново переношу оборудование и количество из CRM в учётную систему. При изменении комплекта приходится повторять перенос, а расхождения обнаруживает уже склад.',
+    category: 'Интеграции и IT', authorId: 'employee-4',
+    targetDepartment: 'IT-разработка', assigneeId: 'manager-7', priority: 'Высокий',
+    status: 'В работе', clusterId: 'systems', createdDaysAgo: 10,
+    comments: ['Разобрали формат выгрузки, но пока не согласовали обработку повторного изменения.', 'Прошу сначала исключить дубли строк при повторном переносе; это мешает отгрузке чаще всего.'],
+  },
+];

