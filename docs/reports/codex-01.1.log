diff --git a/frontend/src/data/seed-history.ts b/frontend/src/data/seed-history.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1caf9c77cfe4babf3978e2e9fc1ef9194421c349
--- /dev/null
+++ b/frontend/src/data/seed-history.ts
@@ -0,0 +1,71 @@
+import type { Comment, Event, Ticket, User } from '../types';
+import { addWorkingHours, workdaysAgo } from '../lib/business-time';
+import type { SeedEntry } from './seed-entry';
+
+export function seedHistory(
+  ticket: Ticket,
+  raw: SeedEntry,
+  author: User,
+  assignee: User,
+  anchor: Date,
+  returnAt?: string,
+): { events: Event[]; comments: Comment[] } {
+  const events: Event[] = [{
+    id: `${raw.id}-created`, date: ticket.createdAt,
+    actor: author.name, text: 'Обращение зарегистрировано', status: 'Новое',
+  }];
+  const firstResponseAt = ticket.firstResponseAt;
+  if (firstResponseAt) {
+    events.push({
+      id: `${raw.id}-response`, date: firstResponseAt, actor: assignee.name,
+      text: 'Обращение принято на рассмотрение', status: 'На рассмотрении',
+    });
+    if (!['Новое', 'На рассмотрении', 'Ожидает уточнения', 'Отклонено'].includes(raw.status)) {
+      events.push({
+        id: `${raw.id}-work`, date: addWorkingHours(new Date(firstResponseAt), 1),
+        actor: assignee.name, text: 'Начата работа по обращению', status: 'В работе',
+      });
+    }
+  }
+  if (ticket.implementedAt) {
+    events.push({
+      id: `${raw.id}-result`, date: ticket.implementedAt,
+      actor: assignee.name, text: ticket.changed, status: 'Реализовано',
+    });
+  }
+  if (ticket.closedAt) {
+    events.push({
+      id: `${raw.id}-closed`, date: ticket.closedAt,
+      actor: ticket.confirmed ? author.name : assignee.name,
+      text: ticket.rejection || (ticket.confirmed ? 'Автор подтвердил: проблема решена' : ticket.changed),
+      status: raw.status,
+    });
+  }
+  const commentTexts = raw.comments || [];
+  const comments: Comment[] = commentTexts.map((text, i) => ({
+    id: `${raw.id}-comment-${i}`,
+    date: i === 0 && firstResponseAt
+      ? addWorkingHours(new Date(firstResponseAt), 1)
+      : returnAt || ticket.closedAt || ticket.implementedAt || workdaysAgo(anchor, 0, 16),
+    author: i % 2 === 0 ? assignee.name : author.name,
+    text,
+  }));
+  for (const comment of comments) {
+    events.push({ ...comment, actor: comment.author, text: comment.text });
+  }
+  if (raw.status === 'Ожидает уточнения' && comments[0]) {
+    events.push({
+      id: `${raw.id}-clarification`, date: comments[0].date,
+      actor: assignee.name, text: comments[0].text, status: 'Ожидает уточнения',
+    });
+  }
+  if (returnAt) {
+    events.push({
+      id: `${raw.id}-return`, date: returnAt, actor: author.name,
+      text: commentTexts.at(-1) || 'Автор вернул обращение на доработку',
+      status: 'Возвращено автором',
+    });
+  }
+  events.sort((a, b) => a.date.localeCompare(b.date));
+  return { events, comments };
+}
diff --git a/frontend/src/data/seed-ticket.ts b/frontend/src/data/seed-ticket.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4675a6542a60789f7f6dc8d6966580c4df6556a9
--- /dev/null
+++ b/frontend/src/data/seed-ticket.ts
@@ -0,0 +1,83 @@
+import type { Rule, Ticket, User } from '../types';
+import { addWorkingHours, workdaysAgo } from '../lib/business-time';
+import { businessDays } from '../lib/format';
+import type { SeedEntry } from './seed-entry';
+import { seedHistory } from './seed-history';
+
+export function buildSeedTicket(
+  raw: SeedEntry,
+  index: number,
+  anchor: Date,
+  users: User[],
+  rules: Rule[],
+): Ticket {
+  const author = users.find((u) => u.id === raw.authorId)!;
+  const rule = rules.find((r) => r.category === raw.category)!;
+  const assignee = users.find((u) => u.id === (raw.assigneeId || rule.primaryId))!;
+  const createdAt = workdaysAgo(anchor, raw.createdDaysAgo);
+  const responseHours = raw.responseHours ?? [6, 10, 12, 16, 18][index % 5];
+  const firstResponseAt = raw.status === 'Новое'
+    ? undefined
+    : addWorkingHours(new Date(createdAt), responseHours);
+  const resolvedAt = raw.resolvedDaysAgo === undefined
+    ? undefined
+    : workdaysAgo(anchor, raw.resolvedDaysAgo, 15);
+  const returned = raw.status === 'Возвращено автором';
+  const realized = raw.status === 'Реализовано'
+    || returned
+    || (raw.status === 'Закрыто' && raw.type !== 'Положительный отзыв');
+  const closedAt = ['Закрыто', 'Отклонено'].includes(raw.status)
+    ? addWorkingHours(new Date(resolvedAt!), 1)
+    : undefined;
+  const returnAt = returned ? addWorkingHours(new Date(resolvedAt!), 1) : undefined;
+  const responseDueAt = businessDays(new Date(createdAt), rule.responseDays);
+  const dueAt = returnAt
+    ? businessDays(new Date(returnAt), 5)
+    : businessDays(new Date(createdAt), rule.resolutionDays);
+  const type = raw.type || 'Проблема';
+  const ticket: Ticket = {
+    id: raw.id,
+    title: raw.title,
+    text: raw.text,
+    type,
+    category: raw.category,
+    authorId: author.id,
+    authorDepartment: author.department,
+    targetDepartment: raw.targetDepartment,
+    assigneeId: assignee.id,
+    priority: raw.priority || 'Средний',
+    status: raw.status,
+    createdAt,
+    responseDueAt,
+    dueAt,
+    firstResponseAt,
+    implementedAt: realized ? resolvedAt : undefined,
+    closedAt,
+    events: [],
+    comments: [],
+    participants: [],
+    frequency: raw.frequency || (index % 3 === 0 ? 'ежедневно' : 'еженедельно'),
+    minutes: raw.minutes || [15, 30, 60, 120][index % 4],
+    solution: '',
+    effect: '',
+    changed: raw.changed || '',
+    rejection: raw.rejection || '',
+    confirmed: raw.status === 'Закрыто' && realized,
+    attachments: [],
+    clusterId: raw.clusterId,
+  };
+  if (raw.id.startsWith('A-') && type === 'Проблема') {
+    const employees = users.filter((u) => u.role === 'Сотрудник' && u.id !== author.id);
+    ticket.participants = employees.slice(index % 4, index % 4 + 1 + index % 4).map((u) => ({
+      userId: u.id,
+      department: u.department,
+      context: 'Встречаемся с аналогичной ситуацией при передаче данных между подразделениями.',
+      frequency: 'еженедельно',
+      minutes: 30,
+    }));
+  }
+  const history = seedHistory(ticket, raw, author, assignee, anchor, returnAt);
+  ticket.events = history.events;
+  ticket.comments = history.comments;
+  return ticket;
+}
