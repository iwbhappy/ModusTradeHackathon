-        priority: ['Средний', 'Высокий', 'Низкий'][i % 3] as Priority,
-        status: [
-          'Новое',
-          'В работе',
-          'Реализовано',
-          'На рассмотрении',
-          'Ожидает уточнения',
-          'Закрыто',
-          'В работе',
-        ][i % 7] as Status,
-        text:
-          topic[1] +
-          ` Ситуация повторяется ${i % 2 === 0 ? 'при подготовке недельного плана' : 'при передаче задачи смежному подразделению'}.`,
-        assigneeId: rule.primaryId,
-        title:
