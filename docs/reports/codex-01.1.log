            </option>
          ))}
        </select>
      </Field>
    </div>
  );
}
export function NewTicket() {
  const { catalog, userId, refresh, notify } = useApp();
  const navigate = useNavigate();
  const [draft, setDraft] = useState<TicketDraft>({
    type: 'Проблема',
    category: catalog!.categories[0],
    targetDepartment: 'Закупки',
    text: '',
    solution: '',
    effect: '',
    priority: 'Средний',
    frequency: 'еженедельно',
    minutes: 30,
    attachments: [],
  });
  const [similar, setSimilar] = useState<Ticket[]>([]);
  const [finding, setFinding] = useState(false);
  const [route, setRoute] = useState<RoutePreview | null>(null);
  const [routeError, setRouteError] = useState('');
  const [structure, setStructure] = useState<Structure | null>(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');
  const [joinId, setJoinId] = useState('');
  const [context, setContext] = useState('');
  const change = <K extends keyof TicketDraft>(key: K, value: TicketDraft[K]) =>
    setDraft((d) => ({ ...d, [key]: value }));
  useEffect(() => {
    let live = true;
    setFinding(draft.text.length >= 8);
    const timer = setTimeout(() => {
      findSimilar(draft.text, userId)
        .then((t) => {
          if (live) setSimilar(t);
        })
        .catch((e) => {
          if (live) setError(e.message);
        })
        .finally(() => {
          if (live) setFinding(false);
        });
    }, 450);
    return () => {
      live = false;
      clearTimeout(timer);
    };
  }, [draft.text, userId]);
  useEffect(() => {
    let live = true;
    setRoute(null);
    setRouteError('');
    previewRouting(draft.category, draft.targetDepartment)
      .then((r) => {
        if (live) setRoute(r);
      })
      .catch((e) => {
        if (live) setRouteError(e.message);
      });
    return () => {
      live = false;
    };
  }, [draft.category, draft.targetDepartment]);
  if (!catalog) return null;
  return (
    <>
      <Link to="/mine" className="back-link">
        <ArrowLeft size={15} />
        Мои обращения
      </Link>
      <PageTitle
        title="Новое обращение"
        subtitle="Опишите ситуацию. Система направит обращение ответственному."
      />
      <div className="compose-layout">
        <form
          className="panel compose-form"
          onSubmit={async (e) => {
            e.preventDefault();
            setBusy(true);
            setError('');
            try {
              const t = await createTicket(draft, userId);
              await refresh();
              notify(`${t.id}: обращение зарегистрировано`);
              navigate(`/tickets/${t.id}`);
            } catch (e) {
              setError((e as Error).message);
            } finally {
              setBusy(false);
            }
          }}
        >
          <div className="panel-heading">
            <h2>Содержание обращения</h2>
            <span className="quiet-label">Обязательные поля отмечены *</span>
          </div>
          <div className="panel-body">
            <fieldset className="type-field">
              <legend>Тип обращения *</legend>
              <div className="segmented">
                {(['Проблема', 'Предложение', 'Положительный отзыв'] as TicketType[]).map(
                  (type) => (
                    <button
                      type="button"
                      key={type}
                      className={type === draft.type ? 'selected' : ''}
                      onClick={() => change('type', type)}
                    >
                      {type}
                    </button>
                  ),
                )}
              </div>
            </fieldset>
            <div className="form-grid">
              <Field label="Категория *">
                <select value={draft.category} onChange={(e) => change('category', e.target.value)}>
                  {catalog.categories.map((c) => (
                    <option key={c}>{c}</option>
                  ))}
                </select>
              </Field>
              <Field label="К какому подразделению относится *">
                <select
                  value={draft.targetDepartment}
                  onChange={(e) => change('targetDepartment', e.target.value)}
                >
                  {catalog.departments.map((d) => (
                    <option key={d}>{d}</option>
                  ))}
                </select>
              </Field>
            </div>
            <Field
              label="Описание ситуации *"
              hint="Что происходит, на каком этапе и как это влияет на работу. Не указывайте конфиденциальные сведения."
            >
              <textarea
                required
                minLength={20}
                maxLength={6000}
                rows={7}
                placeholder="Например: в заявках на закупку оборудования не хватает назначения изделия и требуемых параметров…"
                value={draft.text}
                onChange={(e) => {
                  change('text', e.target.value);
                  setStructure(null);
                }}
              />
            </Field>
            <div className="structure-button">
              <button
                type="button"
                disabled={busy || draft.text.trim().length < 20}
                onClick={async () => {
                  setBusy(true);
                  setError('');
                  try {
                    setStructure(await suggestStructure(draft.text));
                  } catch (e) {
                    setError((e as Error).message);
                  } finally {
                    setBusy(false);
                  }
                }}
              >
                <Wand2 size={16} />
                Структурировать текст
              </button>
              <small>Автоподсказка · текст можно проверить</small>
            </div>
            {structure && (
              <div className="system-box">
                <div className="section-label">
                  <ScanSearch size={16} />
                  <strong>Предлагаемая структура</strong>
                  <span className="badge blue">Автоподсказка</span>
                </div>
                <dl className="structure">
                  <dt>Проблема</dt>
                  <dd>{structure.problem}</dd>
                  <dt>Предлагаемое решение</dt>
                  <dd>{structure.solution}</dd>
                  <dt>Ожидаемый эффект</dt>
                  <dd>{structure.effect}</dd>
                </dl>
                <p className="small">
                  Категория: {structure.category} · Приоритет: {structure.priority}
                </p>
                <div className="button-row">
                  <button
                    type="button"
                    onClick={() => {
                      setDraft((d) => ({
                        ...d,
                        text: structure.problem,
                        solution: structure.solution,
                        effect: structure.effect,
                        category: structure.category,
                        priority: structure.priority,
                      }));
                      setStructure(null);
                      notify('Структура принята. Поля доступны для редактирования.');
                    }}
                  >
                    <Check size={15} />
                    Принять
                  </button>
                  <button type="button" onClick={() => setStructure(null)}>
                    Отклонить
                  </button>
                </div>
              </div>
            )}
            <Field label="Предлагаемое решение">
              <textarea
                rows={3}
                placeholder="Как, по вашему мнению, можно улучшить ситуацию?"
                value={draft.solution}
                onChange={(e) => change('solution', e.target.value)}
              />
            </Field>
            {draft.effect && (
              <Field label="Ожидаемый эффект">
                <textarea
                  rows={2}
                  value={draft.effect}
                  onChange={(e) => change('effect', e.target.value)}
                />
              </Field>
            )}
            <div className="attachment-row">
              <label className="button">
                <Paperclip size={15} />
                Прикрепить файл
                <input
                  type="file"
                  className="sr-only"
                  multiple
                  onChange={(e) =>
                    change('attachments', [
                      ...new Set([
                        ...draft.attachments,
                        ...Array.from(e.target.files || []).map((f) => f.name),
                      ]),
                    ])
                  }
                />
              </label>
              <small>В прототипе сохраняются только имена файлов</small>
            </div>
            {draft.attachments.map((name) => (
              <span className="file-chip" key={name}>
                <Paperclip size={13} />
                {name}
                <button
                  type="button"
                  className="icon-button"
                  aria-label={`Удалить ${name}`}
                  onClick={() =>
                    change(
                      'attachments',
                      draft.attachments.filter((n) => n !== name),
                    )
                  }
                >
                  <X size={13} />
                </button>
              </span>
            ))}
            {draft.type === 'Проблема' && (
              <section className="cost-box">
                <div className="section-label">
                  <Clock3 size={17} />
                  <h2>Стоимость проблемы</h2>
                </div>
                <p>Два ответа помогут расставить приоритеты по потерям времени.</p>
                <CostFields
                  frequency={draft.frequency}
                  minutes={draft.minutes}
                  onChange={(f, m) => setDraft((d) => ({ ...d, frequency: f, minutes: m }))}
                />
                <div className="cost-result">
                  Ваша оценка:{' '}
                  <strong className="mono">
                    ≈ {number(monthly(draft.frequency, draft.minutes))}
                  </strong>{' '}
                  чел.-ч/мес
                  {draft.frequency === 'разово' && (
                    <small>
                      Разовая потеря: {draft.minutes} мин. Не включается в ежемесячные потери.
                    </small>
                  )}
                </div>
              </section>
            )}
            <ErrorMessage text={routeError} />
            {route ? (
              <div className="route-preview">
                <Send size={18} />
                <div>
                  <strong>Обращение получит: {route.assignee.name}</strong>
                  {route.fallback && (
                    <p className="overdue">
                      {route.primary.name} в отпуске. Выбран резервный ответственный.
                    </p>
                  )}
                  <p>
                    Первый ответ до <b>{date(route.responseDueAt)}</b> · решение до{' '}
                    {date(route.dueAt)}
                  </p>
                  <small>
                    {route.responseDays} и {route.resolutionDays} рабочих дней по правилу категории
                  </small>
                </div>
              </div>
            ) : (
              !routeError && <Loading />
            )}
            <ErrorMessage text={error} />
            <div className="form-footer">
              <Link to="/mine" className="button">
                Отмена
              </Link>
              <button
                className="primary"
                disabled={busy || !route || draft.text.trim().length < 20}
              >
                <Send size={16} />
                {busy ? 'Сохранение…' : 'Отправить обращение'}
              </button>
            </div>
          </div>
        </form>
        <aside className="similar-panel">
          <Panel title="Похожие обращения" aside={<ScanSearch size={17} />}>
            <div className="panel-body">
              <p className="muted small">
                Возможно, эту проблему уже решают. Присоединитесь и добавьте свой контекст.
              </p>
              {finding ? (
                <Loading />
              ) : !similar.length ? (
                <Empty
                  text={
                    draft.text.length < 8
                      ? 'Начните описывать ситуацию'
                      : 'Похожих открытых обращений нет'
                  }
                />
              ) : (
                similar.map((t) => {
                  const joined =
                    t.authorId === userId || t.participants.some((p) => p.userId === userId);
                  return (
                    <article className="similar-card" key={t.id}>
                      <div className="between">
                        <span className="mono ticket-id">{t.id}</span>
                        <Badge status={t.status} />
                      </div>
                      <h3>{t.title}</h3>
                      <p className="small muted">
                        {t.participants.length + 1} участников ·{' '}
                        {
                          new Set([t.authorDepartment, ...t.participants.map((p) => p.department)])
                            .size
                        }{' '}
                        подразделения
                      </p>
                      {t.type === 'Проблема' && (
                        <div className="small">
                          ≈ <span className="mono">{number(cost(t))}</span> чел.-ч/мес
                        </div>
                      )}
                      {joined ? (
                        <Link className="text-button" to={`/tickets/${t.id}`}>
                          Уже в ваших обращениях <ArrowRight size={14} />
                        </Link>
                      ) : (
                        <button
                          type="button"
                          className="text-button"
                          onClick={() => {
                            setJoinId(joinId === t.id ? '' : t.id);
                            setContext('');
                          }}
                        >
                          У меня то же самое → присоединиться
                        </button>
                      )}
                      {joinId === t.id && (
                        <div className="join-form">
                          <Field label="Ваш контекст *">
                            <textarea
                              rows={3}
                              value={context}
                              onChange={(e) => setContext(e.target.value)}
                              placeholder="Где и как возникает у вас?"
                            />
                          </Field>
                          {t.type === 'Проблема' && (
                            <>
                              <CostFields
                                frequency={draft.frequency}
                                minutes={draft.minutes}
                                onChange={(f, m) =>
                                  setDraft((d) => ({ ...d, frequency: f, minutes: m }))
                                }
                              />
                              <p className="small">
                                К потерям добавится ваша оценка:{' '}
                                {number(monthly(draft.frequency, draft.minutes))} чел.-ч/мес.
                              </p>
                            </>
                          )}
                          <button
                            type="button"
                            className="primary"
                            disabled={busy || context.trim().length < 10}
                            onClick={async () => {
                              setBusy(true);
                              setError('');
                              try {
                                await joinTicket(
                                  t.id,
                                  context,
                                  draft.frequency,
                                  draft.minutes,
                                  userId,
                                );
                                await refresh();
                                notify(`Вы присоединились к ${t.id}`);
                                navigate(`/tickets/${t.id}`);
                              } catch (e) {
                                setError((e as Error).message);
                              } finally {
                                setBusy(false);
                              }
                            }}
                          >
                            Присоединиться
                          </button>
                        </div>
                      )}
                    </article>
                  );
                })
              )}
            </div>
          </Panel>
          <div className="privacy-note">
            <strong>Что произойдёт дальше</strong>
            <p>
              Ответственный увидит обращение в очереди. Все ответы, изменения статуса и результат
              появятся в карточке обращения.
            </p>
          </div>
        </aside>
      </div>
    </>
  );
}
import { useEffect, useState } from 'react';
import { Link, useNavigate, useParams } from 'react-router-dom';
import {
  ArrowLeft,
  Check,
  CheckCheck,
  Clock3,
  CornerUpLeft,
  MessageSquare,
  Paperclip,
  ScanSearch,
  Send,
  UserRound,
  Wand2,
} from 'lucide-react';
import {
  addComment,
  confirmResolution,
  draftResponse,
  getTicket,
  listTickets,
  reassign,
  updateStatus,
} from '../api';
import { useApp } from '../store';
import type { Status, Ticket } from '../types';
import { businessDays, cost, date, deadline, number, overdue, terminal } from '../lib/format';
import { Badge, ErrorMessage, Field, Loading, PageTitle, Panel } from '../components/ui';

export function TicketDetail() {
  const { id = '' } = useParams();
  const navigate = useNavigate();
  const { catalog, userId, revision, refresh, notify } = useApp();
  const [t, setTicket] = useState<Ticket | null>(null);
  const [related, setRelated] = useState<Ticket[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [comment, setComment] = useState('');
  const [status, setStatus] = useState<Status>('В работе');
  const [actionText, setActionText] = useState('');
  const [busy, setBusy] = useState(false);
  const [assignee, setAssignee] = useState('');
  const [reason, setReason] = useState('');
  const [returning, setReturning] = useState(false);
  const [returnReason, setReturnReason] = useState('');
  const [draft, setDraft] = useState('');
  useEffect(() => {
    let live = true;
    setLoading(true);
    setError('');
    getTicket(id, userId)
      .then(async (ticket) => {
        if (!live) return;
        setTicket(ticket);
        setAssignee(ticket.assigneeId);
        const list = ticket.clusterId
          ? await listTickets(userId, { cluster: ticket.clusterId })
          : [];
        if (live) setRelated(list);
      })
      .catch((e) => {
        if (live) {
          setTicket(null);
          setError(e.message);
        }
      })
      .finally(() => {
        if (live) setLoading(false);
      });
    return () => {
      live = false;
    };
  }, [id, userId, revision]);
  if (!catalog) return null;
  const current = catalog.users.find((u) => u.id === userId)!;
  const home =
    current.role === 'Сотрудник'
      ? '/mine'
      : current.role === 'Руководитель'
        ? '/inbox'
        : '/routing';
  if (loading) return <Loading />;
  if (!t)
    return (
      <>
        <Link className="back-link" to={home}>
          <ArrowLeft size={15} />
          Вернуться
        </Link>
        <ErrorMessage text={error} />
      </>
    );
  const manager = current.role === 'Руководитель';
  const author = t.authorId === userId;
  const owner = catalog.users.find((u) => u.id === t.assigneeId)!;
  const run = async (operation: () => Promise<unknown>, message: string) => {
    setBusy(true);
    setError('');
    try {
      await operation();
      await refresh();
      notify(message);
    } catch (e) {
      setError((e as Error).message);
    } finally {
      setBusy(false);
    }
  };
  const stageDefs = [
    { title: 'Зарегистрировано', statuses: ['Новое'], plan: t.createdAt },
    {
      title: 'Рассмотрение',
      statuses: ['На рассмотрении', 'Ожидает уточнения'],
      plan: t.responseDueAt,
    },
    {
      title: 'В работе',
      statuses: ['В работе', 'Возвращено автором'],
      plan: businessDays(new Date(t.responseDueAt), 1),
    },
    { title: 'Результат', statuses: ['Реализовано', 'Отклонено'], plan: t.dueAt },
    {
      title: t.status === 'Отклонено' ? 'Завершено' : 'Подтверждение',
      statuses: ['Закрыто'],
      plan: businessDays(new Date(t.dueAt), 3),
    },
  ];
  return (
    <>
      <Link to={home} className="back-link">
        <ArrowLeft size={15} />
        {manager ? 'Входящие' : 'Мои обращения'}
      </Link>
      <PageTitle
        title={t.title}
        subtitle={`${t.id} · ${t.type} · ${t.category}`}
        action={<Badge status={t.status} />}
      />
      <Panel className="tracking-panel">
        <div className="tracking-summary">
          <div>
            <Clock3 size={17} />
            <strong className={overdue(t) ? 'overdue' : ''}>{deadline(t)}</strong>
          </div>
          <span>
            Ответственный: <b>{owner.name}</b>
          </span>
          <span>
            Обещанный срок решения: <b>{date(t.dueAt)}</b>
          </span>
        </div>
        <ol className="tracking">
          {stageDefs.map((stage, i) => {
            const event = t.events.find((e) => e.status && stage.statuses.includes(e.status));
            const fact =
              event?.date ||
              (i === 3 ? t.implementedAt || t.closedAt : i === 4 ? t.closedAt : undefined);
            const skipped = terminal(t) && !fact && !(i === 4 && t.status === 'Реализовано');
            return (
              <li className={fact ? 'complete' : ''} key={stage.title}>
                <span className="track-circle">
                  {fact ? <Check size={13} /> : skipped ? '—' : i + 1}
                </span>
                <div>
                  <strong>{stage.title}</strong>
                  <small>
                    {fact ? date(fact) : skipped ? 'Не потребовалось' : `План: ${date(stage.plan)}`}
                  </small>
                </div>
              </li>
            );
          })}
        </ol>
      </Panel>
      <ErrorMessage text={error} />
      <div className="detail-layout">
        <div className="detail-main">
          {t.rejection && t.status === 'Отклонено' && (
            <Panel title="Причина отказа">
              <div className="panel-body">

