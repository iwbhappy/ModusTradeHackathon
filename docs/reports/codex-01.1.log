+        <span className="legend-square" style={{ background: palette[7] }}/>
+        <span>Прочие ({remaining.length}) {expanded ? <ChevronUp size={12}/> : <ChevronDown size={12}/>}</span>
+        {values(otherCount)}
+      </button>
+      {expanded && <div className="other-category-list" id="other-category-list">
+        {remaining.map((item) => <div className="distribution-row" key={item.label}>
+          <span>{item.label}</span>{values(item.value)}
+        </div>)}
+      </div>}
+    </>}
+  </div></Panel>;
+}
